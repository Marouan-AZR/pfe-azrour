{% extends 'base.html.twig' %}

{% block title %}Performances Contrôleurs{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <h1 class="mb-4"><i class="bi bi-bar-chart me-2"></i>Performances des Contrôleurs</h1>

    <form method="get" class="row g-3 mb-4">
        <div class="col-auto">
            <select name="month" class="form-select">
                {% for m in 1..12 %}
                    <option value="{{ m }}" {{ m == month ? 'selected' : '' }}>{{ m|date('F') }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <select name="year" class="form-select">
                {% for y in (year - 2)..(year + 1) %}
                    <option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary"><i class="bi bi-search me-1"></i>Filtrer</button>
        </div>
    </form>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-table me-2"></i>Tableau des opérations</div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Contrôleur</th>
                                <th class="text-center">Entrées</th>
                                <th class="text-center">Sorties</th>
                                <th class="text-center">Total</th>
                                <th class="text-end">Tonnage</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for s in stats %}
                            <tr>
                                <td>{{ s.user.fullName|default(s.user.email) }}</td>
                                <td class="text-center"><span class="badge bg-success">{{ s.entries }}</span></td>
                                <td class="text-center"><span class="badge bg-warning">{{ s.exits }}</span></td>
                                <td class="text-center"><strong>{{ s.total }}</strong></td>
                                <td class="text-end">{{ s.tonnage }} T</td>
                            </tr>
                            {% else %}
                            <tr><td colspan="5" class="text-center text-muted py-3">Aucune donnée</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><i class="bi bi-bar-chart-fill me-2"></i>Graphique</div>
                <div class="card-body">
                    <canvas id="chartControleurs" height="200"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><i class="bi bi-trophy me-2"></i>Top 5</div>
                <div class="card-body p-0">
                    <ol class="list-group list-group-numbered list-group-flush">
                        {% for s in top5 %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            {{ s.user.fullName|default(s.user.email) }}
                            <span class="badge bg-primary rounded-pill">{{ s.total }} ops / {{ s.tonnage }} T</span>
                        </li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
new Chart(document.getElementById('chartControleurs'), {
    type: 'bar',
    data: {
        labels: [{% for s in stats %}'{{ s.user.fullName|default(s.user.email)|e('js') }}'{{ not loop.last ? ',' : '' }}{% endfor %}],
        datasets: [
            { label: 'Entrées', data: [{% for s in stats %}{{ s.entries }}{{ not loop.last ? ',' : '' }}{% endfor %}], backgroundColor: '#10b981' },
            { label: 'Sorties', data: [{% for s in stats %}{{ s.exits }}{{ not loop.last ? ',' : '' }}{% endfor %}], backgroundColor: '#f59e0b' }
        ]
    },
    options: { responsive: true, scales: { x: { stacked: false }, y: { beginAtZero: true } } }
});
</script>
{% endblock %}
