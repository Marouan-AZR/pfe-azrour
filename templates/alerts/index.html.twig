{% extends 'base.html.twig' %}

{% block title %}Alertes du Système{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-bell me-2"></i>Alertes du Système</h2>

    {% if alerts|length == 0 %}
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle text-success" style="font-size:3rem"></i>
            <p class="mt-3 text-muted">Aucune alerte active. Tout fonctionne normalement !</p>
        </div>
    </div>
    {% else %}
    <div class="row g-3">
        {% for alert in alerts %}
        <div class="col-md-6">
            <div class="alert alert-{{ alert.type }} d-flex align-items-center mb-0">
                <i class="bi bi-{{ alert.icon }} me-3 fs-4"></i>
                <div>
                    <span class="badge bg-{{ alert.type }} me-2">{{ alert.category|upper }}</span>
                    {{ alert.message }}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
