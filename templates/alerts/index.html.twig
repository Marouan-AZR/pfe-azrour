{% extends 'base.html.twig' %}

{% block title %}Centre d'Alertes{% endblock %}

{% block stylesheets %}
<style>
    /* ── Base ── */
    .glass { background:#fff; border:1px solid #e2e8f0; border-radius:1rem; box-shadow:0 4px 24px rgba(0,0,0,.06); }
    .kpi-icon { width:46px; height:46px; border-radius:.75rem; display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0; }

    /* ── Severity summary pills ── */
    .sev-pill { display:inline-flex; align-items:center; gap:.45rem; padding:.35em .8em; border-radius:50px; font-size:.78rem; font-weight:700; }
    .sev-pill.danger  { background:rgba(239,68,68,.12);  color:#b91c1c; border:1px solid rgba(239,68,68,.25); }
    .sev-pill.warning { background:rgba(245,158,11,.12); color:#92400e; border:1px solid rgba(245,158,11,.25); }
    .sev-pill.info    { background:rgba(59,130,246,.12); color:#1d4ed8; border:1px solid rgba(59,130,246,.25); }
    .sev-pill.success { background:rgba(16,185,129,.12); color:#065f46; border:1px solid rgba(16,185,129,.25); }

    /* ── Filter tabs ── */
    .filter-tabs { display:flex; gap:.5rem; flex-wrap:wrap; }
    .filter-tab {
        display:inline-flex; align-items:center; gap:.4rem;
        padding:.42em .9em; border-radius:50px; font-size:.82rem; font-weight:600;
        border:1.5px solid #e2e8f0; background:#fff; color:#64748b;
        cursor:pointer; transition:all .15s; white-space:nowrap;
    }
    .filter-tab:hover { border-color:#6366f1; color:#6366f1; background:rgba(99,102,241,.05); }
    .filter-tab.active { background:#6366f1; border-color:#6366f1; color:#fff; }
    .filter-tab .count-badge {
        background:rgba(255,255,255,.25); color:inherit;
        font-size:.7rem; font-weight:700; padding:.1em .45em; border-radius:50px;
        min-width:1.4em; text-align:center;
    }
    .filter-tab:not(.active) .count-badge { background:rgba(99,102,241,.12); color:#6366f1; }

    /* ── Alert card ── */
    .alert-card {
        border-radius: .875rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        overflow: hidden;
        transition: transform .15s, box-shadow .15s;
        display: flex;
    }
    .alert-card:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,.09); }

    .alert-card-accent { width: 5px; flex-shrink: 0; border-radius: 0; }
    .alert-card-accent.danger  { background: #ef4444; }
    .alert-card-accent.warning { background: #f59e0b; }
    .alert-card-accent.info    { background: #3b82f6; }
    .alert-card-accent.success { background: #10b981; }

    .alert-card-body { padding: 1rem 1.1rem; flex: 1; }

    .alert-icon-wrap {
        width: 38px; height: 38px; border-radius: .6rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }
    .alert-icon-wrap.danger  { background:rgba(239,68,68,.12);  color:#ef4444; }
    .alert-icon-wrap.warning { background:rgba(245,158,11,.12); color:#f59e0b; }
    .alert-icon-wrap.info    { background:rgba(59,130,246,.12); color:#3b82f6; }
    .alert-icon-wrap.success { background:rgba(16,185,129,.12); color:#10b981; }

    .alert-title { font-size: .875rem; font-weight: 700; color: #0f172a; line-height: 1.3; }
    .alert-msg   { font-size: .82rem;  color: #475569; margin-top: .25rem; line-height: 1.5; }

    .cat-badge {
        font-size: .68rem; font-weight: 700; padding: .2em .55em;
        border-radius: .4rem; text-transform: uppercase; letter-spacing: .04em;
    }
    .cat-badge.chambre     { background:rgba(14,165,233,.12);  color:#0369a1; }
    .cat-badge.stock       { background:rgba(99,102,241,.12);  color:#4f46e5; }
    .cat-badge.operation   { background:rgba(245,158,11,.12);  color:#b45309; }
    .cat-badge.performance { background:rgba(16,185,129,.12);  color:#065f46; }

    /* ── Empty state ── */
    .empty-state { padding: 4rem 2rem; text-align: center; }
    .empty-pulse {
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(16,185,129,.12); display: inline-flex;
        align-items: center; justify-content: center; font-size: 2.2rem;
        color: #10b981; margin-bottom: 1.5rem;
        animation: pulse-ring 2s infinite;
    }
    @keyframes pulse-ring {
        0%   { box-shadow: 0 0 0 0 rgba(16,185,129,.35); }
        70%  { box-shadow: 0 0 0 18px rgba(16,185,129,0); }
        100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
    }

    /* ── KPI cards ── */
    .kpi-cat-card { border-radius: 1rem; padding: 1rem 1.1rem; cursor: pointer; transition: transform .15s, box-shadow .15s; }
    .kpi-cat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">

    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <h2 class="mb-1 fw-bold">
                <i class="bi bi-bell-fill me-2 text-primary"></i>Centre d'Alertes
                {% if stats.total > 0 %}
                    <span class="badge rounded-pill ms-1"
                          style="background:{% if stats.danger > 0 %}#ef4444{% elseif stats.warning > 0 %}#f59e0b{% else %}#3b82f6{% endif %};font-size:.6rem;vertical-align:middle">
                        {{ stats.total - stats.success }}
                    </span>
                {% endif %}
            </h2>
            <p class="text-secondary mb-0 small">
                <i class="bi bi-arrow-repeat me-1"></i>Surveillance en temps réel ·
                <i class="bi bi-calendar3 ms-1 me-1"></i>Actualisé le {{ lastRefreshed|date('d/m/Y à H:i') }}
            </p>
        </div>
        <a href="{{ path('app_alerts') }}" class="btn btn-outline-primary btn-sm align-self-start d-flex align-items-center gap-2">
            <i class="bi bi-arrow-clockwise"></i>Actualiser
        </a>
    </div>

    {# ── Severity summary ── #}
    <div class="d-flex flex-wrap gap-2 mb-4">
        {% if stats.danger > 0 %}
        <span class="sev-pill danger">
            <i class="bi bi-circle-fill" style="font-size:.55rem"></i>
            {{ stats.danger }} critique{{ stats.danger > 1 ? 's' }}
        </span>
        {% endif %}
        {% if stats.warning > 0 %}
        <span class="sev-pill warning">
            <i class="bi bi-circle-fill" style="font-size:.55rem"></i>
            {{ stats.warning }} avertissement{{ stats.warning > 1 ? 's' }}
        </span>
        {% endif %}
        {% if stats.info > 0 %}
        <span class="sev-pill info">
            <i class="bi bi-circle-fill" style="font-size:.55rem"></i>
            {{ stats.info }} information{{ stats.info > 1 ? 's' }}
        </span>
        {% endif %}
        {% if stats.success > 0 %}
        <span class="sev-pill success">
            <i class="bi bi-circle-fill" style="font-size:.55rem"></i>
            {{ stats.success }} validé{{ stats.success > 1 ? 's' }}
        </span>
        {% endif %}
        {% if stats.total == 0 %}
        <span class="sev-pill success"><i class="bi bi-shield-check me-1"></i>Aucune alerte active</span>
        {% endif %}
    </div>

    {# ── KPI category cards ── #}
    <div class="row g-3 mb-4">

        {% set categories = [
            {key:'chambre',     label:'Chambres froides', icon:'thermometer-snow', color:'#0ea5e9', bg:'rgba(14,165,233,.1)'},
            {key:'stock',       label:'Stock',            icon:'boxes',            color:'#6366f1', bg:'rgba(99,102,241,.1)'},
            {key:'operation',   label:'Opérations',       icon:'box-arrow-in-right', color:'#f59e0b', bg:'rgba(245,158,11,.1)'},
            {key:'performance', label:'Performance',      icon:'speedometer2',     color:'#10b981', bg:'rgba(16,185,129,.1)'},
        ] %}

        {% for cat in categories %}
        <div class="col-sm-6 col-xl-3">
            <div class="glass kpi-cat-card h-100" onclick="filterAlerts(this, '{{ cat.key }}')"
                 data-tab="{{ cat.key }}" style="border-left:4px solid {{ cat.color }}">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background:{{ cat.bg }};color:{{ cat.color }}">
                        <i class="bi bi-{{ cat.icon }}"></i>
                    </div>
                    <div>
                        <small class="text-secondary d-block fw-medium">{{ cat.label }}</small>
                        <div class="d-flex align-items-baseline gap-2">
                            <h5 class="mb-0 fw-bold">{{ attribute(stats, cat.key) }}</h5>
                            <small class="text-secondary">alerte{{ attribute(stats, cat.key) > 1 ? 's' }}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}

    </div>

    {# ── Filter tabs ── #}
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="filter-tabs" id="filterTabs">
            <button class="filter-tab active" data-tab="all" onclick="filterAlerts(this,'all')">
                <i class="bi bi-grid-3x3-gap"></i>Toutes
                <span class="count-badge">{{ stats.total }}</span>
            </button>
            <button class="filter-tab" data-tab="chambre" onclick="filterAlerts(this,'chambre')">
                <i class="bi bi-thermometer-snow"></i>Chambres
                <span class="count-badge">{{ stats.chambre }}</span>
            </button>
            <button class="filter-tab" data-tab="stock" onclick="filterAlerts(this,'stock')">
                <i class="bi bi-boxes"></i>Stock
                <span class="count-badge">{{ stats.stock }}</span>
            </button>
            <button class="filter-tab" data-tab="operation" onclick="filterAlerts(this,'operation')">
                <i class="bi bi-box-arrow-in-right"></i>Opérations
                <span class="count-badge">{{ stats.operation }}</span>
            </button>
            <button class="filter-tab" data-tab="performance" onclick="filterAlerts(this,'performance')">
                <i class="bi bi-speedometer2"></i>Performance
                <span class="count-badge">{{ stats.performance }}</span>
            </button>
        </div>
        <small class="text-secondary">
            <i class="bi bi-info-circle me-1"></i>Cliquer sur une carte ou un onglet pour filtrer
        </small>
    </div>

    {# ── Alert cards ── #}
    {% if alerts|length == 0 %}

        <div class="glass empty-state">
            <div class="empty-pulse"><i class="bi bi-shield-check"></i></div>
            <h5 class="fw-bold text-success mb-1">Tout est en ordre !</h5>
            <p class="text-secondary mb-0">Aucune alerte active — le système fonctionne normalement.</p>
        </div>

    {% else %}

        <div class="row g-3" id="alertsGrid">
            {% for alert in alerts %}
            <div class="col-md-6 alert-card-wrap" data-category="{{ alert.category }}">
                <div class="alert-card h-100">
                    <div class="alert-card-accent {{ alert.type }}"></div>
                    <div class="alert-card-body">
                        <div class="d-flex align-items-start gap-3">
                            <div class="alert-icon-wrap {{ alert.type }}">
                                <i class="bi bi-{{ alert.icon }}"></i>
                            </div>
                            <div class="flex-fill">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="cat-badge {{ alert.category }}">
                                            {% if alert.category == 'chambre' %}
                                                <i class="bi bi-thermometer-snow me-1"></i>Chambre
                                            {% elseif alert.category == 'stock' %}
                                                <i class="bi bi-boxes me-1"></i>Stock
                                            {% elseif alert.category == 'operation' %}
                                                <i class="bi bi-box-arrow-in-right me-1"></i>Opération
                                            {% else %}
                                                <i class="bi bi-speedometer2 me-1"></i>Performance
                                            {% endif %}
                                        </span>
                                        {% if alert.type == 'danger' %}
                                            <span class="sev-pill danger" style="font-size:.66rem;padding:.15em .5em">
                                                <i class="bi bi-circle-fill" style="font-size:.45rem"></i>Critique
                                            </span>
                                        {% elseif alert.type == 'warning' %}
                                            <span class="sev-pill warning" style="font-size:.66rem;padding:.15em .5em">
                                                <i class="bi bi-circle-fill" style="font-size:.45rem"></i>Avertissement
                                            </span>
                                        {% elseif alert.type == 'success' %}
                                            <span class="sev-pill success" style="font-size:.66rem;padding:.15em .5em">
                                                <i class="bi bi-circle-fill" style="font-size:.45rem"></i>Info positive
                                            </span>
                                        {% else %}
                                            <span class="sev-pill info" style="font-size:.66rem;padding:.15em .5em">
                                                <i class="bi bi-circle-fill" style="font-size:.45rem"></i>Information
                                            </span>
                                        {% endif %}
                                    </div>
                                    <small class="text-secondary text-nowrap" style="font-size:.72rem">
                                        <i class="bi bi-clock me-1"></i>{{ 'now'|date('H:i') }}
                                    </small>
                                </div>
                                <div class="alert-title">{{ alert.title }}</div>
                                <div class="alert-msg">{{ alert.message }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        {# No results message (shown when filter has no matches) #}
        <div id="noFilterResults" class="glass empty-state" style="display:none">
            <div style="font-size:2.5rem;color:#94a3b8;margin-bottom:1rem"><i class="bi bi-funnel"></i></div>
            <h6 class="fw-semibold text-secondary">Aucune alerte dans cette catégorie</h6>
            <p class="text-secondary small mb-0">Cliquer sur « Toutes » pour tout afficher.</p>
        </div>

    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function filterAlerts(btn, cat) {
    // Update all tabs (both nav tabs and KPI cards)
    document.querySelectorAll('.filter-tab, .kpi-cat-card').forEach(el => {
        el.classList.remove('active');
        if (el.dataset.tab === cat) el.classList.add('active');
    });
    if (btn) btn.classList.add('active');

    const cards = document.querySelectorAll('.alert-card-wrap');
    let visible = 0;
    cards.forEach(card => {
        const show = cat === 'all' || card.dataset.category === cat;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    const noResults = document.getElementById('noFilterResults');
    if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
}
</script>
{% endblock %}
