{% extends 'base.html.twig' %}
{% block title %}Rapports & Statistiques{% endblock %}
{% block body %}
<div class="py-4 px-4">

  {# ── Header ── #}
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h4 class="mb-1 fw-bold" style="color:var(--text)">
        <i class="bi bi-graph-up-arrow me-2" style="color:#6366f1"></i>Rapports &amp; Statistiques
      </h4>
      <small style="color:var(--text-muted)">Analyse de la période sélectionnée</small>
    </div>
    <button class="btn btn-sm" onclick="window.print()"
      style="background:rgba(99,102,241,.12);color:#818cf8;border:1px solid rgba(99,102,241,.25);font-size:.82rem">
      <i class="bi bi-printer me-1"></i>Imprimer
    </button>
  </div>

  {# ── Sélecteur de période ── #}
  <form method="get" action="{{ path('app_reports') }}" class="rpt-filter-bar mb-4">
    <div class="rpt-filter-inner">
      <span class="rpt-filter-label"><i class="bi bi-calendar3 me-1"></i>Période</span>

      <div class="rpt-filter-group">
        <label class="rpt-filter-lbl">Du</label>
        <input type="date" name="date_from" value="{{ dateFrom }}" class="rpt-date-input" max="{{ dateFrom }}">
      </div>

      <div class="rpt-filter-group">
        <label class="rpt-filter-lbl">Au</label>
        <input type="date" name="date_to" value="{{ dateTo }}" class="rpt-date-input">
      </div>

      <button type="submit" class="rpt-apply-btn">
        <i class="bi bi-funnel me-1"></i>Appliquer
      </button>

      {# Raccourcis rapides #}
      <div class="rpt-shortcuts">
        <a href="{{ path('app_reports', {date_from: 'now'|date('Y-m-01'), date_to: 'now'|date('Y-m-d')}) }}"
           class="rpt-shortcut {{ dateFrom == 'now'|date('Y-m-01') and dateTo == 'now'|date('Y-m-d') ? 'active' : '' }}">
          Ce mois
        </a>
        <a href="{{ path('app_reports', {
              date_from: 'now'|date_modify('-1 month')|date('Y-m-01'),
              date_to:   'now'|date_modify('-1 month')|date('Y-m-t')
            }) }}"
           class="rpt-shortcut">
          Mois passé
        </a>
        <a href="{{ path('app_reports', {date_from: 'now'|date('Y-01-01'), date_to: 'now'|date('Y-m-d')}) }}"
           class="rpt-shortcut {{ dateFrom == 'now'|date('Y-01-01') ? 'active' : '' }}">
          Cette année
        </a>
        <a href="{{ path('app_reports', {date_from: '2000-01-01', date_to: 'now'|date('Y-m-d')}) }}"
           class="rpt-shortcut">
          Tout
        </a>
      </div>
    </div>
  </form>

  {# ── KPI Cards ── #}
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="rpt-kpi" style="--g1:#4f46e5;--g2:#6366f1">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="rpt-kpi-val">{{ totalStock|number_format(2, ',', ' ') }}</div>
            <div class="rpt-kpi-lbl">Tonnes en stock</div>
          </div>
          <span class="rpt-kpi-ico"><i class="bi bi-boxes"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="rpt-kpi" style="--g1:#0284c7;--g2:#38bdf8">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="rpt-kpi-val">{{ activeClients }}</div>
            <div class="rpt-kpi-lbl">Clients actifs</div>
          </div>
          <span class="rpt-kpi-ico"><i class="bi bi-people-fill"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="rpt-kpi" style="
        {% if occupancyRate > 80 %}--g1:#dc2626;--g2:#ef4444
        {% elseif occupancyRate > 50 %}--g1:#d97706;--g2:#f59e0b
        {% else %}--g1:#059669;--g2:#10b981{% endif %}">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="rpt-kpi-val">{{ occupancyRate|number_format(1) }}%</div>
            <div class="rpt-kpi-lbl">Taux d'occupation</div>
          </div>
          <span class="rpt-kpi-ico"><i class="bi bi-thermometer-half"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="rpt-kpi" style="--g1:#d97706;--g2:#f59e0b">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="rpt-kpi-val">{{ periodRevenue|number_format(0, ',', ' ') }}</div>
            <div class="rpt-kpi-lbl">CA période (MAD)</div>
          </div>
          <span class="rpt-kpi-ico"><i class="bi bi-cash-stack"></i></span>
        </div>
      </div>
    </div>
  </div>

  {# ── Deux cartes côte à côte ── #}
  <div class="row g-3 mb-4">

    {# Stock par client #}
    <div class="col-lg-6">
      <div class="rpt-card h-100">
        <div class="rpt-card-hd">
          <span class="rpt-card-title"><i class="bi bi-bar-chart-line me-2"></i>Stock par client</span>
          <span class="rpt-badge">{{ stockByClient|length }} client{{ stockByClient|length != 1 ? 's' : '' }}</span>
        </div>
        {% if stockByClient is not empty %}
        <div class="p-3 pt-2">
          {% set palette = ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444'] %}
          {% for c in stockByClient %}
          {% set color = palette[loop.index0] ?? '#6366f1' %}
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span style="font-size:.87rem;font-weight:500;color:var(--text)">{{ c.name }}</span>
              <span style="font-size:.8rem;color:var(--text-muted)">
                {{ c.quantity|number_format(2, ',', ' ') }}&thinsp;T
                &nbsp;<span style="color:{{ color }};font-weight:700">{{ c.percentage|number_format(1) }}%</span>
              </span>
            </div>
            <div class="rpt-bar-track">
              <div class="rpt-bar-fill" style="width:{{ c.percentage }}%;background:{{ color }}"></div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="rpt-empty"><i class="bi bi-inbox fs-2 d-block mb-2"></i>Aucune donnée stock</div>
        {% endif %}
      </div>
    </div>

    {# Occupation chambres froides — doughnut #}
    <div class="col-lg-6">
      <div class="rpt-card h-100">
        <div class="rpt-card-hd">
          <span class="rpt-card-title"><i class="bi bi-snow2 me-2"></i>Occupation chambres froides</span>
          <span class="rpt-badge">{{ coldRoomsCount }} chambre{{ coldRoomsCount != 1 ? 's' : '' }}</span>
        </div>
        {% if roomOccupancy is not empty %}
        {% set roomColors = ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6'] %}
        <div class="d-flex flex-column align-items-center p-3" style="gap:1.2rem">
          {# Doughnut centré #}
          <div style="position:relative;width:200px;height:200px">
            <canvas id="roomDonut" width="200" height="200"></canvas>
            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none">
              <span style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1">{{ occupancyRate|number_format(1) }}%</span>
              <span style="font-size:.7rem;color:var(--text-muted);margin-top:.25rem">occupation moy.</span>
            </div>
          </div>
          {# Légende en grille compacte #}
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.45rem .8rem;width:100%">
            {% for room in roomOccupancy %}
            {% set rc = roomColors[loop.index0 % 8] %}
            <div class="d-flex align-items-center gap-2">
              <span style="width:12px;height:12px;border-radius:3px;background:{{ rc }};flex-shrink:0"></span>
              <span style="font-size:.8rem;color:var(--text);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="{{ room.name }}">{{ room.name }}</span>
              <span style="font-size:.8rem;font-weight:700;color:{{ rc }}">{{ room.rate|number_format(1) }}%</span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <div class="rpt-empty"><i class="bi bi-building fs-2 d-block mb-2"></i>Aucune chambre active</div>
        {% endif %}
      </div>
    </div>
  </div>

  {# ── Mouvements récents ── #}
  <div class="rpt-card">
    <div class="rpt-card-hd">
      <span class="rpt-card-title"><i class="bi bi-activity me-2"></i>Mouvements sur la période</span>
      <span class="rpt-badge">{{ recentMovements|length }} opération{{ recentMovements|length != 1 ? 's' : '' }}</span>
    </div>
    <div style="overflow-x:auto">
      <table class="rpt-tbl w-100">
        <thead>
          <tr>
            <th>Date</th>
            <th>Bon</th>
            <th>Type</th>
            <th>Client</th>
            <th>Espèce</th>
            <th class="text-end">Poids (T)</th>
          </tr>
        </thead>
        <tbody>
          {% for m in recentMovements %}
          <tr>
            <td style="white-space:nowrap;color:var(--text-muted);font-size:.83rem">{{ m.date|date('d/m/Y') }}</td>
            <td>
              <code style="font-size:.77rem;color:var(--text-muted);background:rgba(255,255,255,.05);padding:.1rem .4rem;border-radius:4px">{{ m.code }}</code>
            </td>
            <td>
              {% if m.type == 'entry' %}
                <span class="rpt-type-badge rpt-entry"><i class="bi bi-arrow-down-circle me-1"></i>Entrée</span>
              {% else %}
                <span class="rpt-type-badge rpt-exit"><i class="bi bi-arrow-up-circle me-1"></i>Sortie</span>
              {% endif %}
            </td>
            <td style="font-weight:500;font-size:.87rem">{{ m.client }}</td>
            <td style="color:var(--text-muted);font-size:.84rem">{{ m.product }}</td>
            <td class="text-end" style="font-weight:600;font-size:.87rem">{{ m.quantity|number_format(3, ',', ' ') }}</td>
          </tr>
          {% else %}
          <tr>
            <td colspan="6" class="text-center py-5" style="color:var(--text-muted)">
              <i class="bi bi-inbox d-block mb-2" style="font-size:1.8rem"></i>
              Aucun mouvement sur cette période
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>

<style>
/* KPI */
.rpt-kpi {
  padding: 1.1rem 1.4rem;
  border-radius: var(--radius, 12px);
  background: linear-gradient(135deg, var(--g1), var(--g2));
  color: #fff;
  position: relative;
  overflow: hidden;
}
.rpt-kpi::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,.06);
  border-radius: inherit;
}
.rpt-kpi-val { font-size: 1.8rem; font-weight: 700; line-height: 1.1; }
.rpt-kpi-lbl { font-size: .77rem; opacity: .85; margin-top: .3rem; }
.rpt-kpi-ico { font-size: 2.1rem; opacity: .22; }

/* Filter bar */
.rpt-filter-bar {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius, 12px);
  padding: .85rem 1.1rem;
}
.rpt-filter-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.rpt-filter-label {
  font-size: .85rem;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
}
.rpt-filter-group {
  display: flex;
  align-items: center;
  gap: .4rem;
}
.rpt-filter-lbl {
  font-size: .78rem;
  color: var(--text-muted);
  white-space: nowrap;
  margin: 0;
}
.rpt-date-input {
  background: #fff;
  border: 1.5px solid #c7d2fe;
  border-radius: 8px;
  color: #1e293b;
  font-size: .85rem;
  font-weight: 500;
  padding: .38rem .7rem;
  outline: none;
  cursor: pointer;
  transition: border-color .2s, box-shadow .2s;
}
.rpt-date-input:hover {
  border-color: #818cf8;
}
.rpt-date-input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99,102,241,.2);
}
.rpt-apply-btn {
  background: linear-gradient(135deg,#4f46e5,#6366f1);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: .83rem;
  font-weight: 600;
  padding: .38rem .9rem;
  cursor: pointer;
  white-space: nowrap;
  transition: opacity .2s;
}
.rpt-apply-btn:hover { opacity: .88; }
.rpt-shortcuts {
  display: flex;
  gap: .4rem;
  flex-wrap: wrap;
  margin-left: auto;
}
.rpt-shortcut {
  font-size: .76rem;
  padding: .25rem .7rem;
  border-radius: 20px;
  border: 1px solid var(--glass-border);
  color: var(--text-muted);
  text-decoration: none;
  transition: all .2s;
  white-space: nowrap;
}
.rpt-shortcut:hover, .rpt-shortcut.active {
  background: rgba(99,102,241,.15);
  color: #818cf8;
  border-color: rgba(99,102,241,.3);
}

/* Cards */
.rpt-card {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius, 12px);
  overflow: hidden;
  margin-bottom: 1rem;
}
.rpt-card-hd {
  padding: .85rem 1.1rem;
  border-bottom: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rpt-card-title { font-weight: 600; font-size: .91rem; color: var(--text); }
.rpt-badge {
  font-size: .74rem;
  padding: .2rem .65rem;
  border-radius: 20px;
  background: rgba(99,102,241,.12);
  color: #818cf8;
  font-weight: 500;
}

/* Progress bars */
.rpt-bar-track {
  height: 6px;
  background: var(--dark-lighter, rgba(255,255,255,.06));
  border-radius: 3px;
  overflow: hidden;
}
.rpt-bar-fill {
  height: 100%;
  border-radius: 3px;
  transition: width .4s ease;
}

/* Empty state */
.rpt-empty {
  text-align: center;
  padding: 2.5rem 1rem;
  color: var(--text-muted);
  font-size: .9rem;
}

/* Table */
.rpt-tbl { border-collapse: collapse; }
.rpt-tbl th {
  padding: .65rem 1rem;
  font-size: .77rem;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: var(--text-muted);
  font-weight: 600;
  border-bottom: 1px solid var(--glass-border);
  white-space: nowrap;
}
.rpt-tbl td {
  padding: .72rem 1rem;
  color: var(--text);
  border-bottom: 1px solid rgba(255,255,255,.04);
  vertical-align: middle;
}
.rpt-tbl tbody tr:last-child td { border-bottom: none; }
.rpt-tbl tbody tr:hover { background: rgba(255,255,255,.03); }

/* Type badges */
.rpt-type-badge {
  display: inline-flex;
  align-items: center;
  font-size: .78rem;
  font-weight: 500;
  padding: .22rem .6rem;
  border-radius: 20px;
  white-space: nowrap;
}
.rpt-entry {
  background: rgba(16,185,129,.13);
  color: #10b981;
  border: 1px solid rgba(16,185,129,.28);
}
.rpt-exit {
  background: rgba(245,158,11,.13);
  color: #f59e0b;
  border: 1px solid rgba(245,158,11,.28);
}

@media (max-width: 576px) {
  .rpt-shortcuts { margin-left: 0; }
  .rpt-filter-inner { gap: .6rem; }
}
@media print {
  .sidebar, nav, button, .rpt-filter-bar { display: none !important; }
  .rpt-kpi { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if roomOccupancy is not empty %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
(function(){
  const labels  = {{ roomOccupancy|map(r => r.name)|json_encode|raw }};
  const rates   = {{ roomOccupancy|map(r => r.rate)|json_encode|raw }};
  const palette = ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6'];
  const colors  = labels.map((_, i) => palette[i % palette.length]);

  new Chart(document.getElementById('roomDonut').getContext('2d'), {
    type: 'doughnut',
    data: {
      labels,
      datasets: [{
        data: rates,
        backgroundColor: colors.map(c => c + 'cc'),
        borderColor: colors,
        borderWidth: 2,
        hoverOffset: 10,
      }]
    },
    options: {
      cutout: '68%',
      responsive: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: 'rgba(15,23,42,.92)',
          padding: 10,
          cornerRadius: 8,
          callbacks: {
            label: ctx => '  ' + ctx.parsed.toFixed(1) + '% occupé'
          }
        }
      },
      animation: { animateRotate: true, duration: 900 }
    }
  });
})();
</script>
{% endif %}
{% endblock %}
