{% extends 'base.html.twig' %}

{% block title %}Tableau de bord opérationnel{% endblock %}

{% block stylesheets %}
<style>
    .kpi-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.5rem;
        transition: transform .2s;
        position: relative;
        overflow: hidden;
    }
    .kpi-card:hover { transform: translateY(-5px); }
    .kpi-card .kpi-icon {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        opacity: .15;
    }
    .kpi-card h3 { font-size: 2rem; margin: 0; color: var(--text); }
    .kpi-card p { margin: 0; color: var(--text-muted); font-size: .85rem; }
    .chart-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.5rem;
    }
    .chart-card h5 { color: var(--text); margin-bottom: 1rem; }
    .glass-table {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.5rem;
    }
    .glass-table h5 { color: var(--text); }
    .room-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.25rem;
        transition: transform .2s;
    }
    .room-card:hover { transform: translateY(-5px); }
    .room-card h6 { color: var(--text); }
    .room-card .text-muted { color: var(--text-muted) !important; }
    .quick-action {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        text-align: center;
        text-decoration: none;
        color: var(--text);
        transition: transform .2s, border-color .2s;
        display: block;
    }
    .quick-action:hover { transform: translateY(-5px); border-color: var(--primary); color: var(--primary); }
    .quick-action i { font-size: 2rem; display: block; margin-bottom: .5rem; color: var(--primary); }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1" style="color:var(--text)">Tableau de bord</h2>
            <span style="color:var(--text-muted)">{{ app.user.fullName ?? app.user.username }}</span>
            {% if is_granted('ROLE_CHEF_STOCK') %}
                <span class="badge ms-2" style="background:var(--primary)">Chef de Stock</span>
            {% elseif is_granted('ROLE_CONTROLEUR') %}
                <span class="badge ms-2" style="background:#0ea5e9">Contrôleur</span>
            {% endif %}
        </div>
        <div>
            <input type="month" class="form-control form-control-sm" value="{{ 'now'|date('Y-m') }}" style="background:var(--glass-bg);border-color:var(--glass-border);color:var(--text)">
        </div>
    </div>

    {# ── Alert Banner ── #}
    {% if alertRooms is not empty %}
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
            <div>
                <strong>Alerte capacité !</strong>
                {% for room in alertRooms %}
                    {{ room.name }} ({{ room.occupancyRate|number_format(0) }}%){% if not loop.last %}, {% endif %}
                {% endfor %}
                — occupation supérieure à 90%.
            </div>
        </div>
    {% endif %}

    {# ── KPI Cards ── #}
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#6366f1;color:#6366f1"><i class="bi bi-box-arrow-in-down"></i></div>
                <h3>{{ pendingEntriesCount }}</h3>
                <p>Entrées en attente</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#0ea5e9;color:#0ea5e9"><i class="bi bi-box-arrow-up"></i></div>
                <h3>{{ pendingExitsCount }}</h3>
                <p>Sorties en attente</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#10b981;color:#10b981"><i class="bi bi-snow2"></i></div>
                <h3>{{ coldRooms|length }}</h3>
                <p>Chambres actives</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#f59e0b;color:#f59e0b"><i class="bi bi-archive"></i></div>
                {% set totalStock = 0 %}
                {% for room in coldRooms %}{% set totalStock = totalStock + room.usedCapacity %}{% endfor %}
                <h3>{{ totalStock|number_format(1) }} <small style="font-size:.6em">T</small></h3>
                <p>Stock total</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#ef4444;color:#ef4444"><i class="bi bi-grid-3x3-gap"></i></div>
                <h3>—</h3>
                <p>Total Palettes</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#6366f1;color:#6366f1"><i class="bi bi-building"></i></div>
                {% set totalCapacity = 0 %}
                {% for room in coldRooms %}{% set totalCapacity = totalCapacity + room.maxCapacityTons %}{% endfor %}
                <h3>{{ totalCapacity|number_format(0) }} <small style="font-size:.6em">T</small></h3>
                <p>Capacité totale</p>
            </div>
        </div>
    </div>

    {# ── Charts ── #}
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="chart-card">
                <h5><i class="bi bi-bar-chart me-2"></i>Activité du Stock (Entrées vs Sorties)</h5>
                <canvas id="activityChart" height="260"></canvas>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="chart-card">
                <h5><i class="bi bi-pie-chart me-2"></i>Occupation des Chambres</h5>
                <canvas id="occupancyChart" height="260"></canvas>
            </div>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="chart-card">
                <h5><i class="bi bi-graph-up me-2"></i>Évolution mensuelle du stock</h5>
                <canvas id="evolutionChart" height="120"></canvas>
            </div>
        </div>
    </div>

    {# ── Pending Tables ── #}
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="glass-table">
                <h5><i class="bi bi-box-arrow-in-down me-2"></i>Entrées en attente</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0" style="color:var(--text)">
                        <thead><tr><th>Client</th><th>Produit</th><th>Quantité</th><th>Date</th><th></th></tr></thead>
                        <tbody>
                        {% for entry in pendingEntries %}
                            <tr>
                                <td>{{ entry.client.companyName }}</td>
                                <td>{{ entry.productName }}</td>
                                <td>{{ entry.quantityTons }} T</td>
                                <td>{{ entry.createdAt|date('d/m/Y') }}</td>
                                <td class="text-end">
                                    {% if is_granted('ROLE_CHEF_STOCK') %}
                                        <form method="post" action="{{ path('app_stock_entry_validate', {id: entry.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('validate'~entry.id) }}">
                                            <button class="btn btn-sm btn-outline-success" title="Valider"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <button class="btn btn-sm btn-outline-danger" title="Rejeter" data-bs-toggle="modal" data-bs-target="#rejectModal{{ entry.id }}"><i class="bi bi-x-lg"></i></button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center" style="color:var(--text-muted)">Aucune entrée en attente</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="glass-table">
                <h5><i class="bi bi-box-arrow-up me-2"></i>Sorties en attente</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0" style="color:var(--text)">
                        <thead><tr><th>Client</th><th>Produit</th><th>Quantité</th><th>Date</th><th></th></tr></thead>
                        <tbody>
                        {% for exit in pendingExits %}
                            <tr>
                                <td>{{ exit.stockItem.client.companyName }}</td>
                                <td>{{ exit.stockItem.productName }}</td>
                                <td>{{ exit.quantityTons }} T</td>
                                <td>{{ exit.createdAt|date('d/m/Y') }}</td>
                                <td class="text-end">
                                    {% if is_granted('ROLE_CHEF_STOCK') %}
                                        <form method="post" action="{{ path('app_stock_exit_validate', {id: exit.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('validate'~exit.id) }}">
                                            <button class="btn btn-sm btn-outline-success" title="Valider"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center" style="color:var(--text-muted)">Aucune sortie en attente</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# ── Cold Rooms ── #}
    <h5 class="mb-3" style="color:var(--text)"><i class="bi bi-snow2 me-2"></i>État des Chambres Froides</h5>
    <div class="row g-3 mb-4">
        {% for room in coldRooms %}
            <div class="col-sm-6 col-lg-3">
                <div class="room-card">
                    <h6>{{ room.name }}</h6>
                    <small class="text-muted"><i class="bi bi-thermometer-half"></i> {{ room.targetTemperature }}°C</small>
                    <div class="progress mt-2" style="height:8px;background:var(--glass-border)">
                        {% set pct = room.occupancyRate|number_format(0) %}
                        <div class="progress-bar {% if pct > 90 %}bg-danger{% elseif pct > 70 %}bg-warning{% else %}bg-success{% endif %}" style="width:{{ pct }}%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">{{ room.usedCapacity|number_format(1) }} / {{ room.maxCapacityTons }} T</small>
                        <small class="text-muted">{{ pct }}%</small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# ── Quick Actions ── #}
    <h5 class="mb-3" style="color:var(--text)"><i class="bi bi-lightning me-2"></i>Actions rapides</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a href="{{ path('app_stock_entry_new') }}" class="quick-action"><i class="bi bi-box-arrow-in-down"></i>Nouvelle entrée</a>
        </div>
        <div class="col-6 col-lg-3">
            <a href="{{ path('app_stock_exit_new') }}" class="quick-action"><i class="bi bi-box-arrow-up"></i>Nouvelle sortie</a>
        </div>
        <div class="col-6 col-lg-3">
            <a href="{{ path('app_stock_index') }}" class="quick-action"><i class="bi bi-search"></i>Consulter stock</a>
        </div>
        <div class="col-6 col-lg-3">
            <a href="{{ path('app_client_index') }}" class="quick-action"><i class="bi bi-people"></i>Gérer clients</a>
        </div>
    </div>

</div>

{# ── Reject Modals ── #}
{% for entry in pendingEntries %}
    <div class="modal fade" id="rejectModal{{ entry.id }}" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" action="{{ path('app_stock_entry_reject', {id: entry.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('reject'~entry.id) }}">
                <div class="modal-content" style="background:var(--glass-bg);border-color:var(--glass-border);color:var(--text)">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">Rejeter l'entrée</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Rejeter l'entrée de <strong>{{ entry.productName }}</strong> pour <strong>{{ entry.client.companyName }}</strong> ?</p>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Motif du rejet…" required style="background:var(--glass-bg);border-color:var(--glass-border);color:var(--text)"></textarea>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-sm btn-danger">Confirmer le rejet</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endfor %}
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const chartColors = ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444'];
    const months = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];

    // Activity Bar Chart
    new Chart(document.getElementById('activityChart'), {
        type: 'bar',
        data: {
            labels: months,
            datasets: [
                { label: 'Entrées', data: [12,19,8,15,12,10,14,18,9,11,13,16], backgroundColor: '#6366f1' },
                { label: 'Sorties', data: [8,14,6,12,9,7,11,15,7,9,10,13], backgroundColor: '#0ea5e9' }
            ]
        },
        options: { responsive: true, plugins: { legend: { labels: { color: '#94a3b8' }}}, scales: { x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148,163,184,.1)' }}, y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148,163,184,.1)' }}}}
    });

    // Occupancy Doughnut Chart
    (function(){
        const labels = [], data = [], bg = [];
        {% for room in coldRooms %}
            labels.push('{{ room.name }}');
            data.push({{ room.occupancyRate|number_format(1) }});
            bg.push(chartColors[labels.length % chartColors.length]);
        {% endfor %}
        new Chart(document.getElementById('occupancyChart'), {
            type: 'doughnut',
            data: { labels: labels, datasets: [{ data: data, backgroundColor: bg, borderWidth: 0 }] },
            options: { responsive: true, plugins: { legend: { position: 'right', labels: { color: '#94a3b8' }}}}
        });
    })();

    // Evolution Line Chart
    new Chart(document.getElementById('evolutionChart'), {
        type: 'line',
        data: {
            labels: months,
            datasets: [{ label: 'Stock (T)', data: [45,52,48,55,60,58,62,70,65,68,72,75], borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,.1)', fill: true, tension: .4 }]
        },
        options: { responsive: true, plugins: { legend: { labels: { color: '#94a3b8' }}}, scales: { x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148,163,184,.1)' }}, y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(148,163,184,.1)' }}}}
    });
</script>
{% endblock %}
