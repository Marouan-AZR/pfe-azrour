{% extends 'base.html.twig' %}
{% block title %}Tableau de bord — {% if is_granted('ROLE_CHEF_STOCK') %}Chef de Stock{% else %}Contrôleur{% endif %}{% endblock %}

{% block stylesheets %}
<style>
.glass { background:#fff; border:1px solid #e2e8f0; border-radius:1rem; box-shadow:0 4px 24px rgba(0,0,0,.06); }
.kpi-card { transition:transform .18s, box-shadow .18s; }
.kpi-card:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(0,0,0,.08); }
.kpi-icon { width:48px; height:48px; border-radius:.85rem; display:flex; align-items:center; justify-content:center; font-size:1.3rem; flex-shrink:0; }
.section-label { font-size:.73rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#94a3b8; margin-bottom:.85rem; display:flex; align-items:center; gap:.4rem; }

/* Rooms */
.room-card { transition:transform .18s, box-shadow .18s; }
.room-card:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.07); }
.room-bar { height:7px; border-radius:50px; background:#f1f5f9; overflow:hidden; }
.room-bar-fill { height:100%; border-radius:50px; transition:width .5s ease; }

/* Table */
.dash-tbl { width:100%; border-collapse:collapse; }
.dash-tbl thead th { padding:.55rem 1rem; font-size:.71rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; background:#f8fafc; border-bottom:1px solid #e2e8f0; white-space:nowrap; }
.dash-tbl tbody td { padding:.7rem 1rem; font-size:.84rem; color:#1e293b; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
.dash-tbl tbody tr:last-child td { border-bottom:none; }
.dash-tbl tbody tr:hover td { background:#fafbfc; }
.dash-tbl .empty-row td { text-align:center; padding:2.5rem 1rem; color:#94a3b8; }

/* Action cards */
.action-card { text-decoration:none; color:#1e293b; transition:all .18s; display:flex; flex-direction:column; align-items:center; gap:.75rem; padding:1.25rem .75rem; border-radius:1rem; border:1.5px solid #e2e8f0; background:#fff; }
.action-card:hover { border-color:#bfdbfe; background:#eff6ff; color:#2563eb; transform:translateY(-2px); box-shadow:0 6px 20px rgba(37,99,235,.1); }
.action-icon { width:48px; height:48px; border-radius:.85rem; display:flex; align-items:center; justify-content:center; font-size:1.25rem; transition:all .18s; }

/* ── Gradient KPI ── */
.kpi-grad {
    border-radius:1rem; padding:1.1rem 1.4rem; position:relative; overflow:hidden;
    box-shadow:0 6px 24px rgba(0,0,0,.1); transition:transform .2s,box-shadow .2s;
}
.kpi-grad:hover { transform:translateY(-3px); box-shadow:0 14px 36px rgba(0,0,0,.14); }
.kpi-grad::before {
    content:''; position:absolute; top:-30%; right:-20%;
    width:160px; height:160px; border-radius:50%; background:rgba(255,255,255,.12); pointer-events:none;
}
.kpi-grad .kpi-val { font-size:1.9rem; font-weight:800; color:#fff; line-height:1; display:block; margin-bottom:.2rem; }
.kpi-grad .kpi-lbl { color:rgba(255,255,255,.82); font-size:.72rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; }
.kpi-grad .kpi-link { color:rgba(255,255,255,.75); font-size:.72rem; font-weight:600; text-decoration:none; }
.kpi-grad .kpi-link:hover { color:#fff; }
.kpi-grad .kpi-ico { position:absolute; right:1.1rem; top:50%; transform:translateY(-50%); font-size:2.2rem; color:rgba(255,255,255,.18); }
.grad-blue      { background:linear-gradient(135deg,#2563eb,#1d4ed8); }
.grad-turquoise { background:linear-gradient(135deg,#06b6d4,#0891b2); }
.grad-cold      { background:linear-gradient(135deg,#38bdf8,#0ea5e9); }
.grad-indigo    { background:linear-gradient(135deg,#6366f1,#4f46e5); }
.grad-slate     { background:linear-gradient(135deg,#64748b,#475569); }

/* ── Charts ── */
.chart-card { border-radius:1rem; overflow:hidden; }
.chart-header { display:flex; justify-content:space-between; align-items:center; padding:.8rem 1.15rem; border-bottom:1px solid #f1f5f9; }
.chart-badge { background:rgba(99,102,241,.1); color:#4f46e5; font-size:.7rem; font-weight:700; padding:.18em .65em; border-radius:50px; }

/* ── Capacity ring ── */
.cap-ring-wrap { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; gap:.5rem; }
.cap-ring { position:relative; width:130px; height:130px; }
.cap-ring svg { transform:rotate(-90deg); }
.cap-ring .ring-bg   { fill:none; stroke:#f1f5f9; stroke-width:12; }
.cap-ring .ring-fill { fill:none; stroke-width:12; stroke-linecap:round; transition:stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1); }
.cap-ring .ring-text { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">

    {# ── Header ── #}
    {% set hour = "now"|date("H") %}
    {% if hour < 12 %}{% set greeting = "Bonjour" %}{% set g_icon = "bi-sun" %}{% set g_color = "#f59e0b" %}
    {% elseif hour < 18 %}{% set greeting = "Bon après-midi" %}{% set g_icon = "bi-brightness-high" %}{% set g_color = "#f97316" %}
    {% else %}{% set greeting = "Bonsoir" %}{% set g_icon = "bi-moon-stars" %}{% set g_color = "#6366f1" %}{% endif %}

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <p class="text-secondary mb-1 small">
                <i class="bi {{ g_icon }} me-1" style="color:{{ g_color }}"></i>{{ greeting }},
                <strong>{{ app.user.firstName ?? app.user.email }}</strong>
                &nbsp;·&nbsp;
                <i class="bi bi-calendar3 me-1"></i>{{ 'now'|date('d/m/Y') }}
                &nbsp;·&nbsp;
                <i class="bi bi-clock me-1"></i><span id="liveTime">{{ 'now'|date('H:i') }}</span>
            </p>
            <h2 class="mb-1 fw-bold">Tableau de bord</h2>
            {% if is_granted('ROLE_CHEF_STOCK') %}
                <span class="badge rounded-pill" style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;font-size:.78rem;padding:.3em .9em">
                    <i class="bi bi-person-badge me-1"></i>Chef de Stock
                </span>
            {% else %}
                <span class="badge rounded-pill" style="background:#eef2ff;color:#4f46e5;border:1px solid #c7d2fe;font-size:.78rem;padding:.3em .9em">
                    <i class="bi bi-person-badge me-1"></i>Contrôleur
                </span>
            {% endif %}
        </div>
    </div>

    {# ── Alerte capacité ── #}
    {% if alertRooms is not empty %}
    <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-3" style="background:#fef2f2;border:1px solid #fecaca">
        <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0" style="color:#ef4444"></i>
        <div>
            <strong style="color:#991b1b;font-size:.88rem">Alerte capacité —</strong>
            <span style="color:#991b1b;font-size:.83rem">
                {% for room in alertRooms %}{{ room.name }} ({{ (statsByRoomId[room.id].occupancyRate ?? 0)|number_format(0) }}%){% if not loop.last %}, {% endif %}{% endfor %}
                &nbsp;occupation supérieure à 90 %.
            </span>
        </div>
    </div>
    {% endif %}

    {# ── KPI Cards (gradient) ── #}
    {% set totalStock = 0.0 %}{% set totalCapacity = 0.0 %}
    {% for room in coldRooms %}
        {% set roomStats = statsByRoomId[room.id] ?? {} %}
        {% set totalStock    = totalStock    + (roomStats.usedCapacity ?? 0) %}
        {% set totalCapacity = totalCapacity + (room.maxCapacityTons * 1) %}
    {% endfor %}
    {% set globalPct = totalCapacity > 0 ? (totalStock / totalCapacity * 100)|round(1) : 0 %}

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="kpi-grad grad-blue h-100">
                <i class="bi bi-box-arrow-in-down kpi-ico"></i>
                <span class="kpi-val">{{ pendingEntriesCount }}</span>
                <span class="kpi-lbl">{% if is_granted('ROLE_CHEF_STOCK') %}Entrées à valider{% else %}Mes entrées en attente{% endif %}</span>
                <div class="mt-2">
                    <a href="{{ path('app_operation_entry_index') }}" class="kpi-link">Voir toutes <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-grad grad-turquoise h-100">
                <i class="bi bi-box-arrow-up kpi-ico"></i>
                <span class="kpi-val">{{ pendingExitsCount }}</span>
                <span class="kpi-lbl">{% if is_granted('ROLE_CHEF_STOCK') %}Sorties à valider{% else %}Mes sorties en attente{% endif %}</span>
                <div class="mt-2">
                    <a href="{{ path('app_operation_exit_index') }}" class="kpi-link">Voir toutes <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-grad grad-cold h-100">
                <i class="bi bi-snow2 kpi-ico"></i>
                <span class="kpi-val">{{ coldRooms|length }}</span>
                <span class="kpi-lbl">Chambres actives
                    {% if alertRooms is not empty %}
                    <span style="display:block;color:rgba(255,200,100,.9);font-size:.68rem;margin-top:.1rem">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>{{ alertRooms|length }} en alerte
                    </span>
                    {% endif %}
                </span>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi-grad grad-indigo h-100">
                <i class="bi bi-database-fill kpi-ico"></i>
                <span class="kpi-val">{{ totalStock|number_format(1) }} <small style="font-size:.45em">T</small></span>
                <span class="kpi-lbl">Stock total</span>
                <div class="mt-2">
                    <a href="{{ path('app_stock_index') }}" class="kpi-link">État du stock <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    {# ── KPI supplémentaires Chef de Stock ── #}
    {% if is_granted('ROLE_CHEF_STOCK') %}
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="kpi-grad grad-slate h-100">
                <i class="bi bi-boxes kpi-ico"></i>
                <span class="kpi-val">{{ pallettesEnStock ?? 0 }}</span>
                <span class="kpi-lbl">Palettes en stock</span>
                <div class="mt-2">
                    <a href="{{ path('app_stock_index') }}" class="kpi-link">Voir le stock <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="kpi-grad grad-blue h-100">
                <i class="bi bi-box-arrow-in-down kpi-ico"></i>
                <span class="kpi-val">{{ entriesToday ?? 0 }}</span>
                <span class="kpi-lbl">Entrées du jour</span>
                <div class="mt-2">
                    <a href="{{ path('app_operation_entry_index') }}" class="kpi-link">Voir les entrées <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="kpi-grad grad-turquoise h-100">
                <i class="bi bi-box-arrow-up kpi-ico"></i>
                <span class="kpi-val">{{ exitesToday ?? 0 }}</span>
                <span class="kpi-lbl">Sorties du jour</span>
                <div class="mt-2">
                    <a href="{{ path('app_operation_exit_index') }}" class="kpi-link">Voir les sorties <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# ══════════════════════════════════════
       SECTION GRAPHES
    ══════════════════════════════════════ #}
    <div class="row g-4 mb-4">

        {# Occupancy donut chart #}
        <div class="col-lg-6">
            <div class="glass chart-card h-100">
                <div class="chart-header">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-pie-chart-fill me-2 text-primary"></i>Occupation des chambres
                    </h6>
                    <span class="chart-badge">Taux d'utilisation %</span>
                </div>
                <div class="p-3 d-flex align-items-center gap-4 flex-wrap justify-content-center">
                    <div style="position:relative;width:190px;height:190px;flex-shrink:0">
                        <canvas id="chartChambers"></canvas>
                        <div id="chamberCenterLabel" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none">
                            <span id="chamberCenterPct" style="font-size:1.5rem;font-weight:800;color:#0f172a;line-height:1">{{ globalPct }}%</span>
                            <span style="font-size:.68rem;color:#64748b;font-weight:600;margin-top:.15rem">occupation</span>
                        </div>
                    </div>
                    <div id="chambersLegend" style="display:flex;flex-direction:column;gap:.45rem;min-width:140px"></div>
                </div>
            </div>
        </div>

        {# Donut pending ops #}
        <div class="col-lg-3">
            <div class="glass chart-card h-100">
                <div class="chart-header">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-pie-chart-fill me-2 text-warning"></i>File d'attente
                    </h6>
                </div>
                <div class="p-3 d-flex flex-column align-items-center justify-content-center" style="min-height:200px">
                    {% if pendingEntriesCount + pendingExitsCount > 0 %}
                    <div style="position:relative;max-width:160px;width:100%">
                        <canvas id="chartPending"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none">
                            <span class="fw-bold" style="font-size:1.4rem;color:#0f172a;line-height:1">{{ pendingEntriesCount + pendingExitsCount }}</span>
                            <span style="font-size:.68rem;color:#64748b;font-weight:600">en attente</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mt-3 small">
                        <span><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#2563eb;margin-right:4px"></span>Entrées</span>
                        <span><span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#06b6d4;margin-right:4px"></span>Sorties</span>
                    </div>
                    {% else %}
                    <div class="text-center py-3 text-secondary">
                        <i class="bi bi-check-circle-fill d-block mb-2" style="font-size:2rem;color:#10b981;opacity:.6"></i>
                        <small class="fw-semibold">Aucune opération<br>en attente</small>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Capacity ring #}
        <div class="col-lg-3">
            <div class="glass chart-card h-100">
                <div class="chart-header">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-speedometer2 me-2 text-success"></i>Capacité globale
                    </h6>
                </div>
                <div class="cap-ring-wrap p-3">
                    <div class="cap-ring">
                        <svg width="130" height="130" viewBox="0 0 130 130">
                            <circle class="ring-bg"   cx="65" cy="65" r="54"/>
                            <circle class="ring-fill" cx="65" cy="65" r="54"
                                id="capRingFill"
                                stroke="{{ globalPct > 90 ? '#ef4444' : (globalPct > 70 ? '#f59e0b' : '#10b981') }}"
                                stroke-dasharray="{{ (2 * 3.14159 * 54)|round(2) }}"
                                stroke-dashoffset="{{ (2 * 3.14159 * 54)|round(2) }}"
                                data-pct="{{ globalPct }}"/>
                        </svg>
                        <div class="ring-text">
                            <span class="fw-bold" style="font-size:1.5rem;color:#0f172a;line-height:1" id="capPct">0%</span>
                            <span style="font-size:.68rem;color:#64748b;font-weight:600">utilisé</span>
                        </div>
                    </div>
                    <div class="text-center" style="font-size:.78rem;color:#64748b">
                        <strong style="color:#0f172a">{{ totalStock|number_format(1) }} T</strong> /
                        {{ totalCapacity|number_format(0) }} T
                    </div>
                    {% if globalPct > 90 %}
                    <span style="background:#fef2f2;color:#991b1b;border-radius:50px;padding:.2em .7em;font-size:.72rem;font-weight:700">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Capacité critique
                    </span>
                    {% elseif globalPct > 70 %}
                    <span style="background:#fffbeb;color:#92400e;border-radius:50px;padding:.2em .7em;font-size:.72rem;font-weight:700">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>Presque plein
                    </span>
                    {% else %}
                    <span style="background:#ecfdf5;color:#065f46;border-radius:50px;padding:.2em .7em;font-size:.72rem;font-weight:700">
                        <i class="bi bi-check-circle-fill me-1"></i>Capacité normale
                    </span>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

    {# ── Occupation du stock par client (Chef de Stock seulement) ── #}
    {% if is_granted('ROLE_CHEF_STOCK') %}
    <div class="section-label"><i class="bi bi-people"></i> Occupation du stock par client</div>
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="glass chart-card h-100">
                <div class="chart-header">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-bar-chart-horizontal-fill me-2 text-primary"></i>Poids en stock par client (T)
                    </h6>
                    <span class="chart-badge">Temps réel</span>
                </div>
                <div class="p-3" style="min-height:200px">
                    {% if stockByClient is not empty %}
                    <canvas id="chartClientOccupancy" style="max-height:300px"></canvas>
                    {% else %}
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 py-4 text-secondary">
                        <i class="bi bi-people d-block mb-2" style="font-size:2.2rem;opacity:.25"></i>
                        <small class="fw-semibold">Aucun client en stock actuellement</small>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            {% if stockByClient is not empty %}
            {% set totalQty = 0 %}
            {% for s in stockByClient %}{% set totalQty = totalQty + s.quantity %}{% endfor %}
            {% set topClient = stockByClient|first %}
            <div class="d-flex flex-column gap-3 h-100">
                {# Total stock clients #}
                <div class="glass p-3 flex-fill" style="border-left:4px solid #2563eb">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:.75rem;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-database-fill" style="color:#2563eb;font-size:1.1rem"></i>
                        </div>
                        <div>
                            <div class="text-secondary" style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em">Stock total clients</div>
                            <div class="fw-bold" style="font-size:1.35rem;color:#0f172a;line-height:1.1">{{ totalQty|number_format(1) }} <small style="font-size:.5em;color:#64748b">T</small></div>
                        </div>
                    </div>
                </div>
                {# Nombre de clients actifs #}
                <div class="glass p-3 flex-fill" style="border-left:4px solid #06b6d4">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:.75rem;background:#ecfeff;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-people-fill" style="color:#06b6d4;font-size:1.1rem"></i>
                        </div>
                        <div>
                            <div class="text-secondary" style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em">Clients en stock</div>
                            <div class="fw-bold" style="font-size:1.35rem;color:#0f172a;line-height:1.1">{{ stockByClient|length }}</div>
                        </div>
                    </div>
                </div>
                {# Client principal #}
                <div class="glass p-3 flex-fill" style="border-left:4px solid #8b5cf6">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:.75rem;background:#f5f3ff;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-trophy-fill" style="color:#8b5cf6;font-size:1.1rem"></i>
                        </div>
                        <div style="min-width:0">
                            <div class="text-secondary" style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em">Client principal</div>
                            <div class="fw-bold text-truncate" style="font-size:.95rem;color:#0f172a;line-height:1.2">{{ topClient.name }}</div>
                            <div style="font-size:.75rem;color:#8b5cf6;font-weight:700">{{ topClient.quantity|number_format(1) }} T — {{ totalQty > 0 ? ((topClient.quantity / totalQty) * 100)|round(1) : 0 }}%</div>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="glass chart-card h-100 d-flex flex-column align-items-center justify-content-center py-4 text-secondary">
                <i class="bi bi-people d-block mb-2" style="font-size:2.2rem;opacity:.25"></i>
                <small class="fw-semibold">Aucune donnée client</small>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# ── Chambres froides ── #}
    <div class="section-label"><i class="bi bi-snow2"></i> État des chambres froides</div>
    <div class="row g-3 mb-4">
        {% for room in coldRooms %}
            {% set roomStats = statsByRoomId[room.id] ?? {occupancyRate: 0, usedCapacity: 0} %}
            {% set pct = roomStats.occupancyRate|round(1) %}
            {% if pct > 90 %}{% set barColor = '#ef4444' %}{% set badgeStyle = 'background:#fef2f2;color:#991b1b' %}
            {% elseif pct > 70 %}{% set barColor = '#f59e0b' %}{% set badgeStyle = 'background:#fffbeb;color:#92400e' %}
            {% else %}{% set barColor = '#10b981' %}{% set badgeStyle = 'background:#ecfdf5;color:#065f46' %}{% endif %}
            <div class="col-xl-3 col-md-4 col-sm-6">
                <div class="glass p-3 room-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-semibold" style="font-size:.88rem;color:#1e293b">
                                <i class="bi bi-snow2 me-1" style="color:#2563eb"></i>{{ room.name }}
                            </div>
                            <div class="text-secondary mt-1" style="font-size:.75rem">
                                <i class="bi bi-thermometer-half me-1"></i>{{ room.targetTemperature }}°C
                            </div>
                        </div>
                        <span class="rounded-pill px-2 py-1 fw-bold" style="{{ badgeStyle }};font-size:.72rem">
                            {{ pct|number_format(0) }}%
                        </span>
                    </div>
                    <div class="room-bar my-2">
                        <div class="room-bar-fill" style="width:{{ min(pct, 100) }}%;background:{{ barColor }}"></div>
                    </div>
                    <div class="d-flex justify-content-between" style="font-size:.73rem;color:#94a3b8">
                        <span>{{ roomStats.usedCapacity|number_format(1, '.', ' ') }} T utilisées</span>
                        <span>{{ (room.maxCapacityTons * 1)|number_format(1, '.', ' ') }} T max</span>
                    </div>
                    {% if roomStats.usedCapacity > room.maxCapacityTons * 1 %}
                    <div class="mt-1" style="font-size:.7rem;color:#ef4444;font-weight:700">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Capacité dépassée
                    </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="col-12"><p class="text-secondary small">Aucune chambre active.</p></div>
        {% endfor %}
    </div>

    {# ── Opérations en attente ── #}
    <div class="section-label">
        <i class="bi bi-hourglass-split"></i>
        {% if is_granted('ROLE_CHEF_STOCK') %}Opérations en attente de validation{% else %}Mes opérations assignées{% endif %}
    </div>
    <div class="row g-3 mb-4">

        {# Entrées #}
        <div class="col-xl-6">
            <div class="glass overflow-hidden h-100">
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                    <h6 class="mb-0 fw-semibold" style="font-size:.88rem">
                        <i class="bi bi-box-arrow-in-down me-2" style="color:#2563eb"></i>
                        Entrées — {% if is_granted('ROLE_CHEF_STOCK') %}att. validation{% else %}att. contrôle{% endif %}
                    </h6>
                    <span class="badge rounded-pill" style="background:#eff6ff;color:#2563eb;font-size:.72rem">{{ pendingEntriesCount }}</span>
                </div>
                <div class="table-responsive">
                    <table class="dash-tbl">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Client</th>
                                <th>Espèces</th>
                                <th class="text-center">Cartons</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for op in pendingEntries %}
                            <tr>
                                <td>
                                    <code style="background:#eff6ff;color:#2563eb;padding:.15em .4em;border-radius:.3rem;font-size:.78rem;font-weight:700">{{ op.code }}</code>
                                </td>
                                <td class="fw-semibold">{{ op.client.companyName }}</td>
                                <td>
                                    {% for esp in op.especes|slice(0,2) %}
                                        <span style="background:#f1f5f9;color:#475569;padding:.1em .4em;border-radius:.25rem;font-size:.72rem;font-weight:600;margin-right:.15rem">{{ esp }}</span>
                                    {% endfor %}
                                    {% if op.especes|length > 2 %}<span style="font-size:.7rem;color:#94a3b8">+{{ op.especes|length - 2 }}</span>{% endif %}
                                </td>
                                <td class="text-center fw-semibold" style="color:#4f46e5">{{ op.totalCartons }}</td>
                                <td style="color:#94a3b8;font-size:.78rem">{{ op.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('app_operation_show', {id: op.id}) }}"
                                       class="btn btn-sm" style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;padding:.25rem .5rem;font-size:.78rem">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr class="empty-row">
                                <td colspan="6">
                                    <i class="bi bi-inbox d-block mb-1" style="font-size:1.5rem;opacity:.25"></i>
                                    Aucune entrée en attente
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if pendingEntriesCount > pendingEntries|length %}
                <div class="text-center py-2 border-top" style="background:#fafbfc">
                    <a href="{{ path('app_operation_entry_index') }}" class="text-decoration-none" style="font-size:.78rem;color:#2563eb;font-weight:600">
                        Voir les {{ pendingEntriesCount - pendingEntries|length }} autres <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                {% endif %}
            </div>
        </div>

        {# Sorties #}
        <div class="col-xl-6">
            <div class="glass overflow-hidden h-100">
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                    <h6 class="mb-0 fw-semibold" style="font-size:.88rem">
                        <i class="bi bi-box-arrow-up me-2" style="color:#2563eb"></i>
                        Sorties — {% if is_granted('ROLE_CHEF_STOCK') %}att. contrôle / validation{% else %}att. contrôle{% endif %}
                    </h6>
                    <span class="badge rounded-pill" style="background:#eff6ff;color:#2563eb;font-size:.72rem">{{ pendingExitsCount }}</span>
                </div>
                <div class="table-responsive">
                    <table class="dash-tbl">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Client</th>
                                <th>Espèces</th>
                                <th class="text-center">Cartons</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for op in pendingExits %}
                            <tr>
                                <td>
                                    <code style="background:#eff6ff;color:#1d4ed8;padding:.15em .4em;border-radius:.3rem;font-size:.78rem;font-weight:700">{{ op.code }}</code>
                                </td>
                                <td class="fw-semibold">{{ op.client.companyName }}</td>
                                <td>
                                    {% for esp in op.especesSorties|slice(0,2) %}
                                        <span style="background:#f1f5f9;color:#475569;padding:.1em .4em;border-radius:.25rem;font-size:.72rem;font-weight:600;margin-right:.15rem">{{ esp }}</span>
                                    {% endfor %}
                                    {% if op.especesSorties|length > 2 %}<span style="font-size:.7rem;color:#94a3b8">+{{ op.especesSorties|length - 2 }}</span>{% endif %}
                                </td>
                                <td class="text-center fw-semibold" style="color:#2563eb">{{ op.totalCartonsSortis }}</td>
                                <td style="color:#94a3b8;font-size:.78rem">{{ op.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    {% if not is_granted('ROLE_CHEF_STOCK') and op.status.value in ['pending','en_attente_controle'] %}
                                    <a href="{{ path('app_operation_exit_controle', {id: op.id}) }}"
                                       class="btn btn-sm" style="background:#eef2ff;color:#4f46e5;border:1px solid #c7d2fe;padding:.25rem .5rem;font-size:.78rem" title="Contrôle terrain">
                                        <i class="bi bi-clipboard-check"></i>
                                    </a>
                                    {% else %}
                                    <a href="{{ path('app_operation_show', {id: op.id}) }}"
                                       class="btn btn-sm" style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;padding:.25rem .5rem;font-size:.78rem" title="Voir détail">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr class="empty-row">
                                <td colspan="6">
                                    <i class="bi bi-inbox d-block mb-1" style="font-size:1.5rem;opacity:.25"></i>
                                    Aucune sortie en attente
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if pendingExitsCount > pendingExits|length %}
                <div class="text-center py-2 border-top" style="background:#fafbfc">
                    <a href="{{ path('app_operation_exit_index') }}" class="text-decoration-none" style="font-size:.78rem;color:#2563eb;font-weight:600">
                        Voir les {{ pendingExitsCount - pendingExits|length }} autres <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Actions rapides ── #}
    <div class="section-label"><i class="bi bi-lightning-charge"></i> Actions rapides</div>
    <div class="row g-3">
        <div class="col-xl col-md-3 col-sm-6">
            <a href="{{ path('app_operation_entry_new') }}" class="action-card">
                <div class="action-icon" style="background:#eff6ff;color:#2563eb"><i class="bi bi-box-arrow-in-down"></i></div>
                <span class="fw-semibold" style="font-size:.85rem">Nouvelle entrée</span>
            </a>
        </div>
        <div class="col-xl col-md-3 col-sm-6">
            <a href="{{ path('app_operation_exit_prepare') }}" class="action-card">
                <div class="action-icon" style="background:#eff6ff;color:#2563eb"><i class="bi bi-box-arrow-up"></i></div>
                <span class="fw-semibold" style="font-size:.85rem">Nouvelle sortie</span>
            </a>
        </div>
        <div class="col-xl col-md-3 col-sm-6">
            <a href="{{ path('app_stock_index') }}" class="action-card">
                <div class="action-icon" style="background:#ecfdf5;color:#10b981"><i class="bi bi-clipboard-data"></i></div>
                <span class="fw-semibold" style="font-size:.85rem">État du stock</span>
            </a>
        </div>
        {% if is_granted('ROLE_CHEF_STOCK') %}
        <div class="col-xl col-md-3 col-sm-6">
            <a href="{{ path('app_client_index') }}" class="action-card">
                <div class="action-icon" style="background:#fffbeb;color:#f59e0b"><i class="bi bi-people"></i></div>
                <span class="fw-semibold" style="font-size:.85rem">Gérer clients</span>
            </a>
        </div>
        {% endif %}
        <div class="col-xl col-md-3 col-sm-6">
            <a href="{{ path('app_cold_room_index') }}" class="action-card">
                <div class="action-icon" style="background:#f5f3ff;color:#8b5cf6"><i class="bi bi-snow2"></i></div>
                <span class="fw-semibold" style="font-size:.85rem">Chambres froides</span>
            </a>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
// ── Live clock ──────────────────────────────────────────
function tickClock() {
    const now = new Date();
    const el = document.getElementById('liveTime');
    if (el) el.textContent = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
}
setInterval(tickClock, 10000);

Chart.defaults.font.family = 'inherit';
Chart.defaults.color = '#64748b';

// ── Données Twig → JS ────────────────────────────────────
const roomNames = [{% for room in coldRooms %}'{{ room.name|e('js') }}'{{ not loop.last ? ',' }}{% endfor %}];
const roomPcts  = [{% for room in coldRooms %}
    {% set s = statsByRoomId[room.id] ?? {} %}
    {{ (s.occupancyRate ?? 0)|round(1) }}{{ not loop.last ? ',' }}
{% endfor %}];
const roomUsed  = [{% for room in coldRooms %}
    {% set s = statsByRoomId[room.id] ?? {} %}
    {{ (s.usedCapacity ?? 0)|round(2) }}{{ not loop.last ? ',' }}
{% endfor %}];
const pendingE  = {{ pendingEntriesCount }};
const pendingS  = {{ pendingExitsCount }};

const tooltipStyle = { backgroundColor:'#1e293b', padding:10, cornerRadius:8, titleFont:{weight:'700'} };

// ── 1. Chamber occupancy doughnut chart ──────────────────
const chamberCtx = document.getElementById('chartChambers');
if (chamberCtx && roomNames.length > 0) {
    const palette = [
        '#2563eb','#06b6d4','#8b5cf6','#f59e0b',
        '#10b981','#ef4444','#ec4899','#f97316',
        '#14b8a6','#6366f1','#84cc16','#0ea5e9'
    ];
    const chamberColors = roomNames.map((_, i) => palette[i % palette.length]);

    new Chart(chamberCtx, {
        type: 'doughnut',
        data: {
            labels: roomNames,
            datasets: [{
                data: roomUsed.map(v => v || 0.001),
                backgroundColor: chamberColors,
                borderWidth: 3,
                borderColor: '#fff',
                hoverOffset: 8,
            }]
        },
        options: {
            responsive: true,
            cutout: '68%',
            animation: { duration:1200, easing:'easeOutQuart' },
            plugins: {
                legend: { display:false },
                tooltip: {
                    ...tooltipStyle,
                    callbacks: {
                        label: ctx => ` ${roomNames[ctx.dataIndex]} — ${roomPcts[ctx.dataIndex]}% (${roomUsed[ctx.dataIndex]} T)`
                    }
                }
            }
        }
    });

    // Légende personnalisée
    const legend = document.getElementById('chambersLegend');
    if (legend) {
        roomNames.forEach((name, i) => {
            const color = chamberColors[i];
            const pct   = roomPcts[i];
            const badgeStyle = pct > 90
                ? 'background:#fee2e2;color:#991b1b'
                : pct > 70
                    ? 'background:#fef3c7;color:#92400e'
                    : 'background:#f1f5f9;color:#475569';
            legend.innerHTML += `
                <div style="display:flex;align-items:center;gap:.5rem">
                    <span style="width:10px;height:10px;border-radius:50%;background:${color};flex-shrink:0"></span>
                    <span style="font-size:.8rem;color:#334155;font-weight:600;flex:1">${name}</span>
                    <span style="font-size:.72rem;font-weight:700;padding:.1em .5em;border-radius:50px;${badgeStyle}">${pct}%</span>
                </div>`;
        });
    }
}

// ── 2. Donut file d'attente ──────────────────────────────
const donutCtx = document.getElementById('chartPending');
if (donutCtx && (pendingE + pendingS) > 0) {
    new Chart(donutCtx, {
        type: 'doughnut',
        data: {
            labels: ['Entrées', 'Sorties'],
            datasets: [{
                data: [pendingE || 0.001, pendingS || 0.001],
                backgroundColor: ['#2563eb','#06b6d4'],
                borderWidth: 3,
                borderColor: '#fff',
                hoverOffset: 6,
            }]
        },
        options: {
            responsive: true,
            cutout: '68%',
            animation: { animateRotate:true, duration:1000 },
            plugins: {
                legend: { display:false },
                tooltip: { ...tooltipStyle, callbacks:{ label: ctx => ` ${ctx.label} : ${ctx.parsed}` } }
            }
        }
    });
}

// ── 3. Client occupation charts (Chef de Stock) ─────────
{% if is_granted('ROLE_CHEF_STOCK') and stockByClient is not empty %}
(function() {
    const cPalette = ['#2563eb','#06b6d4','#8b5cf6','#f59e0b','#10b981','#ef4444','#ec4899','#f97316'];
    const cNames   = [{% for s in stockByClient %}'{{ s.name|e('js') }}'{{ not loop.last ? ',' }}{% endfor %}];
    const cWeights = [{% for s in stockByClient %}{{ s.quantity }}{{ not loop.last ? ',' }}{% endfor %}];
    const cTotal   = cWeights.reduce((a, b) => a + b, 0);
    const cColors  = cNames.map((_, i) => cPalette[i % cPalette.length]);

    // Horizontal bar
    new Chart(document.getElementById('chartClientOccupancy'), {
        type: 'bar',
        data: {
            labels: cNames,
            datasets: [{ label: 'Poids en stock (T)', data: cWeights, backgroundColor: cColors.map(c => c + 'cc'), borderRadius: 6, borderWidth: 0 }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { ...tooltipStyle, callbacks: { label: ctx => ` ${ctx.parsed.x.toFixed(2)} T — ${cTotal > 0 ? ((ctx.parsed.x / cTotal) * 100).toFixed(1) : 0}%` } }
            },
            scales: {
                x: { ticks: { color: '#64748b', callback: v => v + ' T' }, grid: { color: 'rgba(0,0,0,.04)' } },
                y: { ticks: { color: '#334155', font: { weight: '600', size: 12 } }, grid: { display: false } }
            }
        }
    });


})();
{% endif %}

// ── 5. Capacity ring animation ───────────────────────────
const ringFill = document.getElementById('capRingFill');
const capLabel = document.getElementById('capPct');
if (ringFill) {
    const pct = parseFloat(ringFill.dataset.pct) || 0;
    const circumference = 2 * Math.PI * 54;
    setTimeout(() => {
        const offset = circumference - (pct / 100 * circumference);
        ringFill.style.strokeDashoffset = offset;
        // Animate label
        let cur = 0;
        const step = pct / 60;
        const run = () => {
            cur = Math.min(cur + step, pct);
            if (capLabel) capLabel.textContent = cur.toFixed(1) + '%';
            if (cur < pct) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
    }, 200);
}
</script>
{% endblock %}
