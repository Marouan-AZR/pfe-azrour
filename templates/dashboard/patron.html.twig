{% extends 'base.html.twig' %}

{% block title %}Vue Stratégique — Patron{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    :root { --c1:#6366f1;--c2:#0ea5e9;--c3:#10b981;--c4:#f59e0b;--c5:#ef4444;--c6:#8b5cf6; }
    body { background: var(--bg, #f1f5f9); color: var(--text, #1e293b); }
    .glass { background: rgba(30,41,59,.7); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.08); border-radius: 1rem; }
    .kpi-card { transition: transform .2s; }
    .kpi-card:hover { transform: translateY(-4px); }
    .kpi-icon { width:48px;height:48px;border-radius:.75rem;display:flex;align-items:center;justify-content:center;font-size:1.4rem; }
    .badge-role { font-size:.75rem;padding:.35em .75em;border-radius:2rem; }
    .btn-action { border-radius:.75rem;padding:.75rem 1.25rem;font-weight:500;transition:all .2s; }
    .btn-action:hover { transform:translateY(-2px); }
    canvas { max-height: 300px; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">

    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1 fw-bold">Vue Stratégique</h2>
            <span class="badge badge-role bg-warning bg-opacity-25 text-warning"><i class="bi bi-star me-1"></i>Patron</span>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width:auto">
                <option>Ce mois</option><option>Ce trimestre</option><option>Cette année</option>
            </select>
        </div>
    </div>

    {# ── KPI Cards ── #}
    {% set kpis = [
        { icon:'bi-cash-stack',     color:'var(--c1)', label:'CA mensuel',         value: revenueThisMonth|number_format(2,'.',',')|default('0') ~ ' DH' },
        { icon:'bi-calendar-range', color:'var(--c2)', label:'CA annuel',          value: revenueThisYear|number_format(2,'.',',')|default('0') ~ ' DH' },
        { icon:'bi-speedometer2',   color:'var(--c3)', label:'Taux occupation',    value: avgOccupancy|round(1) ~ ' %' },
        { icon:'bi-box-seam',       color:'var(--c4)', label:'Capacité utilisée',  value: usedCapacity ~ ' / ' ~ totalCapacity ~ ' T' },
        { icon:'bi-snow2',          color:'var(--c6)', label:'Chambres actives',   value: coldRooms|length }
    ] %}
    <div class="row g-3 mb-4">
        {% for k in kpis %}
        <div class="col-xl col-md-4 col-6">
            <div class="glass p-3 kpi-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background:{{ k.color }}22;color:{{ k.color }}"><i class="bi {{ k.icon }}"></i></div>
                    <div>
                        <small class="text-secondary">{{ k.label }}</small>
                        <h5 class="mb-0 fw-bold">{{ k.value }}</h5>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ── Charts ── #}
    <div class="row g-3 mb-4">
        <div class="col-lg-8"><div class="glass p-3"><h6 class="mb-3"><i class="bi bi-bar-chart me-2"></i>Entrées vs Sorties par mois</h6><canvas id="chartBar"></canvas></div></div>
        <div class="col-lg-4"><div class="glass p-3"><h6 class="mb-3"><i class="bi bi-pie-chart me-2"></i>Répartition stock par client</h6><canvas id="chartPie"></canvas></div></div>
        <div class="col-lg-6"><div class="glass p-3"><h6 class="mb-3"><i class="bi bi-graph-up me-2"></i>Évolution du stock</h6><canvas id="chartLine"></canvas></div></div>
        <div class="col-lg-6"><div class="glass p-3"><h6 class="mb-3"><i class="bi bi-building me-2"></i>Occupation chambres froides</h6><canvas id="chartOccupancy"></canvas></div></div>
    </div>

    {# ── Quick Actions ── #}
    <div class="row g-3 mb-4">
        {% set actions = [
            { route:'app_reports',       icon:'bi-file-earmark-bar-graph', label:'Rapports',   color:'var(--c2)' },
            { route:'app_invoice_index', icon:'bi-receipt',    label:'Factures',   color:'var(--c1)' },
            { route:'app_history_index', icon:'bi-clock-history',label:'Historique', color:'var(--c4)' }
        ] %}
        {% for a in actions %}
        <div class="col-md-4 col-6">
            <a href="{{ path(a.route) }}" class="glass p-3 d-flex align-items-center gap-3 text-decoration-none text-light btn-action">
                <div class="kpi-icon" style="background:{{ a.color }}22;color:{{ a.color }}"><i class="bi {{ a.icon }}"></i></div>
                <span class="fw-semibold">{{ a.label }}</span>
            </a>
        </div>
        {% endfor %}
    </div>

    {# ── Export ── #}
    <div class="glass p-3">
        <h6 class="mb-3"><i class="bi bi-download me-2"></i>Exporter</h6>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <button class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>
            <button class="btn btn-outline-info btn-sm"><i class="bi bi-bar-chart me-1"></i>Graphiques</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
const C=['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6'];
const dOpts={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#94a3b8'}}}};
const scaleOpts={x:{ticks:{color:'#94a3b8'},grid:{color:'rgba(255,255,255,.05)'}},y:{ticks:{color:'#94a3b8'},grid:{color:'rgba(255,255,255,.05)'}}};
const months=['Jan','Fév','Mar','Avr','Mai','Jun'];

new Chart(document.getElementById('chartBar'),{type:'bar',data:{labels:months,datasets:[
    {label:'Entrées',data:[120,150,180,140,200,170],backgroundColor:C[0]+'cc'},
    {label:'Sorties',data:[80,110,130,100,160,140],backgroundColor:C[1]+'cc'}
]},options:{...dOpts,scales:scaleOpts}});

new Chart(document.getElementById('chartPie'),{type:'pie',data:{labels:['Client A','Client B','Client C','Client D'],datasets:[{data:[35,25,22,18],backgroundColor:[C[0],C[1],C[2],C[3]]}]},options:dOpts});

new Chart(document.getElementById('chartLine'),{type:'line',data:{labels:months,datasets:[{label:'Stock (T)',data:[500,520,480,530,510,540],borderColor:C[2],backgroundColor:C[2]+'22',fill:true,tension:.4}]},options:{...dOpts,scales:scaleOpts}});

// Occupancy chart uses real coldRooms data from controller
const roomLabels=[{% for room in coldRooms %}'{{ room.name }}'{{ not loop.last ? ',' }}{% endfor %}];
const roomData=[{% for room in coldRooms %}{{ room.occupancyRate }}{{ not loop.last ? ',' }}{% endfor %}];
new Chart(document.getElementById('chartOccupancy'),{type:'bar',data:{labels:roomLabels,datasets:[{label:'Occupation %',data:roomData,backgroundColor:roomLabels.map((_,i)=>C[i%C.length])}]},options:{...dOpts,indexAxis:'y',scales:{x:{max:100,ticks:{color:'#94a3b8',callback:v=>v+'%'},grid:{color:'rgba(255,255,255,.05)'}},y:{ticks:{color:'#94a3b8'},grid:{color:'rgba(255,255,255,.05)'}}}}});
</script>
{% endblock %}
