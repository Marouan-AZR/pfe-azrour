{% extends 'base.html.twig' %}

{% block title %}Mon Espace Client{% endblock %}

{% block body %}
<style>
    .glass-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        color: #1e293b;
    }
    .glass-card .card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 600;
    }
    .kpi-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: transform 0.2s;
    }
    .kpi-card:hover { transform: translateY(-4px); }
    .kpi-icon {
        width: 48px; height: 48px;
        border-radius: 0.75rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
    }
    .table-dark-custom { color: #1e293b; }
    .table-dark-custom thead th {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .table-dark-custom td { border-color: #e2e8f0; vertical-align: middle; }
    .badge-actif { background: rgba(25, 135, 84, 0.15); color: #198754; }
    .badge-epuise { background: rgba(220, 53, 69, 0.15); color: #dc3545; }
    body { background: #f1f5f9; }
</style>

<div class="container-fluid py-4">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-speedometer2 me-2"></i>Mon Espace Client</h2>
            <span class="text-muted">{{ client.companyName }}</span>
        </div>
        <span class="badge bg-info bg-opacity-25 text-info fs-6 px-3 py-2"><i class="bi bi-person-badge me-1"></i>Client</span>
    </div>

    {# KPI Cards #}
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="kpi-card p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon bg-primary bg-opacity-25 text-primary"><i class="bi bi-box-seam"></i></div>
                <div>
                    <div class="text-muted small">Stock total</div>
                    <div class="fs-4 fw-bold">{{ totalStock|number_format(2, '.', ' ') }} T</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon bg-success bg-opacity-25 text-success"><i class="bi bi-stack"></i></div>
                <div>
                    <div class="text-muted small">Palettes en stock</div>
                    <div class="fs-4 fw-bold">{{ stockItems|length }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon bg-warning bg-opacity-25 text-warning"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="text-muted small">Factures récentes</div>
                    <div class="fs-4 fw-bold">{{ recentInvoices|length }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card p-3 d-flex align-items-center gap-3">
                <div class="kpi-icon bg-info bg-opacity-25 text-info"><i class="bi bi-calendar-check"></i></div>
                <div>
                    <div class="text-muted small">Dernière entrée</div>
                    <div class="fs-5 fw-bold">
                        {% if recentEntries|length > 0 %}
                            {{ recentEntries[0].createdAt|date('d/m/Y') }}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Mon Stock Table #}
    <div class="glass-card mb-4">
        <div class="card-header px-4 py-3 d-flex justify-content-between align-items-center">
            <span><i class="bi bi-box-seam me-2"></i>Mon Stock</span>
            <a href="{{ path('app_stock_index') }}" class="btn btn-sm btn-outline-primary">Voir tout</a>
        </div>
        <div class="table-responsive">
            <table class="table table-dark-custom mb-0">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Famille</th>
                        <th>Qualité</th>
                        <th>Chambre</th>
                        <th>Rayon</th>
                        <th>Cartons</th>
                        <th>Poids restant (kg)</th>
                        <th>Jours stockage</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in stockItems %}
                        <tr>
                            <td>{{ item.productName }}</td>
                            <td>{{ item.stockEntry.famille ?? '—' }}</td>
                            <td>{{ item.stockEntry.qualite ?? '—' }}</td>
                            <td>{{ item.coldRoom.name }}</td>
                            <td>{{ item.stockEntry.rayon ?? '—' }}</td>
                            <td>{{ item.stockEntry.nombreCartons ?? '—' }}</td>
                            <td>{{ (item.remainingQuantity * 1000)|number_format(1, '.', ' ') }}</td>
                            <td>{{ item.storageDays }}</td>
                            <td>
                                {% if item.remainingQuantity > 0 %}
                                    <span class="badge badge-actif">Actif</span>
                                {% else %}
                                    <span class="badge badge-epuise">Épuisé</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="text-center text-muted py-4">Aucun stock disponible</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Recent Entries & Invoices Row #}
    <div class="row g-4 mb-4">
        {# Dernières entrées #}
        <div class="col-lg-6">
            <div class="glass-card h-100">
                <div class="card-header px-4 py-3"><i class="bi bi-arrow-down-circle me-2"></i>Dernières entrées</div>
                <div class="table-responsive">
                    <table class="table table-dark-custom mb-0">
                        <thead>
                            <tr><th>Date</th><th>Produit</th><th>Quantité (T)</th><th>Statut</th></tr>
                        </thead>
                        <tbody>
                            {% for entry in recentEntries %}
                                <tr>
                                    <td>{{ entry.createdAt|date('d/m/Y') }}</td>
                                    <td>{{ entry.productName ?? '—' }}</td>
                                    <td>{{ entry.quantityTons|number_format(2, '.', ' ') }}</td>
                                    <td><span class="badge badge-actif">Enregistrée</span></td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-center text-muted py-3">Aucune entrée récente</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Dernières factures #}
        <div class="col-lg-6">
            <div class="glass-card h-100">
                <div class="card-header px-4 py-3"><i class="bi bi-receipt-cutoff me-2"></i>Dernières factures</div>
                <div class="table-responsive">
                    <table class="table table-dark-custom mb-0">
                        <thead>
                            <tr><th>Numéro</th><th>Période</th><th>Montant</th><th>Statut</th><th></th></tr>
                        </thead>
                        <tbody>
                            {% for invoice in recentInvoices %}
                                <tr>
                                    <td>{{ invoice.invoiceNumber }}</td>
                                    <td>{{ invoice.periodStart|date('d/m') }} — {{ invoice.periodEnd|date('d/m/Y') }}</td>
                                    <td>{{ invoice.totalTtc|number_format(2, '.', ' ') }} MAD</td>
                                    <td>
                                        <span class="badge bg-{{ invoice.status.cssClass }}">
                                            {{ invoice.status.label }}
                                        </span>
                                    </td>
                                    <td><a href="{{ path('app_invoice_show', {id: invoice.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted py-3">Aucune facture récente</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# Quick Actions #}
    <div class="d-flex gap-3">
        <a href="{{ path('app_stock_index') }}" class="btn btn-primary px-4"><i class="bi bi-box-seam me-2"></i>Voir mon stock</a>
        <a href="{{ path('app_invoice_index') }}" class="btn btn-outline-secondary px-4"><i class="bi bi-receipt me-2"></i>Mes factures</a>
    </div>
</div>
{% endblock %}
