{% extends 'base.html.twig' %}
{% block title %}Tableau de bord Directeur{% endblock %}

{% block stylesheets %}
<style>
.glass { background:#fff; border:1px solid #e2e8f0; border-radius:1rem; box-shadow:0 4px 24px rgba(0,0,0,.06); }

/* ── Gradient KPI (identique au chef de stock) ── */
.kpi-grad {
    border-radius:1rem; padding:1.1rem 1.4rem; position:relative; overflow:hidden;
    box-shadow:0 6px 24px rgba(0,0,0,.1); transition:transform .2s,box-shadow .2s;
}
.kpi-grad:hover { transform:translateY(-3px); box-shadow:0 14px 36px rgba(0,0,0,.14); }
.kpi-grad::before {
    content:''; position:absolute; top:-30%; right:-20%;
    width:160px; height:160px; border-radius:50%; background:rgba(255,255,255,.12); pointer-events:none;
}
.kpi-grad .kpi-val  { font-size:1.9rem; font-weight:800; color:#fff; line-height:1; display:block; margin-bottom:.2rem; }
.kpi-grad .kpi-lbl  { color:rgba(255,255,255,.82); font-size:.72rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; }
.kpi-grad .kpi-link { color:rgba(255,255,255,.75); font-size:.72rem; font-weight:600; text-decoration:none; }
.kpi-grad .kpi-link:hover { color:#fff; }
.kpi-grad .kpi-ico  { position:absolute; right:1.1rem; top:50%; transform:translateY(-50%); font-size:2.2rem; color:rgba(255,255,255,.18); }
.grad-indigo    { background:linear-gradient(135deg,#6366f1,#4f46e5); }
.grad-sky       { background:linear-gradient(135deg,#0ea5e9,#0284c7); }
.grad-emerald   { background:linear-gradient(135deg,#10b981,#059669); }
.grad-rose      { background:linear-gradient(135deg,#ef4444,#dc2626); }
.grad-amber     { background:linear-gradient(135deg,#f59e0b,#d97706); }
.grad-violet    { background:linear-gradient(135deg,#8b5cf6,#7c3aed); }
.grad-blue      { background:linear-gradient(135deg,#2563eb,#1d4ed8); }
.grad-turquoise { background:linear-gradient(135deg,#06b6d4,#0891b2); }

/* Section labels */
.section-label { font-size:.73rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#94a3b8; margin-bottom:.85rem; display:flex; align-items:center; gap:.4rem; }

/* Charts */
.chart-card { border-radius:1rem; overflow:hidden; transition:box-shadow .2s; }
.chart-card:hover { box-shadow:0 8px 28px rgba(0,0,0,.09); }
.chart-header { display:flex; justify-content:space-between; align-items:center; padding:.8rem 1.15rem; border-bottom:1px solid #f1f5f9; }
.chart-header h6 { font-size:.85rem; margin:0; }
.chart-badge { background:rgba(99,102,241,.1); color:#4f46e5; font-size:.7rem; font-weight:700; padding:.18em .65em; border-radius:50px; }

/* Table */
.dash-tbl { width:100%; border-collapse:collapse; }
.dash-tbl thead th { padding:.55rem 1rem; font-size:.71rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; background:#f8fafc; border-bottom:1px solid #e2e8f0; white-space:nowrap; }
.dash-tbl tbody td { padding:.7rem 1rem; font-size:.84rem; color:#1e293b; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
.dash-tbl tbody tr:last-child td { border-bottom:none; }
.dash-tbl tbody tr:hover td { background:#fafbfc; }
.dash-tbl .empty-row td { text-align:center; padding:2.5rem 1rem; color:#94a3b8; }

/* Room cards */
.room-card { transition:transform .18s, box-shadow .18s; }
.room-card:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.07); }
.room-bar { height:7px; border-radius:50px; background:#f1f5f9; overflow:hidden; }
.room-bar-fill { height:100%; border-radius:50px; transition:width .5s ease; }

/* Quick actions */
.action-card { text-decoration:none; color:#1e293b; transition:all .18s; display:flex; flex-direction:column; align-items:center; gap:.75rem; padding:1.25rem .75rem; border-radius:1rem; border:1.5px solid #e2e8f0; background:#fff; }
.action-card:hover { border-color:#bfdbfe; background:#eff6ff; color:#2563eb; transform:translateY(-2px); box-shadow:0 6px 20px rgba(37,99,235,.1); }
.action-icon { width:48px; height:48px; border-radius:.85rem; display:flex; align-items:center; justify-content:center; font-size:1.25rem; transition:all .18s; }

/* Notif btn */
.notif-btn {
    display:inline-flex; align-items:center; gap:.5rem;
    background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff;
    border:none; border-radius:.75rem; padding:.55rem 1.1rem;
    font-size:.82rem; font-weight:600; text-decoration:none;
    box-shadow:0 4px 12px rgba(245,158,11,.3); transition:transform .18s;
}
.notif-btn:hover { transform:translateY(-2px); color:#fff; }

/* ── Alertes stock critique ── */
.alert-critical-banner {
    background:linear-gradient(135deg,#fef2f2,#fff5f5);
    border:1.5px solid #fecaca;
    border-left:5px solid #ef4444;
    border-radius:.85rem;
    padding:1rem 1.25rem;
    margin-bottom:1.25rem;
    animation: pulse-border 2s infinite;
}
@keyframes pulse-border {
    0%,100% { border-left-color:#ef4444; }
    50%      { border-left-color:#dc2626; }
}
.alert-critical-title {
    font-size:.78rem; font-weight:800;
    text-transform:uppercase; letter-spacing:.07em;
    color:#b91c1c; display:flex; align-items:center; gap:.5rem;
    margin-bottom:.75rem;
}
.critical-client-card {
    background:#fff;
    border:1px solid #fecaca;
    border-radius:.6rem;
    padding:.6rem .9rem;
    display:flex;
    align-items:center;
    gap:.75rem;
    transition:box-shadow .18s, border-color .18s;
}
.critical-client-card:hover {
    box-shadow:0 4px 16px rgba(239,68,68,.15);
    border-color:#f87171;
}
.critical-pct-ring {
    width:46px; height:46px;
    border-radius:50%;
    background:conic-gradient(#ef4444 calc(var(--pct) * 1%), #f1f5f9 0%);
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
    position:relative;
}
.critical-pct-ring::after {
    content:'';
    position:absolute; inset:6px;
    background:#fff; border-radius:50%;
}
.critical-pct-val {
    position:relative; z-index:1;
    font-size:.65rem; font-weight:800; color:#ef4444; line-height:1;
    text-align:center;
}
.critical-badge {
    font-size:.65rem; font-weight:700; padding:.18em .6em;
    border-radius:50px; white-space:nowrap;
}
.badge-danger  { background:#fee2e2; color:#b91c1c; }
.badge-warning { background:#fef3c7; color:#92400e; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">

    {# ── En-tête ── #}
    {% set hour = "now"|date("H") %}
    {% if hour < 12 %}{% set greeting = "Bonjour" %}{% set g_icon = "bi-sun" %}{% set g_color = "#f59e0b" %}
    {% elseif hour < 18 %}{% set greeting = "Bon après-midi" %}{% set g_icon = "bi-brightness-high" %}{% set g_color = "#f97316" %}
    {% else %}{% set greeting = "Bonsoir" %}{% set g_icon = "bi-moon-stars" %}{% set g_color = "#6366f1" %}{% endif %}

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <p class="text-secondary mb-1 small">
                <i class="bi {{ g_icon }} me-1" style="color:{{ g_color }}"></i>{{ greeting }},
                <strong>{{ app.user.firstName ?? app.user.email }}</strong>
                &nbsp;·&nbsp;
                <i class="bi bi-calendar3 me-1"></i>{{ 'now'|date('d/m/Y') }}
                &nbsp;·&nbsp;
                <i class="bi bi-clock me-1"></i>{{ 'now'|date('H:i') }}
            </p>
            <h2 class="mb-1 fw-bold">Tableau de bord</h2>
            <span class="badge rounded-pill" style="background:#eef2ff;color:#4f46e5;border:1px solid #c7d2fe;font-size:.78rem;padding:.3em .9em">
                <i class="bi bi-shield-check me-1"></i>Directeur
            </span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            {% if pendingInvoicesCount > 0 %}
            <a href="{{ path('app_invoice_index') }}" class="notif-btn">
                <i class="bi bi-bell-fill"></i>
                {{ pendingInvoicesCount }} facture{{ pendingInvoicesCount > 1 ? 's' : '' }} en attente
            </a>
            {% endif %}
            <a href="{{ path('app_shelf_plan') }}" class="action-card" style="padding:.55rem .85rem;flex-direction:row;gap:.5rem">
                <i class="bi bi-grid-3x3-gap" style="color:#6366f1;font-size:1.1rem"></i>
                <span style="font-size:.78rem;font-weight:600">Plan rayons</span>
            </a>
        </div>
    </div>

    {# ── Alertes stock critique (≤ 20%) ── #}
    {% if criticalClients is defined and criticalClients|length > 0 %}
    <div class="alert-critical-banner">
        <div class="alert-critical-title">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:1rem;color:#ef4444"></i>
            <span>{{ criticalClients|length }} client{{ criticalClients|length > 1 ? 's' : '' }} en seuil critique — stock restant ≤ 20 %</span>
            <a href="{{ path('app_stock_index') }}" class="ms-auto text-decoration-none"
               style="font-size:.72rem;color:#ef4444;font-weight:600;white-space:nowrap">
                Voir le stock <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-2">
            {% for client in criticalClients %}
            {% set pct = client.percentage %}
            {% set danger = pct <= 10 %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="critical-client-card">
                    {# Anneau de pourcentage #}
                    <div class="critical-pct-ring" style="--pct:{{ pct }}">
                        <span class="critical-pct-val">{{ pct }}%</span>
                    </div>
                    <div style="flex:1;min-width:0">
                        <div class="fw-bold text-truncate" style="font-size:.84rem;color:#0f172a">
                            {{ client.name }}
                        </div>
                        <div style="font-size:.73rem;color:#64748b;margin-top:.1rem">
                            <i class="bi bi-box-seam me-1"></i>
                            <strong style="color:#ef4444">{{ client.restants }}</strong> / {{ client.total }} cartons restants
                        </div>
                        <div style="margin-top:.35rem">
                            <div style="height:5px;border-radius:50px;background:#fee2e2;overflow:hidden">
                                <div style="height:100%;width:{{ pct }}%;border-radius:50px;background:{{ danger ? '#dc2626' : '#f97316' }};transition:width .5s"></div>
                            </div>
                        </div>
                    </div>
                    <span class="critical-badge {{ danger ? 'badge-danger' : 'badge-warning' }}">
                        {{ danger ? 'Critique' : 'Faible' }}
                    </span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── KPI gradient ── #}
    {% set variation = revenueLastMonth > 0 ? ((revenueThisMonth - revenueLastMonth) / revenueLastMonth * 100)|round(1) : 0 %}
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl">
            <div class="kpi-grad grad-indigo h-100">
                <i class="bi bi-cash-stack kpi-ico"></i>
                <span class="kpi-val" style="font-size:1.5rem">{{ revenueThisMonth|number_format(0,'.',',') }}</span>
                <span class="kpi-lbl">CA ce mois (DH)</span>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="kpi-grad grad-sky h-100">
                <i class="bi bi-calendar-check kpi-ico"></i>
                <span class="kpi-val" style="font-size:1.5rem">{{ revenueLastMonth|number_format(0,'.',',') }}</span>
                <span class="kpi-lbl">CA mois précédent (DH)</span>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="kpi-grad {{ variation >= 0 ? 'grad-emerald' : 'grad-rose' }} h-100">
                <i class="bi bi-graph-{{ variation >= 0 ? 'up' : 'down' }}-arrow kpi-ico"></i>
                <span class="kpi-val">
                    <i class="bi bi-arrow-{{ variation >= 0 ? 'up' : 'down' }}-short" style="font-size:1.6rem;vertical-align:middle"></i>{{ variation|abs }} %
                </span>
                <span class="kpi-lbl">Variation mensuelle</span>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="kpi-grad grad-amber h-100">
                <i class="bi bi-hourglass-split kpi-ico"></i>
                <span class="kpi-val">{{ pendingInvoicesCount }}</span>
                <span class="kpi-lbl">Factures en attente</span>
                <div class="mt-2">
                    <a href="{{ path('app_invoice_index') }}" class="kpi-link">Voir toutes <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl">
            <div class="kpi-grad grad-violet h-100">
                <i class="bi bi-box-seam kpi-ico"></i>
                <span class="kpi-val">{{ totalStock|number_format(1,'.','') }} <small style="font-size:.45em">T</small></span>
                <span class="kpi-lbl">Stock total</span>
                <div class="mt-2">
                    <a href="{{ path('app_stock_index') }}" class="kpi-link">État du stock <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    {# ── Graphes : Occupation clients + CA Evolution ── #}
    <div class="row g-4 mb-4">

        {# Donut occupation clients #}
        <div class="col-lg-5">
            <div class="glass chart-card h-100">
                <div class="chart-header">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-people-fill me-2 text-primary"></i>Occupation par client
                    </h6>
                    <span class="chart-badge">{{ stockByClient|length }} client{{ stockByClient|length > 1 ? 's' : '' }}</span>
                </div>
                <div class="p-3 d-flex align-items-center gap-4 flex-wrap justify-content-center">
                    {% if stockByClient is not empty %}
                        {% set totalQ = 0 %}
                        {% for s in stockByClient %}{% set totalQ = totalQ + s.quantity %}{% endfor %}
                        <div style="position:relative;width:180px;height:180px;flex-shrink:0">
                            <canvas id="chartPie"></canvas>
                            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none">
                                <span style="font-size:1.4rem;font-weight:800;color:#0f172a;line-height:1">{{ totalQ|number_format(1,'.','') }}</span>
                                <span style="font-size:.65rem;color:#64748b;font-weight:600;margin-top:.15rem">T total</span>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:.45rem;min-width:140px;max-height:170px;overflow-y:auto">
                            {% set pieColors = ['#2563eb','#06b6d4','#8b5cf6','#f59e0b','#10b981','#ef4444','#ec4899','#f97316'] %}
                            {% for s in stockByClient %}
                            <div style="display:flex;align-items:center;gap:.5rem">
                                <span style="width:10px;height:10px;border-radius:50%;background:{{ pieColors[loop.index0 % 8] }};flex-shrink:0"></span>
                                <span style="font-size:.8rem;color:#334155;font-weight:600;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:110px">{{ s.name }}</span>
                                <span style="font-size:.72rem;font-weight:700;padding:.1em .5em;border-radius:50px;background:#f1f5f9;color:#475569;white-space:nowrap">{{ s.quantity|number_format(1,'.',',') }} T</span>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4 text-secondary w-100">
                            <i class="bi bi-inbox d-block mb-2" style="font-size:2rem;opacity:.25"></i>
                            <small class="fw-semibold">Aucun stock actif</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Line chart CA 6 mois #}
        <div class="col-lg-7">
            <div class="glass chart-card h-100">
                <div class="chart-header">
                    <h6 class="fw-semibold mb-0">
                        <i class="bi bi-graph-up me-2 text-success"></i>Évolution du CA (6 derniers mois)
                    </h6>
                    <span class="chart-badge" style="background:rgba(16,185,129,.1);color:#059669">DH</span>
                </div>
                <div class="p-3" style="height:230px">
                    <canvas id="chartLine"></canvas>
                </div>
            </div>
        </div>

    </div>

    {# ── Chambres froides (cartes, même style que chef de stock) ── #}
    <div class="section-label"><i class="bi bi-thermometer-snow"></i> Taux d'occupation — Chambres froides</div>
    <div class="row g-3 mb-4">
        {% for room in coldRooms %}
            {% set roomStats = statsByRoomId[room.id] ?? {occupancyRate: 0, usedCapacity: 0} %}
            {% set pct = roomStats.occupancyRate|round(1) %}
            {% if pct > 90 %}{% set barColor = '#ef4444' %}{% set badgeStyle = 'background:#fef2f2;color:#991b1b' %}
            {% elseif pct > 70 %}{% set barColor = '#f59e0b' %}{% set badgeStyle = 'background:#fffbeb;color:#92400e' %}
            {% else %}{% set barColor = '#10b981' %}{% set badgeStyle = 'background:#ecfdf5;color:#065f46' %}{% endif %}
            <div class="col-xl-3 col-md-4 col-sm-6">
                <div class="glass p-3 room-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-semibold" style="font-size:.88rem;color:#1e293b">
                                <i class="bi bi-snow2 me-1" style="color:#2563eb"></i>{{ room.name }}
                            </div>
                            <div class="text-secondary mt-1" style="font-size:.75rem">
                                <i class="bi bi-thermometer-half me-1"></i>{{ room.targetTemperature }}°C
                            </div>
                        </div>
                        <span class="rounded-pill px-2 py-1 fw-bold" style="{{ badgeStyle }};font-size:.72rem">
                            {{ pct|number_format(0) }}%
                        </span>
                    </div>
                    <div class="room-bar my-2">
                        <div class="room-bar-fill" style="width:{{ min(pct, 100) }}%;background:{{ barColor }}"></div>
                    </div>
                    <div class="d-flex justify-content-between" style="font-size:.73rem;color:#94a3b8">
                        <span>{{ roomStats.usedCapacity|number_format(1, '.', ' ') }} T utilisées</span>
                        <span>{{ (room.maxCapacityTons * 1)|number_format(1, '.', ' ') }} T max</span>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12"><p class="text-secondary small">Aucune chambre active.</p></div>
        {% endfor %}
    </div>

    {# ── Factures en attente ── #}
    <div class="section-label">
        <i class="bi bi-receipt"></i> Factures en attente de validation
        {% if pendingInvoicesCount > 0 %}
        <span class="badge rounded-pill ms-1" style="background:#f59e0b;color:#fff;font-size:.62rem">{{ pendingInvoicesCount }}</span>
        {% endif %}
    </div>
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="glass overflow-hidden">
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                    <h6 class="mb-0 fw-semibold" style="font-size:.88rem">
                        <i class="bi bi-receipt me-2 text-warning"></i>Factures à valider
                    </h6>
                    <a href="{{ path('app_invoice_index') }}" class="chart-badge text-decoration-none">
                        Voir tout <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="table-responsive" style="max-height:260px;overflow-y:auto">
                    <table class="dash-tbl">
                        <thead style="position:sticky;top:0;z-index:1">
                            <tr>
                                <th>N° Facture</th>
                                <th>Client</th>
                                <th>Période</th>
                                <th>Montant TTC</th>
                                <th>Créée le</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for invoice in pendingInvoices %}
                            <tr>
                                <td>
                                    <code style="background:#eef2ff;color:#4f46e5;padding:.15em .4em;border-radius:.3rem;font-size:.78rem;font-weight:700">{{ invoice.invoiceNumber }}</code>
                                </td>
                                <td class="fw-semibold">{{ invoice.client.companyName }}</td>
                                <td style="color:#94a3b8;font-size:.78rem">{{ invoice.periodStart|date('d/m/Y') }} – {{ invoice.periodEnd|date('d/m/Y') }}</td>
                                <td><span class="fw-bold" style="font-size:.88rem">{{ invoice.totalTtc|number_format(2,'.',',') }} DH</span></td>
                                <td style="color:#94a3b8;font-size:.78rem">{{ invoice.createdAt|date('d/m/Y') }}</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="{{ path('app_invoice_show', {id: invoice.id}) }}"
                                           class="btn btn-sm" style="background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;padding:.25rem .5rem;font-size:.78rem">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_invoice_validate', {id: invoice.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('validate'~invoice.id) }}">
                                            <button class="btn btn-sm" style="background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;padding:.25rem .6rem;font-size:.78rem"
                                                    onclick="return confirm('Valider la facture {{ invoice.invoiceNumber }} ?')">
                                                <i class="bi bi-check-lg me-1"></i>Valider
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr class="empty-row">
                                <td colspan="6">
                                    <i class="bi bi-check-circle-fill d-block mb-1" style="font-size:1.5rem;color:#10b981;opacity:.5"></i>
                                    Aucune facture en attente de validation
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# ── Actions rapides ── #}
    <div class="section-label"><i class="bi bi-lightning-charge"></i> Actions rapides</div>
    <div class="row g-3">
        <div class="col-xl col-md-3 col-sm-6">
            <a href="{{ path('app_invoice_index') }}" class="action-card">
                <div class="action-icon" style="background:#eef2ff;color:#6366f1"><i class="bi bi-receipt"></i></div>
                <span class="fw-semibold" style="font-size:.85rem">Factures</span>
            </a>
        </div>
        <div class="col-xl col-md-3 col-sm-6">
