{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
Chart.defaults.font.family = 'inherit';
Chart.defaults.color = '#64748b';

const tip = {
    backgroundColor:'#1e293b', padding:10, cornerRadius:8,
    titleFont:{weight:'700',size:11}, bodyFont:{size:11},
};

const C = ['#2563eb','#06b6d4','#8b5cf6','#f59e0b','#10b981','#ef4444','#ec4899','#f97316'];

/* ── Donut occupation clients ── */
{% if stockByClient is not empty %}
new Chart(document.getElementById('chartPie'), {
    type: 'doughnut',
    data: {
        labels: [{% for s in stockByClient %}'{{ s.name|e('js') }}'{{ not loop.last ? ',' }}{% endfor %}],
        datasets: [{
            data: [{% for s in stockByClient %}{{ s.quantity }}{{ not loop.last ? ',' }}{% endfor %}],
            backgroundColor: C,
            borderWidth: 3,
            borderColor: '#fff',
            hoverOffset: 8,
        }]
    },
    options: {
        responsive: true,
        cutout: '68%',
        animation: { duration: 1200, easing: 'easeOutQuart' },
        plugins: {
            legend: { display: false },
            tooltip: {
                ...tip,
                callbacks: {
                    label: ctx => {
                        const total = ctx.dataset.data.reduce((a,b) => a+b, 0);
                        return ` ${ctx.label} — ${ctx.parsed.toFixed(2)} T (${total > 0 ? ((ctx.parsed/total)*100).toFixed(1) : 0}%)`;
                    }
                }
            }
        }
    }
});
{% endif %}

/* ── Line chart CA 6 derniers mois (données réelles) ── */
const lineCtx = document.getElementById('chartLine');
if (lineCtx) {
    const caLabels = {{ caMonthly|map(m => m.label)|json_encode|raw }};
    const caData   = {{ caMonthly|map(m => m.revenue)|json_encode|raw }};

    new Chart(lineCtx, {
        type: 'line',
        data: {
            labels: caLabels,
            datasets: [{
                label: 'CA (MAD)',
                data: caData,
                borderColor: '#10b981',
                backgroundColor: 'rgba(16,185,129,.08)',
                fill: true,
                tension: .42,
                pointBackgroundColor: caData.map((v, i) => i === caData.length - 1 ? '#059669' : '#10b981'),
                pointRadius: caData.map((v, i) => i === caData.length - 1 ? 6 : 4),
                pointHoverRadius: 7,
                borderWidth: 2.5,
                clip: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 1000 },
            layout: { padding: { right: 20, top: 8 } },
            plugins: {
                legend: { display: false },
                tooltip: {
                    ...tip,
                    callbacks: {
                        label: ctx => ` ${ctx.parsed.y.toLocaleString('fr-FR')} MAD`
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: { font: { size: 10 } }
                },
                y: {
                    grid: { color: '#f1f5f9' },
                    border: { display: false },
                    beginAtZero: true,
                    ticks: {
                        callback: v => v >= 1000 ? (v/1000).toFixed(0) + 'k' : v
                    }
                }
            }
        }
    });
}
</script>
{% endblock %}
