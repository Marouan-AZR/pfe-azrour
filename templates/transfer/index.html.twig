{% extends 'base.html.twig' %}

{% block title %}Transferts{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-arrow-left-right me-2"></i>Mes Transferts</h1>
        <a href="{{ path('app_transfer_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouveau transfert</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Palette</th>
                        <th>De</th>
                        <th>Vers</th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in transfers %}
                    <tr>
                        <td>{{ t.transferredAt|date('d/m/Y H:i') }}</td>
                        <td><code>{{ t.palette.codePalette }}</code></td>
                        <td>{{ t.fromColdRoom.name }} {% if t.fromRayon %}- {{ t.fromRayon }}{% endif %}</td>
                        <td>{{ t.toColdRoom.name }} {% if t.toRayon %}- {{ t.toRayon }}{% endif %}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-3">Aucun transfert</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
