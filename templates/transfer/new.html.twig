{% extends 'base.html.twig' %}

{% block title %}Nouveau Transfert{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <h1 class="mb-4"><i class="bi bi-arrow-left-right me-2"></i>Nouveau Transfert</h1>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            {% if not palette %}
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Code Palette</label>
                    <input type="text" name="code_palette" class="form-control" placeholder="Scanner ou saisir le code palette" required autofocus>
                </div>
                <button class="btn btn-primary"><i class="bi bi-search me-1"></i>Rechercher</button>
            </form>
            {% else %}
            <form method="post">
                <input type="hidden" name="code_palette" value="{{ palette.codePalette }}">
                <input type="hidden" name="confirm" value="1">

                <h5 class="mb-3">Informations palette</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label text-muted">Code</label>
                        <input class="form-control" value="{{ palette.codePalette }}" readonly>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Espèce</label>
                        <input class="form-control" value="{{ palette.espece }}" readonly>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Cartons restants</label>
                        <input class="form-control" value="{{ palette.cartonsRestants }}" readonly>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Poids restant</label>
                        <input class="form-control" value="{{ palette.poidsRestant }} kg" readonly>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Emplacement actuel</label>
                        <input class="form-control" value="{{ palette.coldRoom ? palette.coldRoom.name : 'N/A' }} {{ palette.rayon ? '- ' ~ palette.rayon : '' }}" readonly>
                    </div>
                </div>

                <hr>
                <h5 class="mb-3">Nouvel emplacement</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Chambre froide</label>
                        <select name="new_cold_room" class="form-select" required>
                            <option value="">-- Sélectionner --</option>
                            {% for room in coldRooms %}
                                <option value="{{ room.id }}">{{ room.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rayon</label>
                        <input type="text" name="new_rayon" class="form-control" placeholder="Ex: A1, B2...">
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Confirmer le transfert</button>
                    <a href="{{ path('app_transfer_index') }}" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
