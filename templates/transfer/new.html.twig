{% extends 'base.html.twig' %}

{% block title %}Nouveau Transfert{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-arrow-left-right me-2"></i>Nouveau Transfert</h2>
            <small class="text-muted">Scanner une palette pour effectuer un transfert</small>
        </div>
        <a href="{{ path('app_transfer_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>

    {# Étape 1 : Scanner #}
    <div class="card mb-4">
        <div class="card-header"><i class="bi bi-upc-scan me-2"></i>Étape 1 : Identifier la palette</div>
        <div class="card-body">
            <form method="post" class="row g-3 align-items-end" id="scanForm">
                <div class="col-md-6">
                    <label class="form-label">Code palette</label>
                    <input type="text" name="code_palette" class="form-control" placeholder="Scanner ou saisir le code palette" value="{{ palette ? palette.codePalette : '' }}" required autofocus>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-info w-100"><i class="bi bi-search"></i> Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    {% if palette %}
    {# Étape 2 : Informations palette (lecture seule) #}
    <div class="card mb-4">
        <div class="card-header"><i class="bi bi-info-circle me-2"></i>Étape 2 : Informations de la palette</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><strong>Code :</strong> {{ palette.codePalette }}</div>
                <div class="col-md-3"><strong>Client :</strong> {{ palette.operation.client.companyName }}</div>
                <div class="col-md-3"><strong>Espèce :</strong> {{ palette.espece }}</div>
                <div class="col-md-3"><strong>Qualité :</strong> {{ palette.qualite ?? '—' }}</div>
                <div class="col-md-3"><strong>Moule :</strong> {{ palette.moule ?? '—' }}</div>
                <div class="col-md-3"><strong>Famille :</strong> {{ palette.famille ?? '—' }}</div>
                <div class="col-md-3"><strong>Cartons :</strong> {{ palette.cartonsRestants }}</div>
                <div class="col-md-3"><strong>Poids :</strong> {{ (palette.poidsRestant * 1000)|number_format(0, ',', ' ') }} kg</div>
                <div class="col-md-6 mt-3">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-geo-alt me-1"></i> <strong>Localisation actuelle :</strong>
                        {{ palette.coldRoom ? palette.coldRoom.name : 'Non assignée' }} / {{ palette.rayon ?? '—' }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Étape 3 : Nouvelle localisation #}
    <div class="card">
        <div class="card-header"><i class="bi bi-geo-alt me-2"></i>Étape 3 : Nouvelle localisation</div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="code_palette" value="{{ palette.codePalette }}">
                <input type="hidden" name="confirm" value="1">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Nouvelle chambre</label>
                        <select name="new_cold_room" class="form-select" required>
                            <option value="">-- Sélectionner --</option>
                            {% for room in coldRooms %}
                                <option value="{{ room.id }}">{{ room.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nouveau rayon</label>
                        <select name="new_rayon" class="form-select">
                            <option value="">-- Sélectionner --</option>
                            {% for i in 1..44 %}
                                <option value="R{{ '%02d'|format(i) }}">R{{ '%02d'|format(i) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success flex-grow-1"><i class="bi bi-check-circle"></i> Confirmer</button>
                            <a href="{{ path('app_transfer_new') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
