{% extends 'base.html.twig' %}
{% block title %}Modifier {{ client.companyName }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-center py-4">
    <div style="width:100%;max-width:600px">
        <div class="text-center mb-4">
            <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:inline-flex;align-items:center;justify-content:center;margin-bottom:1rem">
                <i class="bi bi-pencil-square text-white fs-3"></i>
            </div>
            <h2 style="color:var(--text)">Modifier le client</h2>
            <p class="text-muted">Mettre à jour les informations du client</p>
        </div>

        <div class="card" style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius)">
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    <label class="form-label"><i class="bi bi-building me-1 text-primary"></i> Raison sociale</label>
                    {{ form_widget(form.companyName, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyName) }}
                </div>

                <div class="mb-3">
                    <label class="form-label"><i class="bi bi-upc me-1 text-primary"></i> Code client</label>
                    {{ form_widget(form.code, {'attr': {'class': 'form-control', 'readonly': true}}) }}
                    {{ form_errors(form.code) }}
                </div>

                <div class="mb-3">
                    <label class="form-label"><i class="bi bi-file-earmark-text me-1 text-primary"></i> N° d'agrément</label>
                    {{ form_widget(form.numeroAgrement, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.numeroAgrement) }}
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label"><i class="bi bi-envelope me-1 text-primary"></i> Email</label>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label"><i class="bi bi-telephone me-1 text-primary"></i> Téléphone</label>
                        {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.phone) }}
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label"><i class="bi bi-geo-alt me-1 text-primary"></i> Adresse</label>
                    {{ form_widget(form.address, {'attr': {'class': 'form-control', 'rows': 2}}) }}
                    {{ form_errors(form.address) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-check-lg me-1"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_client_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i> Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

