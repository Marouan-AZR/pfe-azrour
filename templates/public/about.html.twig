    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --blue:#2563eb; --blue-light:#3b82f6; --blue-dark:#1d4ed8;
            --text:#111827; --muted:#6b7280; --border:#e5e7eb;
            --bg:#f9fafb; --white:#ffffff;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        html { scroll-behavior:smooth; }
        body { font-family:'Inter',sans-serif; color:var(--text); background:var(--white); }

        /* ── NAV ── */
        nav.main-nav {
            position:fixed; top:0; left:0; right:0; z-index:999;
            padding:0 2rem; height:68px; display:flex; align-items:center;
            background:rgba(255,255,255,.92); backdrop-filter:blur(16px);
            border-bottom:1px solid var(--border); transition:box-shadow .3s;
        }
        nav.main-nav.scrolled { box-shadow:0 4px 24px rgba(0,0,0,.08); }
        .nav-inner { max-width:1200px; width:100%; margin:0 auto; display:flex; align-items:center; justify-content:space-between; }
        .nav-brand { display:flex; align-items:center; gap:.6rem; text-decoration:none; }
        .nav-brand img { height:52px; width:auto; object-fit:contain; }
        .nav-brand span { font-weight:800; font-size:1.2rem; color:var(--text); letter-spacing:-.02em; }
        .nav-menu { display:flex; align-items:center; gap:1.75rem; }
        .nav-link { color:var(--muted); text-decoration:none; font-size:.88rem; font-weight:500; transition:color .2s; }
        .nav-link:hover, .nav-link.active { color:var(--text); }
        .nav-link.active { font-weight:700; color:var(--blue); }
        .nav-cta { display:flex; gap:.6rem; }
        .btn-ghost { padding:.45rem 1.1rem; border-radius:8px; font-size:.85rem; font-weight:600; border:1.5px solid var(--border); color:var(--text); text-decoration:none; transition:all .2s; }
        .btn-ghost:hover { border-color:var(--blue); color:var(--blue); }
        .btn-solid { padding:.45rem 1.1rem; border-radius:8px; font-size:.85rem; font-weight:600; background:var(--blue); color:#fff; text-decoration:none; transition:background .2s; }
        .btn-solid:hover { background:var(--blue-dark); color:#fff; }

        /* ── PAGE HEADER ── */
        .page-header {
            padding:130px 2rem 80px;
            background:linear-gradient(180deg, #eff6ff 0%, var(--white) 70%);
            position:relative; overflow:hidden;
        }
        .page-header::before {
            content:''; position:absolute; top:-100px; left:-100px;
            width:500px; height:500px; border-radius:50%;
            background:radial-gradient(circle, rgba(59,130,246,.1) 0%, transparent 70%);
        }
        .ph-inner { max-width:1200px; margin:0 auto; position:relative; }
        .breadcrumb-pub { display:flex; align-items:center; gap:.4rem; font-size:.8rem; color:var(--muted); margin-bottom:1.25rem; }
        .breadcrumb-pub a { color:var(--muted); text-decoration:none; transition:color .2s; }
        .breadcrumb-pub a:hover { color:var(--blue); }
        .breadcrumb-pub i { font-size:.6rem; }
        .ph-eyebrow {
            display:inline-flex; align-items:center; gap:.4rem;
            background:#eff6ff; border:1px solid #bfdbfe; border-radius:50px;
            padding:.3rem .9rem; font-size:.77rem; font-weight:700; color:var(--blue);
            margin-bottom:1.25rem; text-transform:uppercase; letter-spacing:.07em;
        }
        .ph-title { font-size:3.2rem; font-weight:900; line-height:1.08; letter-spacing:-.04em; margin-bottom:1rem; }
        .ph-title span { color:var(--blue); }
        .ph-desc { font-size:1.05rem; color:var(--muted); max-width:580px; line-height:1.75; }

        /* ── SECTIONS ── */
        section.content-section { padding:80px 2rem; }
        section.content-section.bg-alt { background:var(--bg); }
        .section-inner { max-width:1200px; margin:0 auto; }
        .section-label { display:inline-flex; align-items:center; gap:.35rem; font-size:.76rem; font-weight:700; color:var(--blue); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.6rem; }
        .section-title { font-size:2.2rem; font-weight:800; letter-spacing:-.03em; line-height:1.15; margin-bottom:.75rem; }
        .section-desc { font-size:.95rem; color:var(--muted); line-height:1.75; }

        /* ── KPI ROW ── */
        .kpi-row { display:grid; grid-template-columns:repeat(5,1fr); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:16px; overflow:hidden; margin-top:2.5rem; }
        .kpi-cell { background:var(--white); padding:1.75rem 1.25rem; text-align:center; }
        .kpi-num { font-size:1.85rem; font-weight:900; color:var(--blue); letter-spacing:-.03em; line-height:1; }
        .kpi-lbl { font-size:.72rem; color:var(--muted); margin-top:.35rem; text-transform:uppercase; letter-spacing:.05em; }

        /* ── SPECS GRID ── */
        .specs-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-top:2rem; }
        .spec-card {
            padding:1.5rem; border:1px solid var(--border); border-radius:14px; background:var(--white);
            display:flex; flex-direction:column; gap:.6rem; transition:all .2s;
        }
        .spec-card:hover { border-color:#bfdbfe; box-shadow:0 4px 20px rgba(37,99,235,.07); }
        .spec-icon { width:40px; height:40px; background:#eff6ff; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; color:var(--blue); }
        .spec-val { font-size:1.15rem; font-weight:800; color:var(--text); }
        .spec-lbl { font-size:.76rem; color:var(--muted); }

        /* ── TWO COL ── */
        .two-col { display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center; }
        .two-col.rev { direction:rtl; }
        .two-col.rev > * { direction:ltr; }
        .col-img { border-radius:18px; overflow:hidden; box-shadow:0 12px 48px rgba(0,0,0,.12); }
        .col-img img { width:100%; height:360px; object-fit:cover; display:block; }

        /* ── CHAIN ── */
        .chain-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-top:2rem; position:relative; }
        .chain-grid::before {
            content:''; position:absolute; top:32px; left:calc(16% + 32px); right:calc(16% + 32px);
            height:2px; background:linear-gradient(90deg, var(--blue), #93c5fd);
        }
        .chain-card {
            padding:1.75rem; border:1px solid var(--border); border-radius:14px;
            background:var(--white); text-align:center;
        }
        .chain-num {
            width:64px; height:64px; border-radius:50%; background:var(--blue); color:#fff;
            display:flex; align-items:center; justify-content:center;
            font-size:1.3rem; font-weight:800; margin:0 auto 1.25rem;
            box-shadow:0 4px 16px rgba(37,99,235,.35); position:relative; z-index:1;
        }
        .chain-title { font-weight:700; font-size:1rem; margin-bottom:.6rem; }
        .chain-list { list-style:none; text-align:left; }
        .chain-list li { font-size:.82rem; color:var(--muted); padding:.3rem 0; border-top:1px solid var(--border); display:flex; align-items:center; gap:.4rem; }
        .chain-list li:first-child { border:none; }
        .chain-list li i { color:var(--blue); font-size:.65rem; }

        /* ── SHAREHOLDERS ── */
        .sh-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-top:2rem; }
        .sh-card {
            padding:2.5rem; border:1px solid var(--border); border-radius:16px;
            background:var(--white); text-align:center; transition:all .2s;
        }
        .sh-card:hover { border-color:#bfdbfe; box-shadow:0 6px 24px rgba(37,99,235,.08); }
        .sh-pct { font-size:3.5rem; font-weight:900; color:var(--blue); line-height:1; margin-bottom:.6rem; }
        .sh-name { font-weight:700; font-size:.95rem; color:var(--text); }
        .sh-sub { font-size:.78rem; color:var(--muted); margin-top:.25rem; }

        /* ── INVESTMENT TABLE ── */
        .inv-row { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-top:2rem; }
        .inv-card {
            padding:1.5rem; border:1px solid var(--border); border-radius:14px;
            background:var(--white); text-align:center;
        }
        .inv-icon { font-size:1.8rem; margin-bottom:.5rem; }
        .inv-val { font-size:1.35rem; font-weight:800; color:var(--text); }
        .inv-lbl { font-size:.76rem; color:var(--muted); margin-top:.25rem; }

        /* ── PV ── */
        .pv-block { background:linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border:1px solid #d1fae5; border-radius:18px; padding:2.5rem; margin-top:2rem; }
        .pv-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-top:1.75rem; }
        .pv-cell { text-align:center; }
        .pv-num { font-size:1.5rem; font-weight:800; color:#059669; }
        .pv-lbl { font-size:.74rem; color:#6b7280; margin-top:.2rem; }
        .pv-specs { display:grid; grid-template-columns:1fr 1fr; gap:.5rem; margin-top:1.5rem; }
        .pv-spec { display:flex; justify-content:space-between; padding:.6rem .8rem; background:rgba(16,185,129,.08); border-radius:8px; }
        .pv-spec-k { font-size:.8rem; color:var(--muted); }
        .pv-spec-v { font-size:.8rem; font-weight:700; color:var(--text); }

        /* ── FEATURE LIST ── */
        .feature-list { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; margin-top:1.5rem; }
        .feature-item { display:flex; align-items:flex-start; gap:.75rem; padding:.85rem; background:var(--bg); border-radius:10px; border:1px solid var(--border); }
        .fi-icon { width:34px; height:34px; background:#eff6ff; border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--blue); font-size:.9rem; flex-shrink:0; }
        .fi-title { font-weight:600; font-size:.85rem; }
        .fi-desc { font-size:.78rem; color:var(--muted); margin-top:.15rem; line-height:1.5; }

        /* ── CTA ── */
        .cta-section {
            background:linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #0ea5e9 100%);
            text-align:center; padding:96px 2rem;
        }
        .cta-pre { display:inline-block; font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.6); margin-bottom:.85rem; }
        .cta-title { font-size:2.6rem; font-weight:900; color:#fff; letter-spacing:-.04em; margin-bottom:1rem; line-height:1.12; }
        .cta-desc { color:rgba(255,255,255,.72); font-size:1rem; margin-bottom:2.25rem; }
        .btn-cta-white { display:inline-flex; align-items:center; gap:.5rem; padding:.9rem 2.3rem; background:#fff; color:var(--blue); border-radius:10px; font-weight:700; font-size:.9rem; text-decoration:none; box-shadow:0 4px 20px rgba(0,0,0,.18); transition:all .25s; }
        .btn-cta-white:hover { transform:translateY(-2px); box-shadow:0 10px 32px rgba(0,0,0,.25); color:var(--blue-dark); }
        .btn-cta-outline { display:inline-flex; align-items:center; gap:.5rem; padding:.9rem 2.3rem; background:transparent; color:#fff; border:2px solid rgba(255,255,255,.32); border-radius:10px; font-weight:600; font-size:.9rem; text-decoration:none; transition:all .25s; }
        .btn-cta-outline:hover { border-color:rgba(255,255,255,.8); background:rgba(255,255,255,.08); color:#fff; }

        /* ── FOOTER ── */
        footer { background:#111827; padding:3rem 2rem 2rem; }
        .footer-inner { max-width:1200px; margin:0 auto; }
        .footer-top { display:flex; justify-content:space-between; align-items:flex-start; padding-bottom:2rem; border-bottom:1px solid #1f2937; gap:3rem; flex-wrap:wrap; }
        .footer-brand img { height:52px; width:auto; object-fit:contain; margin-bottom:.6rem; display:block; }
        .footer-brand p { font-size:.8rem; color:#6b7280; max-width:250px; line-height:1.65; }
        .footer-links { display:flex; gap:3rem; }
        .fl-group h6 { font-size:.74rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#9ca3af; margin-bottom:.8rem; }
        .fl-group a { display:block; font-size:.81rem; color:#6b7280; text-decoration:none; margin-bottom:.4rem; transition:color .2s; }
        .fl-group a:hover { color:#d1d5db; }
        .footer-bottom { padding-top:1.5rem; display:flex; justify-content:space-between; font-size:.76rem; color:#4b5563; flex-wrap:wrap; gap:.5rem; }

        @media(max-width:1024px) { .two-col { grid-template-columns:1fr; } .two-col.rev { direction:ltr; } .col-img { order:-1; } }
        @media(max-width:768px) {
            .nav-menu { display:none; }
            .ph-title { font-size:2.1rem; }
            .kpi-row { grid-template-columns:repeat(2,1fr); }
            .specs-grid, .inv-row, .pv-grid { grid-template-columns:repeat(2,1fr); }
            .sh-grid, .chain-grid, .feature-list, .pv-specs { grid-template-columns:1fr; }
            .chain-grid::before { display:none; }
            section.content-section { padding:60px 1.25rem; }
        }
    </style>
</head>
