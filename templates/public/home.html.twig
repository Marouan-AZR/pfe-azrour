    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --blue:#2563eb; --blue-light:#3b82f6; --blue-dark:#1d4ed8;
            --text:#111827; --muted:#6b7280; --border:#e5e7eb;
            --bg:#f9fafb; --white:#ffffff;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        html { scroll-behavior:smooth; }
        body { font-family:'Inter',sans-serif; color:var(--text); background:var(--white); }

        /* ── NAV ── */
        nav.main-nav {
            position:fixed; top:0; left:0; right:0; z-index:999;
            padding:0 2rem; height:68px; display:flex; align-items:center;
            background:rgba(255,255,255,.92); backdrop-filter:blur(16px);
            border-bottom:1px solid var(--border);
            transition:box-shadow .3s;
        }
        nav.main-nav.scrolled { box-shadow:0 4px 24px rgba(0,0,0,.08); }
        .nav-inner { max-width:1200px; width:100%; margin:0 auto; display:flex; align-items:center; justify-content:space-between; }
        .nav-brand { display:flex; align-items:center; gap:.6rem; text-decoration:none; }
        .nav-brand img { height:52px; width:auto; object-fit:contain; }
        .nav-brand span { font-weight:800; font-size:1.2rem; color:var(--text); letter-spacing:-.02em; }
        .nav-menu { display:flex; align-items:center; gap:1.75rem; }
        .nav-link { color:var(--muted); text-decoration:none; font-size:.88rem; font-weight:500; transition:color .2s; }
        .nav-link:hover { color:var(--text); }
        .nav-cta { display:flex; gap:.6rem; }
        .btn-ghost { padding:.45rem 1.1rem; border-radius:8px; font-size:.85rem; font-weight:600; border:1.5px solid var(--border); color:var(--text); text-decoration:none; transition:all .2s; }
        .btn-ghost:hover { border-color:var(--blue); color:var(--blue); }
        .btn-solid { padding:.45rem 1.1rem; border-radius:8px; font-size:.85rem; font-weight:600; background:var(--blue); color:#fff; text-decoration:none; transition:background .2s; }
        .btn-solid:hover { background:var(--blue-dark); color:#fff; }

        /* ── HERO ── */
        .hero {
            min-height:100vh; display:flex; align-items:center;
            padding:100px 2rem 64px;
            background:linear-gradient(180deg, #eff6ff 0%, var(--white) 65%);
            position:relative; overflow:hidden;
        }
        .hero::before {
            content:''; position:absolute; top:-180px; right:-180px;
            width:650px; height:650px; border-radius:50%;
            background:radial-gradient(circle, rgba(59,130,246,.13) 0%, transparent 70%);
            pointer-events:none;
        }
        .hero-inner { max-width:1200px; margin:0 auto; width:100%; display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:center; }
        .hero-eyebrow {
            display:inline-flex; align-items:center; gap:.4rem;
            background:#eff6ff; border:1px solid #bfdbfe; border-radius:50px;
            padding:.3rem .9rem; font-size:.77rem; font-weight:700; color:var(--blue);
            margin-bottom:1.5rem; text-transform:uppercase; letter-spacing:.07em;
        }
        .hero-title { font-size:3.6rem; font-weight:900; line-height:1.06; letter-spacing:-.04em; color:var(--text); margin-bottom:1.25rem; }
        .hero-title .hi { color:var(--blue); }
        .hero-desc { font-size:1.05rem; color:var(--muted); line-height:1.78; margin-bottom:2rem; max-width:480px; }
        .hero-actions { display:flex; gap:.75rem; flex-wrap:wrap; margin-bottom:2.75rem; }
        .btn-hero-primary {
            display:inline-flex; align-items:center; gap:.5rem;
            padding:.9rem 2.1rem; background:var(--blue); color:#fff;
            border-radius:10px; font-weight:700; font-size:.93rem; text-decoration:none;
            box-shadow:0 4px 18px rgba(37,99,235,.38); transition:all .25s;
        }
        .btn-hero-primary:hover { background:var(--blue-dark); color:#fff; transform:translateY(-2px); box-shadow:0 8px 26px rgba(37,99,235,.42); }
        .btn-hero-secondary {
            display:inline-flex; align-items:center; gap:.5rem;
            padding:.9rem 1.75rem; color:var(--text); font-weight:600; font-size:.93rem;
            text-decoration:none; border:1.5px solid var(--border); border-radius:10px; transition:all .2s;
        }
        .btn-hero-secondary:hover { border-color:var(--blue); color:var(--blue); }
        .hero-stats { display:flex; gap:2rem; }
        .hs { border-left:3px solid var(--blue); padding-left:.85rem; }
        .hs-num { font-size:1.65rem; font-weight:800; color:var(--text); letter-spacing:-.03em; }
        .hs-lbl { font-size:.73rem; color:var(--muted); }

        /* hero image side */
        .hero-media { position:relative; }
        .hero-img-wrap {
            border-radius:22px; overflow:hidden;
            box-shadow:0 28px 72px rgba(0,0,0,.18);
        }
        .hero-img-wrap img { width:100%; height:480px; object-fit:cover; display:block; }
        .hero-badge {
            position:absolute; bottom:-20px; left:-20px;
            background:var(--white); border:1px solid var(--border); border-radius:14px;
            padding:1rem 1.25rem; box-shadow:0 8px 32px rgba(0,0,0,.1);
            display:flex; align-items:center; gap:.75rem;
        }
        .hb-icon { width:44px; height:44px; background:#ecfdf5; border-radius:10px; display:flex; align-items:center; justify-content:center; color:#10b981; font-size:1.3rem; flex-shrink:0; }
        .hb-val { font-size:1.2rem; font-weight:800; color:var(--text); }
        .hb-lbl { font-size:.7rem; color:var(--muted); }
        .hero-badge2 {
            position:absolute; top:-16px; right:-16px;
            background:var(--blue); border-radius:12px;
            padding:.85rem 1.1rem; box-shadow:0 8px 24px rgba(37,99,235,.42);
            text-align:center;
        }
        .hb2-val { font-size:1.5rem; font-weight:900; color:#fff; line-height:1; }
        .hb2-lbl { font-size:.68rem; color:rgba(255,255,255,.8); margin-top:.2rem; }

        /* ── STRIP ── */
        .strip {
            background:var(--bg); border-top:1px solid var(--border); border-bottom:1px solid var(--border);
            padding:1.4rem 2rem;
        }
        .strip-inner { max-width:1200px; margin:0 auto; display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap; }
        .strip-lbl { font-size:.76rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; white-space:nowrap; }
        .strip-divider { width:1px; height:22px; background:var(--border); }
        .strip-tags { display:flex; flex-wrap:wrap; gap:.55rem; }
        .strip-tag { background:var(--white); border:1px solid var(--border); border-radius:50px; padding:.28rem .82rem; font-size:.79rem; font-weight:600; color:var(--muted); }

        /* ── STATS BAR ── */
        .stats-bar { background:var(--text); padding:64px 2rem; }
        .stats-grid-4 { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); }
        .stat-cell {
            padding:2rem; text-align:center;
            border-right:1px solid #1f2937;
        }
        .stat-cell:last-child { border-right:none; }
        .stat-num { font-size:2.75rem; font-weight:900; color:#fff; letter-spacing:-.04em; line-height:1.1; }
        .stat-num span { color:#60a5fa; }
        .stat-lbl { font-size:.78rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.06em; margin-top:.35rem; }

        /* ── SECTIONS ── */
        section { padding:96px 2rem; }
        .section-inner { max-width:1200px; margin:0 auto; }
        .section-label { display:inline-flex; align-items:center; gap:.35rem; font-size:.77rem; font-weight:700; color:var(--blue); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.6rem; }
        .section-title { font-size:2.4rem; font-weight:800; letter-spacing:-.03em; line-height:1.15; margin-bottom:.75rem; }
        .section-desc { font-size:.97rem; color:var(--muted); max-width:540px; line-height:1.75; }

        /* ── SERVICES ── */
        .services-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-top:3rem; }
        .service-card {
            padding:1.75rem; border:1px solid var(--border); border-radius:16px;
            background:var(--white); transition:all .25s;
        }
        .service-card:hover { border-color:#bfdbfe; box-shadow:0 8px 32px rgba(37,99,235,.07); transform:translateY(-4px); }
        .sc-icon { width:46px; height:46px; background:#eff6ff; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.3rem; color:var(--blue); margin-bottom:1.1rem; }
        .sc-title { font-size:.95rem; font-weight:700; margin-bottom:.4rem; }
        .sc-desc { font-size:.83rem; color:var(--muted); line-height:1.65; }

        /* ── HOW IT WORKS ── */
        .how-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; margin-top:3rem; position:relative; }
        .how-grid::before {
            content:''; position:absolute; top:27px; left:calc(16% + 28px); right:calc(16% + 28px);
            height:2px; background:linear-gradient(90deg, var(--blue), #a5b4fc);
        }
        .how-card { text-align:center; }
        .how-num {
            width:56px; height:56px; border-radius:50%; background:var(--blue); color:#fff;
            display:flex; align-items:center; justify-content:center;
            font-size:1.25rem; font-weight:800; margin:0 auto 1.25rem;
            box-shadow:0 4px 16px rgba(37,99,235,.35); position:relative; z-index:1;
        }
        .how-title { font-weight:700; margin-bottom:.4rem; font-size:.97rem; }
        .how-desc { font-size:.83rem; color:var(--muted); line-height:1.65; }
        .how-points { list-style:none; margin-top:.75rem; text-align:left; }
        .how-points li { font-size:.79rem; color:var(--muted); padding:.28rem 0; border-top:1px solid var(--border); display:flex; align-items:center; gap:.4rem; }
        .how-points li i { color:var(--blue); font-size:.7rem; }

        /* ── GALLERY ── */
        .gallery-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:2.5rem; }
        .gallery-item { border-radius:14px; overflow:hidden; border:1px solid var(--border); box-shadow:0 4px 20px rgba(0,0,0,.05); }
        .gallery-item img { width:100%; height:200px; object-fit:cover; display:block; transition:transform .4s; }
        .gallery-item:hover img { transform:scale(1.04); }

        /* ── CTA ── */
        .cta-section {
            background:linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #0ea5e9 100%);
            text-align:center; padding:100px 2rem;
        }
        .cta-pre { display:inline-block; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.65); margin-bottom:1rem; }
        .cta-title { font-size:2.8rem; font-weight:900; color:#fff; letter-spacing:-.04em; margin-bottom:1rem; line-height:1.1; }
        .cta-desc { color:rgba(255,255,255,.72); font-size:1rem; margin-bottom:2.5rem; }
        .btn-cta-white { display:inline-flex; align-items:center; gap:.5rem; padding:.95rem 2.4rem; background:#fff; color:var(--blue); border-radius:10px; font-weight:700; font-size:.93rem; text-decoration:none; box-shadow:0 4px 20px rgba(0,0,0,.18); transition:all .25s; }
        .btn-cta-white:hover { transform:translateY(-2px); box-shadow:0 10px 32px rgba(0,0,0,.25); color:var(--blue-dark); }
        .btn-cta-outline { display:inline-flex; align-items:center; gap:.5rem; padding:.95rem 2.4rem; background:transparent; color:#fff; border:2px solid rgba(255,255,255,.32); border-radius:10px; font-weight:600; font-size:.93rem; text-decoration:none; transition:all .25s; }
        .btn-cta-outline:hover { border-color:rgba(255,255,255,.8); background:rgba(255,255,255,.08); color:#fff; }

        /* ── FOOTER ── */
        footer { background:#111827; padding:3.5rem 2rem 2rem; }
        .footer-inner { max-width:1200px; margin:0 auto; }
        .footer-top { display:flex; justify-content:space-between; align-items:flex-start; padding-bottom:2rem; border-bottom:1px solid #1f2937; gap:3rem; flex-wrap:wrap; }
        .footer-brand img { height:52px; width:auto; object-fit:contain; margin-bottom:.6rem; display:block; }
        .footer-brand p { font-size:.8rem; color:#6b7280; max-width:250px; line-height:1.65; margin-top:.4rem; }
        .footer-links { display:flex; gap:3rem; }
        .fl-group h6 { font-size:.74rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#9ca3af; margin-bottom:.8rem; }
        .fl-group a { display:block; font-size:.81rem; color:#6b7280; text-decoration:none; margin-bottom:.4rem; transition:color .2s; }
        .fl-group a:hover { color:#d1d5db; }
        .footer-bottom { padding-top:1.5rem; display:flex; justify-content:space-between; align-items:center; font-size:.76rem; color:#4b5563; flex-wrap:wrap; gap:.5rem; }

        @media(max-width:1024px) { .hero-inner { grid-template-columns:1fr; } .hero-media { display:none; } }
        @media(max-width:768px) {
            .nav-menu { display:none; }
            .hero-title { font-size:2.3rem; }
            .stats-grid-4 { grid-template-columns:repeat(2,1fr); }
            .stat-cell { border-right:none; border-bottom:1px solid #1f2937; }
            .services-grid, .how-grid, .gallery-grid { grid-template-columns:1fr; }
            .how-grid::before { display:none; }
            section { padding:64px 1.25rem; }
        }
    </style>
</head>
