{% extends 'base.html.twig' %}

{% block title %}État du Stock{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-box-seam me-2"></i>État du Stock</h2>
            <small class="text-muted">Suivi en temps réel des marchandises stockées</small>
        </div>
        <a href="{{ path('app_stock_export_csv', app.request.query.all) }}" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download"></i> Exporter CSV
        </a>
    </div>

    {# ===== Filtres avancés ===== #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                {% if clients|length > 0 %}
                <div class="col-md-2">
                    <label class="form-label">Client</label>
                    <select name="client" class="form-select">
                        <option value="">Tous les clients</option>
                        {% for client in clients %}
                            <option value="{{ client.id }}" {{ filters.client == client.id ? 'selected' }}>{{ client.companyName }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="col-md-2">
                    <label class="form-label">Espèce</label>
                    <select name="espece" class="form-select">
                        <option value="">Toutes</option>
                        {% for e in distinctValues.especes %}
                            <option value="{{ e }}" {{ filters.espece == e ? 'selected' }}>{{ e }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Qualité</label>
                    <select name="qualite" class="form-select">
                        <option value="">Toutes</option>
                        {% for q in distinctValues.qualites %}
                            <option value="{{ q }}" {{ filters.qualite == q ? 'selected' }}>{{ q }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Moule</label>
                    <select name="moule" class="form-select">
                        <option value="">Tous</option>
                        {% for m in distinctValues.moules %}
                            <option value="{{ m }}" {{ filters.moule == m ? 'selected' }}>{{ m }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Famille</label>
                    <select name="famille" class="form-select">
                        <option value="">Toutes</option>
                        {% for f in distinctValues.familles %}
                            <option value="{{ f }}" {{ filters.famille == f ? 'selected' }}>{{ f }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Chambre</label>
                    <select name="cold_room" class="form-select">
                        <option value="">Toutes</option>
                        {% for room in coldRooms %}
                            <option value="{{ room.id }}" {{ filters.coldRoom == room.id ? 'selected' }}>{{ room.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Rayon</label>
                    <select name="rayon" class="form-select">
                        <option value="">Tous</option>
                        {% for r in distinctValues.rayons %}
                            <option value="{{ r }}" {{ filters.rayon == r ? 'selected' }}>{{ r }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Filtrer</button>
                </div>
                <div class="col-md-2">
                    <a href="{{ path('app_stock_index') }}" class="btn btn-outline-secondary w-100"><i class="bi bi-x-lg"></i> Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    {# ===== Tableau Palettes ===== #}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-table me-2"></i>Stock détaillé ({{ palettes|length }} palettes)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Espèce</th>
                            <th>Qualité</th>
                            <th>Moule</th>
                            <th>Famille</th>
                            <th class="text-center">Cartons Entrés</th>
                            <th class="text-center">Cartons Sortis</th>
                            <th class="text-center">Cartons Restants</th>
                            <th class="text-end">Entrée (kg)</th>
                            <th class="text-end">Sortie (kg)</th>
                            <th class="text-end">Stock Final (kg)</th>
                            <th>Chambre</th>
                            <th>Rayon</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set totCartonsE = 0 %}
                        {% set totCartonsS = 0 %}
                        {% set totCartonsR = 0 %}
                        {% set totPoidsE = 0 %}
                        {% set totPoidsS = 0 %}
                        {% set totPoidsR = 0 %}
                        {% for p in palettes %}
                            {% set cartonsSortis = p.nombreCartons - p.cartonsRestants %}
                            {% set poidsEntree = p.poidsTotal %}
                            {% set poidsRestant = p.poidsRestant %}
                            {% set poidsSortie = poidsEntree - poidsRestant %}
                            {% set totCartonsE = totCartonsE + p.nombreCartons %}
                            {% set totCartonsS = totCartonsS + cartonsSortis %}
                            {% set totCartonsR = totCartonsR + p.cartonsRestants %}
                            {% set totPoidsE = totPoidsE + poidsEntree %}
                            {% set totPoidsS = totPoidsS + poidsSortie %}
                            {% set totPoidsR = totPoidsR + poidsRestant %}
                        <tr>
                            <td>{{ p.operation.client.companyName }}</td>
                            <td>{{ p.espece }}</td>
                            <td>{{ p.qualite ?? '—' }}</td>
                            <td>{{ p.moule ?? '—' }}</td>
                            <td>{{ p.famille ?? '—' }}</td>
                            <td class="text-center">{{ p.nombreCartons }}</td>
                            <td class="text-center text-danger">{{ cartonsSortis > 0 ? cartonsSortis : '—' }}</td>
                            <td class="text-center fw-bold text-success">{{ p.cartonsRestants }}</td>
                            <td class="text-end">{{ (poidsEntree * 1000)|number_format(0, ',', ' ') }}</td>
                            <td class="text-end text-danger">{{ (poidsSortie * 1000)|number_format(0, ',', ' ') }}</td>
                            <td class="text-end fw-bold">{{ (poidsRestant * 1000)|number_format(0, ',', ' ') }}</td>
                            <td><span class="badge bg-info bg-opacity-25 text-info">{{ p.coldRoom ? p.coldRoom.name : '—' }}</span></td>
                            <td>{{ p.rayon ?? '—' }}</td>
                            <td class="text-center">
                                {% if p.cartonsRestants <= 0 %}
                                    <span class="badge bg-danger">🔴 Épuisé</span>
                                {% else %}
                                    <span class="badge bg-success">🟢 Actif</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <a href="{{ path('app_stock_palette_details', {id: p.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Voir Détails
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="15" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox" style="font-size:3rem"></i>
                                <p class="mt-2">Aucune palette en stock</p>
                            </td>
                        </tr>
                        {% endfor %}
                        {% if palettes|length > 0 %}
                        <tr style="background:#e2e8f0;font-weight:700">
                            <td>TOTAL</td>
                            <td colspan="4"></td>
                            <td class="text-center">{{ totCartonsE }}</td>
                            <td class="text-center text-danger">{{ totCartonsS }}</td>
                            <td class="text-center text-success">{{ totCartonsR }}</td>
                            <td class="text-end">{{ (totPoidsE * 1000)|number_format(0, ',', ' ') }}</td>
                            <td class="text-end text-danger">{{ (totPoidsS * 1000)|number_format(0, ',', ' ') }}</td>
                            <td class="text-end">{{ (totPoidsR * 1000)|number_format(0, ',', ' ') }}</td>
                            <td colspan="4"></td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
