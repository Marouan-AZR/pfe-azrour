{% extends 'base.html.twig' %}

{% block title %}État du Stock{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-box-seam me-2"></i>État du Stock</h2>
            <small class="text-muted">Suivi en temps réel des marchandises stockées</small>
        </div>
        <a href="{{ path('app_stock_export_csv', app.request.query.all) }}" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download"></i> Exporter CSV
        </a>
    </div>

    {# ===== Filtres avancés ===== #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                {% if clients|length > 0 %}
                <div class="col-md-2">
                    <label class="form-label">Client</label>
                    <select name="client" class="form-select">
                        <option value="">Tous les clients</option>
                        {% for client in clients %}
                            <option value="{{ client.id }}" {{ filters.client == client.id ? 'selected' }}>{{ client.companyName }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="col-md-2">
                    <label class="form-label">Espèce</label>
                    <select name="espece" class="form-select">
                        <option value="">Toutes</option>
                        {% for e in distinctValues.especes %}
                            <option value="{{ e }}" {{ filters.espece == e ? 'selected' }}>{{ e }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Qualité</label>
                    <select name="qualite" class="form-select">
                        <option value="">Toutes</option>
                        {% for q in distinctValues.qualites %}
                            <option value="{{ q }}" {{ filters.qualite == q ? 'selected' }}>{{ q }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Moule</label>
                    <select name="moule" class="form-select">
                        <option value="">Tous</option>
                        {% for m in distinctValues.moules %}
                            <option value="{{ m }}" {{ filters.moule == m ? 'selected' }}>{{ m }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Famille</label>
                    <select name="famille" class="form-select">
                        <option value="">Toutes</option>
                        {% for f in distinctValues.familles %}
                            <option value="{{ f }}" {{ filters.famille == f ? 'selected' }}>{{ f }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Chambre</label>
                    <select name="cold_room" class="form-select">
                        <option value="">Toutes</option>
                        {% for room in coldRooms %}
                            <option value="{{ room.id }}" {{ filters.coldRoom == room.id ? 'selected' }}>{{ room.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Rayon</label>
                    <select name="rayon" class="form-select">
                        <option value="">Tous</option>
                        {% for r in distinctValues.rayons %}
                            <option value="{{ r }}" {{ filters.rayon == r ? 'selected' }}>{{ r }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date début</label>
                    <input type="date" name="dateFrom" class="form-control" value="{{ filters.dateFrom }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date fin</label>
                    <input type="date" name="dateTo" class="form-control" value="{{ filters.dateTo }}">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Filtrer</button>
                </div>
                <div class="col-md-2">
                    <a href="{{ path('app_stock_index') }}" class="btn btn-outline-secondary w-100"><i class="bi bi-x-lg"></i> Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    {# ===== Tableau Stock Groupé ===== #}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-table me-2"></i>Stock détaillé ({{ palettes|length }} palettes)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Espèce</th>
                            <th>Chambre</th>
                            <th>Rayon</th>
                            <th class="text-center">Nb Palettes</th>
                            <th class="text-center">Cartons Initiaux</th>
                            <th class="text-center">Cartons Restants</th>
                            <th class="text-end">Poids Restant (kg)</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# Group palettes by client+espece+coldRoom+rayon #}
                        {% set groups = {} %}
                        {% for p in palettes %}
                            {% set key = (p.operation.client.companyName ~ '||' ~ p.espece ~ '||' ~ (p.coldRoom ? p.coldRoom.name : '—') ~ '||' ~ (p.rayon ?? '—')) %}
                            {% if groups[key] is not defined %}
                                {% set groups = groups|merge({(key): {client: p.operation.client.companyName, espece: p.espece, coldRoom: (p.coldRoom ? p.coldRoom.name : '—'), rayon: (p.rayon ?? '—'), palettes: [p], nbPalettes: 1, cartonsInitiaux: p.nombreCartons, cartonsRestants: p.cartonsRestants, poidsRestant: p.poidsRestant}}) %}
                            {% else %}
                                {% set g = groups[key] %}
                                {% set groups = groups|merge({(key): {client: g.client, espece: g.espece, coldRoom: g.coldRoom, rayon: g.rayon, palettes: g.palettes|merge([p]), nbPalettes: g.nbPalettes + 1, cartonsInitiaux: g.cartonsInitiaux + p.nombreCartons, cartonsRestants: g.cartonsRestants + p.cartonsRestants, poidsRestant: g.poidsRestant + p.poidsRestant}}) %}
                            {% endif %}
                        {% endfor %}

                        {% set totalPalettes = 0 %}
                        {% set totalCartonsInitiaux = 0 %}
                        {% set totalCartonsRestants = 0 %}
                        {% set totalPoidsRestant = 0 %}

                        {% for key, g in groups %}
                            {% set totalPalettes = totalPalettes + g.nbPalettes %}
                            {% set totalCartonsInitiaux = totalCartonsInitiaux + g.cartonsInitiaux %}
                            {% set totalCartonsRestants = totalCartonsRestants + g.cartonsRestants %}
                            {% set totalPoidsRestant = totalPoidsRestant + g.poidsRestant %}

                            {# Color coding: green >50%, orange <20%, red = 0 #}
                            {% if g.cartonsRestants <= 0 %}
                                {% set statusClass = 'bg-danger' %}
                                {% set statusLabel = '🔴 Épuisé' %}
                                {% set rowClass = 'table-danger' %}
                            {% elseif g.cartonsRestants < (g.cartonsInitiaux * 0.2) %}
                                {% set statusClass = 'bg-warning text-dark' %}
                                {% set statusLabel = '🟠 Faible' %}
                                {% set rowClass = 'table-warning' %}
                            {% else %}
                                {% set statusClass = 'bg-success' %}
                                {% set statusLabel = '🟢 Disponible' %}
                                {% set rowClass = '' %}
                            {% endif %}

                            <tr class="{{ rowClass }}">
                                <td>{{ g.client }}</td>
                                <td>{{ g.espece }}</td>
                                <td><span class="badge bg-info bg-opacity-25 text-info">{{ g.coldRoom }}</span></td>
                                <td>{{ g.rayon }}</td>
                                <td class="text-center">{{ g.nbPalettes }}</td>
                                <td class="text-center">{{ g.cartonsInitiaux }}</td>
                                <td class="text-center fw-bold">{{ g.cartonsRestants }}</td>
                                <td class="text-end fw-bold">{{ (g.poidsRestant * 1000)|number_format(0, ',', ' ') }}</td>
                                <td class="text-center"><span class="badge {{ statusClass }}">{{ statusLabel }}</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#group-{{ loop.index }}">
                                        <i class="bi bi-eye"></i> Voir Détails
                                    </button>
                                </td>
                            </tr>
                            <tr class="collapse" id="group-{{ loop.index }}">
                                <td colspan="10" class="p-0">
                                    <table class="table table-sm table-bordered mb-0 bg-light">
                                        <thead>
                                            <tr class="table-secondary">
                                                <th>Palette</th>
                                                <th>Qualité</th>
                                                <th>Moule</th>
                                                <th>Famille</th>
                                                <th class="text-center">Cartons Init.</th>
                                                <th class="text-center">Cartons Rest.</th>
                                                <th class="text-end">Poids Rest. (kg)</th>
                                                <th class="text-center">Détails</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for p in g.palettes %}
                                            <tr>
                                                <td>#{{ p.id }}</td>
                                                <td>{{ p.qualite ?? '—' }}</td>
                                                <td>{{ p.moule ?? '—' }}</td>
                                                <td>{{ p.famille ?? '—' }}</td>
                                                <td class="text-center">{{ p.nombreCartons }}</td>
                                                <td class="text-center">{{ p.cartonsRestants }}</td>
                                                <td class="text-end">{{ (p.poidsRestant * 1000)|number_format(0, ',', ' ') }}</td>
                                                <td class="text-center">
                                                    <a href="{{ path('app_stock_palette_details', {id: p.id}) }}" class="btn btn-xs btn-outline-secondary">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox" style="font-size:3rem"></i>
                                    <p class="mt-2">Aucune palette en stock</p>
                                </td>
                            </tr>
                        {% endfor %}

                        {% if palettes|length > 0 %}
                        <tr style="background:#1e293b;color:#fff;font-weight:700">
                            <td colspan="4">TOTAL</td>
                            <td class="text-center">{{ totalPalettes }}</td>
                            <td class="text-center">{{ totalCartonsInitiaux }}</td>
                            <td class="text-center">{{ totalCartonsRestants }}</td>
                            <td class="text-end">{{ (totalPoidsRestant * 1000)|number_format(0, ',', ' ') }}</td>
                            <td colspan="2"></td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
