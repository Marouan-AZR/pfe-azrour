{% extends 'base.html.twig' %}

{% block title %}État du Stock{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-box-seam me-2"></i>État du Stock</h2>
            <small class="text-muted">Suivi en temps réel des marchandises stockées</small>
        </div>
        <a href="{{ path('app_stock_export_csv', app.request.query.all) }}" class="btn btn-outline-success btn-sm">
            <i class="bi bi-download"></i> Exporter CSV
        </a>
    </div>

    {# ===== Filtres ===== #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                {% if clients|length > 0 %}
                <div class="col-md-3">
                    <label class="form-label">Client</label>
                    <select name="client" class="form-select">
                        <option value="">Tous les clients</option>
                        {% for client in clients %}
                            <option value="{{ client.id }}" {{ filters.client == client.id ? 'selected' }}>{{ client.companyName }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="col-md-3">
                    <label class="form-label">Chambre</label>
                    <select name="cold_room" class="form-select">
                        <option value="">Toutes les chambres</option>
                        {% for room in coldRooms %}
                            <option value="{{ room.id }}" {{ filters.coldRoom == room.id ? 'selected' }}>{{ room.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    {# ===== Tableau Palettes ===== #}
    <div class="card">
        <div class="card-header">
            <i class="bi bi-table me-2"></i>Stock détaillé ({{ palettes|length }} palettes)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Espèce</th>
                            <th>Qualité</th>
                            <th>Moule</th>
                            <th>Famille</th>
                            <th class="text-center">Cartons Entrés</th>
                            <th class="text-center">Cartons Sortis</th>
                            <th class="text-center">Cartons Restants</th>
                            <th class="text-end">Entrée (kg)</th>
                            <th class="text-end">Sortie (kg)</th>
                            <th class="text-end">Stock Final (kg)</th>
                            <th>Chambre</th>
                            <th>Rayon</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# =========================
                           Regroupement État du Stock
                           Clé : Espèce + Qualité + Moule/Taille + Type de conditionnement (famille)
                           Totaux : cartons (entrés) + poids total (entrés)
                           ========================= #}

                        {% if palettes|length > 0 %}
                            {% set grouped = {} %}
                            {% set totCartonsE = 0 %}
                            {% set totPoidsE = 0 %}

                            {% for p in palettes %}
                                {% set esp = p.espece|default('') %}
                                {% set qual = p.qualite ?? '—' %}
                                {% set moule = p.moule ?? '—' %}
                                {% set cond = p.famille ?? '—' %}

                                {% set key = esp ~ '||' ~ qual ~ '||' ~ moule ~ '||' ~ cond %}

                                {% set totCartonsE = totCartonsE + p.nombreCartons %}
                                {% set poidsEntree = (p.poidsTotal ?? 0) %}
                                {% set totPoidsE = totPoidsE + poidsEntree %}

                                {% if grouped[key] is not defined %}
                                    {% set grouped = grouped|merge({ (key): {
                                        'idGroup': key,
                                        'esp': esp,
                                        'qual': qual,
                                        'moule': moule,
                                        'cond': cond,
                                        'cartonsEntrés': p.nombreCartons,
                                        'poidsEntree': poidsEntree,
                                        'cartonsRestants': p.cartonsRestants ?? 0,
                                        'coldRoom': p.coldRoom ? p.coldRoom.name : '—',
                                        'rayon': p.rayon ?? '—',
                                    } }) %}
                                {% else %}
                                    {% set prev = grouped[key] %}
                                    {% set grouped = grouped|merge({ (key): {
                                        'idGroup': prev.idGroup,
                                        'esp': prev.esp,
                                        'qual': prev.qual,
                                        'moule': prev.moule,
                                        'cond': prev.cond,
                                        'cartonsEntrés': prev.cartonsEntrés + p.nombreCartons,
                                        'poidsEntree': prev.poidsEntree + poidsEntree,
                                        'cartonsRestants': prev.cartonsRestants + (p.cartonsRestants ?? 0),
                                        'coldRoom': prev.coldRoom,
                                        'rayon': prev.rayon
                                    } }) %}
                                {% endif %}
                            {% endfor %}

                            {% for item in grouped %}
                                {% set cartonsSortis = item.cartonsEntrés - item.cartonsRestants %}
                                {% set poidsRestant = 0 %}
                                {% set poidsEntree = item.poidsEntree %}
                                {% set poidsSortie = poidsEntree - poidsRestant %}

                                <tr>
                                    <td>{{ item.esp }}</td>
                                    <td>{{ item.qual }}</td>
                                    <td>{{ item.moule }}</td>
                                    <td>{{ item.cond }}</td>
                                    <td class="text-center">{{ item.cartonsEntrés }}</td>
                                    <td class="text-center text-danger">{{ cartonsSortis > 0 ? cartonsSortis : '—' }}</td>
                                    <td class="text-center fw-bold text-success">{{ item.cartonsRestants }}</td>
                                    <td class="text-end">{{ (poidsEntree * 1000)|number_format(0, ',', ' ') }}</td>
                                    <td class="text-end text-danger">{{ (poidsSortie * 1000)|number_format(0, ',', ' ') }}</td>
                                    <td class="text-end fw-bold">{{ (poidsRestant * 1000)|number_format(0, ',', ' ') }}</td>
                                    <td><span class="badge bg-info bg-opacity-25 text-info">{{ item.coldRoom }}</span></td>
                                    <td>{{ item.rayon }}</td>
                                    <td class="text-center">
                                        {% if item.cartonsRestants <= 0 %}
                                            <span class="badge bg-secondary">Épuisé</span>
                                        {% else %}
                                            <span class="badge bg-success">Actif</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {# Détail = liste des palettes du regroupement (via modal simple ici)
                                           (si tu as une page dédiée, on pourra ensuite rediriger vers cette page) #}
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#detailGroup{{ item.idGroup }}">
                                            <i class="bi bi-eye"></i> Détail
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}

                            <tr style="background:#e2e8f0;font-weight:700">
                                <td colspan="4">TOTAL</td>
                                <td class="text-center">{{ totCartonsE }}</td>
                                <td colspan="2"></td>
                                <td class="text-end">{{ (totPoidsE * 1000)|number_format(0, ',', ' ') }}</td>
                                <td colspan="6"></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="14" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox" style="font-size:3rem"></i>
                                    <p class="mt-2">Aucune palette en stock</p>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# ===== Modals ===== #}
{% for p in palettes %}
<div class="modal fade" id="detailPalette{{ p.id }}" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Palette {{ p.codePalette }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-5">Espèce</dt><dd class="col-7">{{ p.espece }}</dd>
                    <dt class="col-5">Qualité</dt><dd class="col-7">{{ p.qualite ?? '—' }}</dd>
                    <dt class="col-5">Moule</dt><dd class="col-7">{{ p.moule ?? '—' }}</dd>
                    <dt class="col-5">Famille</dt><dd class="col-7">{{ p.famille ?? '—' }}</dd>
                    <dt class="col-5">Chambre</dt><dd class="col-7">{{ p.coldRoom ? p.coldRoom.name : '—' }}</dd>
                    <dt class="col-5">Rayon</dt><dd class="col-7">{{ p.rayon ?? '—' }}</dd>
                    <dt class="col-5">Cartons entrés</dt><dd class="col-7">{{ p.nombreCartons }}</dd>
                    <dt class="col-5">Cartons restants</dt><dd class="col-7">{{ p.cartonsRestants }}</dd>
                    <dt class="col-5">Poids total</dt><dd class="col-7">{{ (p.poidsTotal * 1000)|number_format(0) }} kg</dd>
                    <dt class="col-5">Poids restant</dt><dd class="col-7">{{ (p.poidsRestant * 1000)|number_format(0) }} kg</dd>
                    <dt class="col-5">Client</dt><dd class="col-7">{{ p.operation.client.companyName }}</dd>
                    <dt class="col-5">Date</dt><dd class="col-7">{{ p.createdAt|date('d/m/Y') }}</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
