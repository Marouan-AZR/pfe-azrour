{% extends 'base.html.twig' %}

{% block title %}Facturation{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {# Header #}
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-primary btn-sm rounded-pill">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <div>
                <h2 class="text-dark mb-0">Facturation</h2>
                <small class="text-muted">Gestion complète des factures</small>
            </div>
        </div>
        <select id="monthSelector" class="form-select form-select-sm w-auto bg-white text-dark border">
            <option>Janvier 2025</option>
            <option>Février 2025</option>
            <option selected>Mars 2025</option>
            <option>Avril 2025</option>
            <option>Mai 2025</option>
            <option>Juin 2025</option>
        </select>
    </div>

    {# Tabs #}
    <ul class="nav nav-tabs border-0 mb-4" id="facturationTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active bg-transparent text-primary border-0 border-bottom border-3 border-primary" id="recap-tab" data-bs-toggle="tab" data-bs-target="#recap" type="button" role="tab">
                <i class="bi bi-bar-chart-line me-1"></i> Récapitulatif
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link bg-transparent text-muted border-0" id="tarifs-tab" data-bs-toggle="tab" data-bs-target="#tarifs" type="button" role="tab">
                <i class="bi bi-tags me-1"></i> Tarifs
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link bg-transparent text-muted border-0" id="factures-tab" data-bs-toggle="tab" data-bs-target="#factures" type="button" role="tab">
                <i class="bi bi-receipt me-1"></i> Factures
            </button>
        </li>
    </ul>

    <div class="tab-content">
        {# TAB 1 - Récapitulatif #}
        <div class="tab-pane fade show active" id="recap" role="tabpanel">
            <div class="card border-0 rounded-4 shadow" style="background:#fff">>
                <div class="card-body p-4">
                    <h5 class="text-dark mb-1"><i class="bi bi-graph-up me-2"></i>Tableau Récapitulatif Mensuel</h5>
                    <p class="text-muted small mb-4">Vue synthétique de l'activité de chaque client pour <span id="selectedMonthLabel">Mars 2025</span></p>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>Client</th>
                                    <th>CA (MAD)</th>
                                    <th>Stock Initial (kg)</th>
                                    <th>Entrées (kg)</th>
                                    <th>Sorties (kg)</th>
                                    <th>Stock Final (kg)</th>
                                    <th>Stock Moyen (kg)</th>
                                    <th>Stock Moyen (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-dark">Maroc Fruits Export</td>
                                    <td class="fw-bold" style="color:#f0a500">120.000</td>
                                    <td class="text-dark">5.000</td>
                                    <td class="text-success">+2.000</td>
                                    <td class="text-danger">-1.500</td>
                                    <td class="text-dark">5.500</td>
                                    <td class="text-dark">5.250</td>
                                    <td><span class="badge bg-primary">10%</span></td>
                                </tr>
                                <tr>
                                    <td class="text-dark">Atlas Seafood</td>
                                    <td class="fw-bold" style="color:#f0a500">85.000</td>
                                    <td class="text-dark">3.000</td>
                                    <td class="text-success">+1.200</td>
                                    <td class="text-danger">-900</td>
                                    <td class="text-dark">3.300</td>
                                    <td class="text-dark">3.150</td>
                                    <td><span class="badge bg-primary">6%</span></td>
                                </tr>
                                <tr>
                                    <td class="text-dark">Casablanca Fresh</td>
                                    <td class="fw-bold" style="color:#f0a500">95.000</td>
                                    <td class="text-dark">4.000</td>
                                    <td class="text-success">+1.800</td>
                                    <td class="text-danger">-1.200</td>
                                    <td class="text-dark">4.600</td>
                                    <td class="text-dark">4.300</td>
                                    <td><span class="badge bg-primary">8%</span></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold border-top">
                                    <td class="text-dark">TOTAL</td>
                                    <td style="color:#f0a500">300.000</td>
                                    <td class="text-dark">12.000</td>
                                    <td class="text-success">+5.000</td>
                                    <td class="text-danger">-3.600</td>
                                    <td class="text-dark">13.400</td>
                                    <td class="text-dark">12.700</td>
                                    <td><span class="badge bg-primary">94.8%</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        {# TAB 2 - Tarifs #}
        <div class="tab-pane fade" id="tarifs" role="tabpanel">
            <div class="card border-0 rounded-4 shadow" style="background:#fff">>
                <div class="card-body p-4">
                    <h5 class="text-dark mb-4"><i class="bi bi-tags me-2"></i>Grille Tarifaire</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>Client</th>
                                    <th>Type</th>
                                    <th>Manip. Entrée (DH/T)</th>
                                    <th>Manip. Sortie (DH/T)</th>
                                    <th>PU Stockage (DH)</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set tarifs = [
                                    {client:'Maroc Fruits Export', type:'Séjour', entree:150, sortie:120, pu:80},
                                    {client:'Atlas Seafood', type:'Forfait', entree:180, sortie:140, pu:95},
                                    {client:'Casablanca Fresh', type:'Séjour', entree:160, sortie:130, pu:85}
                                ] %}
                                {% for t in tarifs %}
                                <tr>
                                    <td class="text-dark">{{ t.client }}</td>
                                    <td><span class="badge bg-info">{{ t.type }}</span></td>
                                    <td class="text-dark">{{ t.entree }}</td>
                                    <td class="text-dark">{{ t.sortie }}</td>
                                    <td class="text-dark">{{ t.pu }}</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-warning rounded-pill" data-bs-toggle="modal" data-bs-target="#tarifModal"
                                            data-client="{{ t.client }}" data-type="{{ t.type }}" data-entree="{{ t.entree }}" data-sortie="{{ t.sortie }}" data-pu="{{ t.pu }}">
                                            <i class="bi bi-pencil me-1"></i>Modifier
                                        </button>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# Tarif Modal #}
            <div class="modal fade" id="tarifModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-white border rounded-4">
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title text-dark"><i class="bi bi-pencil-square me-2"></i>Modifier Tarif</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <form id="tarifForm">
                                <div class="mb-3">
                                    <label class="form-label text-muted">Manipulation entrée (DH/T)</label>
                                    <input type="number" class="form-control bg-white text-dark border" id="modalEntree">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted">Manipulation sortie (DH/T)</label>
                                    <input type="number" class="form-control bg-white text-dark border" id="modalSortie">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted">PU Stockage (DH)</label>
                                    <input type="number" class="form-control bg-white text-dark border" id="modalPu">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted">Type</label>
                                    <select class="form-select bg-white text-dark border" id="modalType">
                                        <option value="Séjour">Séjour</option>
                                        <option value="Forfait">Forfait</option>
                                    </select>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer border-top">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Annuler</button>
                            <button type="button" class="btn btn-warning rounded-pill">Enregistrer</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# TAB 3 - Factures #}
        <div class="tab-pane fade" id="factures" role="tabpanel">
            <div class="card border-0 rounded-4 shadow" style="background:#fff">>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="text-dark mb-0"><i class="bi bi-receipt me-2"></i>Liste des Factures</h5>
                        {% if is_granted('INVOICE_CREATE') %}
                            <a href="{{ path('app_invoice_generate') }}" class="btn btn-success rounded-pill">
                                <i class="bi bi-plus-circle me-1"></i>Générer une facture
                            </a>
                        {% endif %}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>N° Facture</th>
                                    <th>Client</th>
                                    <th>Période</th>
                                    <th>Montant (DH)</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for invoice in invoices %}
                                <tr>
                                    <td class="text-dark">{{ invoice.invoiceNumber }}</td>
                                    <td class="text-dark">{{ invoice.client.companyName }}</td>
                                    <td class="text-muted">{{ invoice.periodStart|date('d/m/Y') }} - {{ invoice.periodEnd|date('d/m/Y') }}</td>
                                    <td class="text-dark fw-bold">{{ invoice.totalTtc|number_format(2, ',', '.') }}</td>
                                    <td>
                                        <span class="badge bg-{{ invoice.status.cssClass }}">{{ invoice.status.label }}</span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_invoice_show', {id: invoice.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill me-1">
                                            <i class="bi bi-eye"></i> Consulter
                                        </a>
                                        <a href="{{ path('app_invoice_pdf', {id: invoice.id}) }}" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-file-pdf"></i> PDF
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Aucune facture trouvée.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Tab active styling
    document.querySelectorAll('#facturationTabs .nav-link').forEach(function (tab) {
        tab.addEventListener('shown.bs.tab', function () {
            document.querySelectorAll('#facturationTabs .nav-link').forEach(function (t) {
                t.classList.remove('border-bottom', 'border-3', 'border-primary', 'text-primary');
                t.classList.add('text-muted');
            });
            this.classList.add('border-bottom', 'border-3', 'border-primary', 'text-primary');
            this.classList.remove('text-muted');
        });
    });

    // Month selector label update
    document.getElementById('monthSelector').addEventListener('change', function () {
        document.getElementById('selectedMonthLabel').textContent = this.value;
    });

    // Tarif modal population
    var tarifModal = document.getElementById('tarifModal');
    if (tarifModal) {
        tarifModal.addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('modalEntree').value = btn.getAttribute('data-entree');
            document.getElementById('modalSortie').value = btn.getAttribute('data-sortie');
            document.getElementById('modalPu').value = btn.getAttribute('data-pu');
            document.getElementById('modalType').value = btn.getAttribute('data-type');
        });
    }
});
</script>
{% endblock %}
