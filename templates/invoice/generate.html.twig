{% extends 'base.html.twig' %}
{% block title %}Générer une facture{% endblock %}

{% block stylesheets %}
<style>
.gen-wrap { max-width:760px; margin:0 auto; }

/* ── Card principale ── */
.gen-card {
    background:#fff; border:1px solid #e2e8f0; border-radius:1.1rem;
    box-shadow:0 4px 24px rgba(0,0,0,.06); overflow:hidden;
}
.gen-card-header {
    background:linear-gradient(135deg,#1e3a5f,#2563eb);
    padding:1.25rem 1.75rem; display:flex; align-items:center; gap:.75rem;
}
.gen-card-header .ico {
    width:42px; height:42px; background:rgba(255,255,255,.15); border-radius:.6rem;
    display:flex; align-items:center; justify-content:center; font-size:1.2rem;
}
.gen-card-header .title { color:#fff; font-size:1.05rem; font-weight:800; }
.gen-card-header .sub   { color:rgba(255,255,255,.65); font-size:.78rem; }
.gen-card-body { padding:1.75rem; }

/* ── Étapes de processus (§7 du cahier des charges) ── */
.process-steps { display:flex; gap:0; flex-wrap:wrap; margin-bottom:1.5rem; }
.ps {
    flex:1; min-width:80px; display:flex; flex-direction:column; align-items:center;
    text-align:center; position:relative;
}
.ps:not(:last-child)::after {
    content:''; position:absolute; top:13px; left:calc(50% + 14px); right:calc(-50% + 14px);
    height:2px; background:#e2e8f0; z-index:0;
}
.ps .num {
    width:28px; height:28px; border-radius:50%; background:#e2e8f0; color:#64748b;
    font-size:.72rem; font-weight:800; display:flex; align-items:center; justify-content:center;
    position:relative; z-index:1; margin-bottom:.4rem; border:2px solid #fff;
    box-shadow:0 0 0 2px #e2e8f0;
}
.ps .ps-lbl { font-size:.63rem; color:#94a3b8; line-height:1.3; font-weight:600; }
.ps.active .num { background:#2563eb; color:#fff; box-shadow:0 0 0 2px #bfdbfe; }
.ps.active .ps-lbl { color:#2563eb; }
.ps.done .num { background:#10b981; color:#fff; box-shadow:0 0 0 2px #bbf7d0; }

/* ── Formulaire ── */
.field-label {
    font-size:.8rem; font-weight:700; color:#374151; margin-bottom:.4rem;
    display:flex; align-items:center; gap:.4rem;
}
.field-label i { color:#2563eb; }

/* ── Aperçu tarif ── */
.tarif-preview {
    background:#f8fafc; border:1px solid #e2e8f0; border-radius:.75rem;
    overflow:hidden; margin-top:1rem;
}
.tarif-preview .tp-header {
    padding:.6rem 1rem; background:#1e3a5f; color:#fff;
    font-size:.75rem; font-weight:700; display:flex; align-items:center; gap:.4rem;
}
.tarif-preview .tp-body { padding:1rem; display:grid; grid-template-columns:1fr 1fr; gap:.75rem; }
.tarif-bloc {
    border-radius:.6rem; padding:.85rem 1rem;
}
.tarif-bloc .t-mode { font-size:.68rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.6rem; }
.tarif-bloc .t-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:.3rem; }
.tarif-bloc .t-row .k { font-size:.73rem; color:#64748b; }
.tarif-bloc .t-row .v { font-size:.78rem; font-weight:800; color:#0f172a; }

/* ── Règles métier reminder ── */
.rules-box {
    background:#fffbeb; border:1px solid #fde68a; border-radius:.75rem;
    padding:.85rem 1rem; margin-top:1rem; font-size:.78rem; color:#92400e;
}
.rules-box ul { margin:.4rem 0 0 1rem; }
.rules-box li { margin-bottom:.2rem; }

/* ── Warning no tarif ── */
#noTarifWarning { margin-top:.75rem; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">
<div class="gen-wrap">

    {# Retour #}
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('app_invoice_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <div>
            <h2 class="fw-bold mb-0" style="font-size:1.2rem">Générer une facture</h2>
            <small class="text-secondary">Facturation automatique selon les tarifs du client</small>
        </div>
    </div>

    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">
            <i class="bi bi-exclamation-circle me-2"></i>{{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# ── Processus (§7 du PDF) ── #}
    <div class="process-steps mb-4">
        <div class="ps done"><div class="num"><i class="bi bi-check" style="font-size:.6rem"></i></div><div class="ps-lbl">Sélection client</div></div>
        <div class="ps done"><div class="num"><i class="bi bi-check" style="font-size:.6rem"></i></div><div class="ps-lbl">Sélection période</div></div>
        <div class="ps active"><div class="num">3</div><div class="ps-lbl">Récup. opérations validées</div></div>
        <div class="ps"><div class="num">4</div><div class="ps-lbl">Calcul manipulations</div></div>
        <div class="ps"><div class="num">5</div><div class="ps-lbl">Calcul stockage</div></div>
        <div class="ps"><div class="num">6</div><div class="ps-lbl">Génération lignes</div></div>
        <div class="ps"><div class="num">7</div><div class="ps-lbl">Total à payer</div></div>
    </div>

    <div class="gen-card">
        <div class="gen-card-header">
            <div class="ico">🧾</div>
            <div>
                <div class="title">Paramètres de facturation</div>
                <div class="sub">Seules les opérations validées sont prises en compte</div>
            </div>
        </div>
        <div class="gen-card-body">
            <form method="post" action="{{ path('app_invoice_generate') }}" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('generate_invoice') }}">

                {# ── Étape 1 : Client ── #}
                <div class="mb-4">
                    <div class="field-label"><i class="bi bi-building"></i>1. Sélectionner le client</div>
                    <select name="client_id" id="clientSelect" class="form-select" required>
                        <option value="">— Choisir un client actif —</option>
                        {% for client in clients %}
                            <option value="{{ client.id }}"
                                    data-has-tarif="{{ tarifClients[client.id] is defined ? '1' : '0' }}"
                                    data-sejour="{{ tarifClients[client.id] is defined ? tarifClients[client.id].puSejour : '' }}"
                                    data-manip-entree="{{ tarifClients[client.id] is defined ? tarifClients[client.id].puManipEntree : '' }}"
                                    data-manip-sortie="{{ tarifClients[client.id] is defined ? tarifClients[client.id].puManipSortie : '' }}"
                                    data-forfait="{{ tarifClients[client.id] is defined ? tarifClients[client.id].montantForfait : '' }}">
                                {{ client.officialName }}{% if client.officialName != client.companyName %} ({{ client.companyName }}){% endif %}
                            </option>
                        {% endfor %}
                    </select>

                    {# Aperçu tarif du client sélectionné #}
                    <div id="tarifPreview" class="tarif-preview d-none">
                        <div class="tp-header">
                            <i class="bi bi-tags-fill"></i> Grille tarifaire du client
                        </div>
                        <div class="tp-body">
                            <div class="tarif-bloc" style="background:#eff6ff;border:1px solid #bfdbfe">
                                <div class="t-mode" style="color:#1d4ed8"><i class="bi bi-calendar-week me-1"></i>Mode Séjour</div>
                                <div class="t-row"><span class="k">PU Séjour</span><span class="v" id="pvSejour"></span>&nbsp;<span style="font-size:.65rem;color:#94a3b8">DH/kg/j</span></div>
                                <div class="t-row"><span class="k">Manip. Entrée</span><span class="v" id="pvManipE"></span>&nbsp;<span style="font-size:.65rem;color:#94a3b8">DH/kg</span></div>
                                <div class="t-row"><span class="k">Manip. Sortie</span><span class="v" id="pvManipS"></span>&nbsp;<span style="font-size:.65rem;color:#94a3b8">DH/kg</span></div>
                            </div>
                            <div class="tarif-bloc" style="background:#f0fdf4;border:1px solid #bbf7d0">
                                <div class="t-mode" style="color:#065f46"><i class="bi bi-tag-fill me-1"></i>Mode Forfait</div>
                                <div class="t-row"><span class="k">Montant fixe / mois</span></div>
                                <div class="t-row"><span class="v fs-5" id="pvForfait"></span>&nbsp;<span style="font-size:.65rem;color:#94a3b8">DH</span></div>
                                <div style="font-size:.68rem;color:#94a3b8;margin-top:.3rem">Aucun calcul de jours en mode forfait</div>
                            </div>
                        </div>
                    </div>

                    <div id="noTarifWarning" class="d-none alert alert-warning py-2 mb-0" style="font-size:.82rem">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Ce client n'a pas de grille tarifaire configurée.
                        <a href="{{ path('app_invoice_index') }}#tarifs" class="alert-link fw-semibold">Configurer maintenant →</a>
                    </div>
                </div>

                {# ── Étape 2 : Type de stockage ── #}
                <div class="mb-4" id="storageTypeBlock" style="display:none">
                    <div class="field-label"><i class="bi bi-archive"></i>2. Type de stockage à facturer</div>
                    <div class="d-flex gap-3 flex-wrap mt-1">
                        <label id="lblSejour" class="d-flex align-items-center gap-2 px-4 py-3 rounded-3 border cursor-pointer"
                               style="cursor:pointer;border-color:#e2e8f0;background:#f8fafc;flex:1;min-width:160px">
                            <input type="radio" name="storage_type" value="sejour" id="radioSejour" class="form-check-input mt-0" style="width:18px;height:18px">
                            <div>
                                <div class="fw-bold" style="font-size:.88rem;color:#1d4ed8"><i class="bi bi-calendar-week me-1"></i>Séjour</div>
                                <div style="font-size:.72rem;color:#64748b">Facturation par kg × jours</div>
                            </div>
                        </label>
                        <label id="lblForfait" class="d-flex align-items-center gap-2 px-4 py-3 rounded-3 border cursor-pointer"
                               style="cursor:pointer;border-color:#e2e8f0;background:#f8fafc;flex:1;min-width:160px">
                            <input type="radio" name="storage_type" value="forfait" id="radioForfait" class="form-check-input mt-0" style="width:18px;height:18px">
                            <div>
                                <div class="fw-bold" style="font-size:.88rem;color:#065f46"><i class="bi bi-tag-fill me-1"></i>Forfait</div>
                                <div style="font-size:.72rem;color:#64748b">Montant fixe mensuel</div>
                            </div>
                        </label>
                    </div>
                    <div id="noStorageWarning" class="d-none alert alert-warning py-2 mt-2 mb-0" style="font-size:.82rem">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Aucun tarif configuré pour ce type de stockage.
                    </div>
                </div>

                {# ── Étape 3 : Mois ── #}
                <div class="mb-4">
                    <div class="field-label"><i class="bi bi-calendar-month"></i>3. Mois de facturation</div>
                    <input type="month" name="month" id="monthInput"
                           class="form-control" value="{{ defaultMonth }}" required
                           style="max-width:220px">
                    <div class="form-text">La facture couvrira tout le mois sélectionné (du 1er au dernier jour).</div>
                </div>

                {# Règles métier rappel #}
                <div class="rules-box">
                    <strong><i class="bi bi-info-circle me-1"></i>Règles de calcul :</strong>
                    <ul>
                        <li>Seules les opérations <strong>validées</strong> sont prises en compte</li>
                        <li>Mode <strong>Forfait</strong> : Manip. Entrée + Manip. Sortie + Montant forfaitaire fixe (pas de calcul de jours)</li>
                        <li>Mode <strong>Séjour</strong> : Manip. Entrée + Manip. Sortie + Qty × Jours × PU séjour (palettes regroupées par durée identique)</li>
                        <li>Les jours sont calculés <strong>sur le mois uniquement</strong> (compteur remis à zéro à chaque mois)</li>
                    </ul>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_invoice_index') }}" class="btn btn-outline-secondary rounded-pill">
                        Annuler
                    </a>
                    <button type="submit" id="submitBtn" class="btn btn-success rounded-pill px-4" disabled>
                        <i class="bi bi-calculator me-1"></i>Générer la facture
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const sel         = document.getElementById('clientSelect');
const submit      = document.getElementById('submitBtn');
const month       = document.getElementById('monthInput');
const radioSejour = document.getElementById('radioSejour');
const radioForfait= document.getElementById('radioForfait');
const lblSejour   = document.getElementById('lblSejour');
const lblForfait  = document.getElementById('lblForfait');
const storageBlock= document.getElementById('storageTypeBlock');

function updateForm() {
    const opt       = sel.options[sel.selectedIndex];
    const hasTarif  = opt.dataset.hasTarif === '1';
    const hasMonth  = !!month.value;
    const hasSejour = hasTarif && parseFloat(opt.dataset.sejour || '0') > 0;
    const hasForfait= hasTarif && parseFloat(opt.dataset.forfait || '0') > 0;

    // Aperçu tarif
    document.getElementById('tarifPreview').classList.toggle('d-none', !opt.value || !hasTarif);
    document.getElementById('noTarifWarning').classList.toggle('d-none', !opt.value || hasTarif);

    if (opt.value && hasTarif) {
        document.getElementById('pvSejour').textContent  = opt.dataset.sejour;
        document.getElementById('pvManipE').textContent  = opt.dataset.manipEntree;
        document.getElementById('pvManipS').textContent  = opt.dataset.manipSortie;
        document.getElementById('pvForfait').textContent = opt.dataset.forfait;
    }

    // Bloc type de stockage
    storageBlock.style.display = (opt.value && hasTarif) ? '' : 'none';

    // Activer/désactiver les options selon les tarifs disponibles
    radioSejour.disabled  = !hasSejour;
    radioForfait.disabled = !hasForfait;
    lblSejour.style.opacity  = hasSejour  ? '1' : '0.4';
    lblForfait.style.opacity = hasForfait ? '1' : '0.4';
    lblSejour.style.cursor   = hasSejour  ? 'pointer' : 'not-allowed';
    lblForfait.style.cursor  = hasForfait ? 'pointer' : 'not-allowed';

    // Auto-sélectionner si un seul type disponible
    if (hasSejour && !hasForfait)  { radioSejour.checked = true; radioForfait.checked = false; }
    if (hasForfait && !hasSejour)  { radioForfait.checked = true; radioSejour.checked = false; }
    if (!hasSejour && !hasForfait) { radioSejour.checked = false; radioForfait.checked = false; }

    const storageSelected = radioSejour.checked || radioForfait.checked;
    submit.disabled = !(opt.value && hasTarif && hasMonth && storageSelected);
}

// Highlight label sélectionné
[radioSejour, radioForfait].forEach(radio => {
    radio.addEventListener('change', () => {
        lblSejour.style.borderColor  = radioSejour.checked  ? '#2563eb' : '#e2e8f0';
        lblSejour.style.background   = radioSejour.checked  ? '#eff6ff' : '#f8fafc';
        lblForfait.style.borderColor = radioForfait.checked ? '#10b981' : '#e2e8f0';
        lblForfait.style.background  = radioForfait.checked ? '#f0fdf4' : '#f8fafc';
        const hasMonth = !!month.value;
        submit.disabled = !hasMonth;
    });
});

sel.addEventListener('change', updateForm);
month.addEventListener('change', () => {
    const storageSelected = radioSejour.checked || radioForfait.checked;
    submit.disabled = !(sel.value && !!month.value && storageSelected);
});
updateForm();
</script>
{% endblock %}
