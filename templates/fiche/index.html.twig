{% extends 'base.html.twig' %}

{% block title %}Fiches de Décharge{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="mb-4"><i class="bi bi-file-earmark-text me-2"></i>Fiches de Décharge</h1>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>N° Fiche</th>
                            <th>Opération</th>
                            <th>Client</th>
                            <th>Contrôleur</th>
                            <th class="text-center">Palettes</th>
                            <th class="text-end">Poids Total</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for fiche in fiches %}
                        <tr>
                            <td><code>{{ fiche.numero }}</code></td>
                            <td><code>{{ fiche.operation.code }}</code></td>
                            <td>{{ fiche.client.companyName }}</td>
                            <td>{{ fiche.controleur.fullName }}</td>
                            <td class="text-center">{{ fiche.operation.nombrePalettes }}</td>
                            <td class="text-end">{{ fiche.poidsTotal|number_format(0, ',', ' ') }} kg</td>
                            <td class="text-center"><span class="badge bg-{{ fiche.status.cssClass }}">{{ fiche.status.label }}</span></td>
                            <td class="text-center">
                                <a href="{{ path('app_fiche_show', {id: fiche.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="8" class="text-center py-4 text-muted">Aucune fiche</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
