{% extends 'base.html.twig' %}

{% block title %}Fiche {{ fiche.operation.type.value == 'exit' ? 'de Charge' : 'de Décharge' }} {{ fiche.numero }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
<h1><i class="bi bi-file-earmark-text me-2"></i>Fiche de {{ fiche.operation.type.value == 'exit' ? 'Charge' : 'Décharge' }} N° {{ fiche.numero }}</h1>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Imprimer</button>
            <a href="{{ path('app_fiche_index') }}" class="btn btn-outline-secondary no-print"><i class="bi bi-arrow-left"></i> Retour</a>
        </div>


    </div>

    {# Le bouton imprimer doit imprimer aussi les tableaux. #}
    <style>
        @media print {
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

            /* Afficher tout le contenu au print */
            .modal, .modal-backdrop { display: none !important; }
            .table-responsive { overflow: visible !important; }
            .table { width: 100% !important; }
        }
    </style>



    {# En-tête fiche #}
    <div class="card mb-4">
        <div class="card-header">En-tête</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><small class="text-muted">Fiche N°</small><br><strong>{{ fiche.numero }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Date</small><br><strong>{{ fiche.createdAt|date('d/m/Y') }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Client</small><br><strong>{{ fiche.client.companyName }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Statut</small><br><span class="badge bg-{{ fiche.status.cssClass }} fs-6">{{ fiche.status.label }}</span></div>
                <div class="col-md-3"><small class="text-muted">Contrôleur</small><br><strong>{{ fiche.controleur.fullName }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Température</small><br><strong>{{ fiche.temperature ?? '—' }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Total Cartons</small><br><strong>{{ fiche.totalCartons }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Total Kg</small><br><strong>{{ fiche.poidsTotal|number_format(0, ',', ' ') }}</strong></div>
            </div>
        </div>
    </div>

    {# --- EXIT CONTROL: Scan card + progress counter --- #}
    {% set isExitControl = fiche.operation.type.value == 'exit' and fiche.isEnCoursControle() and fiche.controleur and fiche.controleur.id == app.user.id %}

    {% if isExitControl %}
    {# Progress counter #}
    {% set controlledCount = 0 %}
    {% for p in fiche.operation.palettes %}
        {% if p.status.value != 'en_attente' %}
            {% set controlledCount = controlledCount + 1 %}
        {% endif %}
    {% endfor %}
    <div class="card mb-4 border-info">
        <div class="card-body d-flex align-items-center justify-content-between">
            <span><i class="bi bi-clipboard-check me-2"></i><strong>{{ controlledCount }} / {{ fiche.operation.palettes|length }}</strong> palettes contrôlées</span>
            <div class="progress flex-grow-1 ms-3" style="height: 20px;">
                <div class="progress-bar bg-info" style="width: {{ fiche.operation.palettes|length > 0 ? (controlledCount / fiche.operation.palettes|length * 100) : 0 }}%"></div>
            </div>
        </div>
    </div>

    {# Contrôle terrain scan card #}
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white"><i class="bi bi-qr-code-scan me-2"></i>Contrôle terrain</div>
        <div class="card-body">
            <label class="form-label">Scanner ou saisir le code palette :</label>
            <input type="text" id="scanInput" class="form-control form-control-lg" placeholder="Scannez le QR code..." autofocus>
        </div>
    </div>

    {# Fiche de Charge - editable info #}
    <div class="card mb-4">
        <div class="card-header">Informations Chargement</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Heure début chargement</label>
                    <input type="time" class="form-control" id="heureDebut" disabled>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Heure fin chargement</label>
                    <input type="time" class="form-control" id="heureFin" disabled>
                </div>
                <div class="col-md-3"><small class="text-muted">Température</small><br><strong>{{ fiche.temperature ?? '—' }}</strong></div>
                <div class="col-md-3"><small class="text-muted">Matricule</small><br><strong>{{ fiche.matricule ?? '—' }}</strong></div>
                <div class="col-md-3"><small class="text-muted">N° Conteneur</small><br><strong>{{ fiche.numeroConteneur ?? '—' }}</strong></div>
                <div class="col-md-3"><small class="text-muted">N° Agrément</small><br><strong>{{ fiche.numeroAgrement ?? '—' }}</strong></div>
            </div>
        </div>
    </div>
    {% endif %}

    {# Tableau des palettes #}
    <div class="card mb-4">
        <div class="card-header">Tableau des palettes</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="palettesTable">
                    <thead>
                        <tr>
                            <th>Code Palette</th>
                            <th>Espèce</th>
                            <th>Qualité</th>
                            <th>Moule</th>
                            <th>Famille</th>
                            <th class="text-center">N° Cartons</th>
                            <th class="text-end">Poids Carton</th>
                            <th>CD Lot Client</th>
                            <th>Chambre</th>
                            <th>Rayon</th>
                            <th>Observation</th>
                            {% if isExitControl %}
                            <th class="text-center">Cartons à sortir</th>
                            <th>Statut contrôle</th>
                            <th>Actions</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for palette in fiche.operation.palettes %}
                        <tr data-palette-code="{{ palette.codePalette }}">
                            <td><code>{{ palette.codePalette }}</code></td>
                            <td>{{ palette.espece }}</td>
                            <td>{{ palette.qualite ?? '—' }}</td>
                            <td>{{ palette.moule ?? '—' }}</td>
                            <td>{{ palette.famille ?? '—' }}</td>
                            <td class="text-center">{{ palette.nombreCartons }}</td>
                            <td class="text-end">{{ palette.poidsCarton }} kg</td>
                            <td>{{ fiche.operation.cdLotClient ?? '—' }}</td>
                            <td>{{ palette.coldRoom ? palette.coldRoom.name : '—' }}</td>
                            <td>{{ palette.rayon ?? '—' }}</td>
                            <td>{{ palette.observation ?? '' }}</td>
                            {% if isExitControl %}
                            <td class="text-center">
                                <form method="post" action="{{ path('app_fiche_palette_controle', {id: fiche.id, paletteId: palette.id}) }}" class="palette-control-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('controle' ~ palette.id) }}">
                                    <input type="number" name="cartons_sortis" value="{{ palette.nombreCartons }}" min="0" max="{{ palette.nombreCartons }}" class="form-control form-control-sm" style="width:80px;display:inline-block">
                                </form>
                            </td>
                            <td><span class="badge bg-{{ palette.status.cssClass }}">{{ palette.status.label }}</span></td>
                            <td>
                                <button type="submit" form="form-ctrl-{{ palette.id }}" class="btn btn-sm btn-success" title="Valider"><i class="bi bi-check-lg"></i></button>
                                <button type="button" class="btn btn-sm btn-danger btn-reject" data-palette-id="{{ palette.id }}" data-fiche-id="{{ fiche.id }}" title="Rejeter"><i class="bi bi-x-lg"></i></button>
                                <form id="form-ctrl-{{ palette.id }}" method="post" action="{{ path('app_fiche_palette_controle', {id: fiche.id, paletteId: palette.id}) }}" style="display:none">
                                    <input type="hidden" name="_token" value="{{ csrf_token('controle' ~ palette.id) }}">
                                    <input type="hidden" name="cartons_sortis" class="cartons-hidden" value="{{ palette.nombreCartons }}">
                                </form>
                                <form id="form-reject-{{ palette.id }}" method="post" action="{{ path('app_fiche_palette_controle', {id: fiche.id, paletteId: palette.id}) }}" style="display:none">
                                    <input type="hidden" name="_token" value="{{ csrf_token('controle' ~ palette.id) }}">
                                    <input type="hidden" name="action" value="reject">
                                    <input type="hidden" name="motif_rejet" class="motif-hidden" value="">
                                </form>
                            </td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Sommaire #}
    <div class="card mb-4">
        <div class="card-header">Sommaire (Récapitulatif)</div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr><th>Produit</th><th>Qualité</th><th>Moule</th><th>Famille</th><th class="text-center">Nb Cartons</th><th class="text-end">Poids Total</th></tr>
                </thead>
                <tbody>
                    {# Regroupement par (Espèce, Qualité, Moule, Type conditionnement)
                       Dans ce projet: on utilise (espece, qualite, moule, famille) #}
                    {% set grouped = {} %}
                    {% set totalC = 0 %}
                    {% set totalP = 0 %}

                    {% for palette in fiche.operation.palettes %}
                        {% set esp = palette.espece|default('') %}
                        {% set qual = palette.qualite ?? '—' %}
                        {% set moule = palette.moule ?? '—' %}
                        {% set cond = palette.famille ?? '—' %}

                        {% set key = esp ~ '||' ~ qual ~ '||' ~ moule ~ '||' ~ cond %}

                        {% set totalC = totalC + palette.nombreCartons %}
                        {% set totalP = totalP + palette.poidsTotal %}

                        {% if grouped[key] is not defined %}
                            {% set grouped = grouped|merge({ (key): {
                                'esp': esp,
                                'qual': qual,
                                'moule': moule,
                                'cond': cond,
                                'cartons': palette.nombreCartons,
                                'poids': palette.poidsTotal
                            } }) %}
                        {% else %}
                            {% set prev = grouped[key] %}
                            {% set prevCartons = prev.cartons + palette.nombreCartons %}
                            {% set prevPoids = prev.poids + palette.poidsTotal %}
                            {% set grouped = grouped|merge({ (key): {
                                'esp': prev.esp,
                                'qual': prev.qual,
                                'moule': prev.moule,
                                'cond': prev.cond,
                                'cartons': prevCartons,
                                'poids': prevPoids
                            } }) %}
                        {% endif %}
                    {% endfor %}

                    {% for item in grouped %}
                        <tr>
                            <td>{{ item.esp }}</td>
                            <td>{{ item.qual }}</td>
                            <td>{{ item.moule }}</td>
                            <td>{{ item.cond }}</td>
                            <td class="text-center">{{ item.cartons }}</td>
                            <td class="text-end">{{ item.poids|number_format(0, ',', ' ') }} kg</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="table-secondary fw-bold">
                        <td colspan="4">TOTAL GÉNÉRAL</td>
                        <td class="text-center">{{ totalC }}</td>
                        <td class="text-end">{{ totalP|number_format(0, ',', ' ') }} kg</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    {# Actions workflow #}
    {% if fiche.isEnCoursControle() and fiche.controleur and fiche.controleur.id == app.user.id %}
    <div class="card mb-4">

        <div class="card-body">
            <form action="{{ path('app_fiche_submit', {id: fiche.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('submit' ~ fiche.id) }}">
                <div class="mb-3">
                    <label class="form-label">Observation (optionnel)</label>
                    <textarea name="observation" class="form-control" rows="2" placeholder="Remarques du contrôle...">{{ fiche.observation }}</textarea>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> 📤 Envoyer pour validation</button>
            </form>
        </div>
    </div>
    {% endif %}

    {% if fiche.isEnAttenteValidation() and is_granted('ROLE_CHEF_STOCK') %}


    <div class="card">
        <div class="card-body d-flex gap-2 justify-content-end">
            <form action="{{ path('app_fiche_validate', {id: fiche.id}) }}" method="post" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ fiche.id) }}">
                <button class="btn btn-success"><i class="bi bi-check-circle"></i> ✅ Valider la fiche</button>
            </form>
            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectFicheModal"><i class="bi bi-x-circle"></i> ❌ Rejeter</button>
        </div>
    </div>

    <div class="modal fade" id="rejectFicheModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="{{ path('app_fiche_reject', {id: fiche.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ fiche.id) }}">
                    <div class="modal-header"><h5 class="modal-title">Motif de rejet</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <textarea name="commentaire" class="form-control" rows="3" placeholder="Commentaire..."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger">Rejeter</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% endif %}

    {% if fiche.commentaireRejet %}
    <div class="alert alert-danger mt-3">
        <strong>Motif de rejet :</strong> {{ fiche.commentaireRejet }}
    </div>
    {% endif %}

    {% if isExitControl %}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const scanInput = document.getElementById('scanInput');
        if (scanInput) {
            scanInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const code = this.value.trim();
                    document.querySelectorAll('#palettesTable tbody tr').forEach(r => r.classList.remove('table-info'));
                    const row = document.querySelector('#palettesTable tbody tr[data-palette-code="' + code + '"]');
                    if (row) {
                        row.classList.add('table-info');
                        row.scrollIntoView({behavior: 'smooth', block: 'center'});
                    }
                    this.value = '';
                }
            });
        }

        // Sync cartons_sortis to hidden form
        document.querySelectorAll('.palette-control-form input[name="cartons_sortis"]').forEach(function(input) {
            input.addEventListener('change', function() {
                const row = this.closest('tr');
                const hidden = row.querySelector('.cartons-hidden');
                if (hidden) hidden.value = this.value;
            });
        });

        // Reject buttons
        document.querySelectorAll('.btn-reject').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const motif = prompt('Motif de rejet :');
                if (motif) {
                    const paletteId = this.dataset.paletteId;
                    const form = document.getElementById('form-reject-' + paletteId);
                    form.querySelector('.motif-hidden').value = motif;
                    form.submit();
                }
            });
        });
    });
    </script>
    {% endif %}
</div>
{% endblock %}
