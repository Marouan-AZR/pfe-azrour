<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouveau mot de passe — Golden Logistics</title>
    <link rel="icon" href="{{ asset('images/Logo essai.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        html, body { height:100%; font-family:'Inter',sans-serif; background:#f8fafc; color:#111827; display:flex; align-items:center; justify-content:center; min-height:100vh; }

        .card {
            background:#fff; border-radius:1.25rem;
            box-shadow:0 8px 40px rgba(0,0,0,.1);
            width:100%; max-width:440px;
            padding:2.5rem 2.25rem;
            margin:1rem;
        }

        .logo { display:flex; align-items:center; gap:.65rem; margin-bottom:2rem; }
        .logo img { height:44px; width:auto; object-fit:contain; }
        .logo span { font-size:1.1rem; font-weight:800; color:#111827; letter-spacing:-.02em; }

        .icon-wrap {
            width:64px; height:64px; border-radius:1rem;
            background:linear-gradient(135deg,#f0fdf4,#dcfce7);
            display:flex; align-items:center; justify-content:center;
            font-size:1.8rem; color:#16a34a; margin-bottom:1.25rem;
        }

        h2 { font-size:1.5rem; font-weight:800; color:#111827; letter-spacing:-.03em; margin-bottom:.35rem; }
        .sub { font-size:.875rem; color:#6b7280; line-height:1.6; margin-bottom:1.75rem; }

        .field { margin-bottom:1.1rem; }
        .field label { display:block; font-size:.79rem; font-weight:600; color:#374151; margin-bottom:.38rem; }
        .inp-w { position:relative; }
        .inp-w i.ic { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#9ca3af; font-size:.85rem; pointer-events:none; }
        .inp-w input {
            width:100%; padding:.78rem 2.6rem .78rem 2.6rem;
            border:1.5px solid #e5e7eb; border-radius:.7rem;
            font-size:.88rem; font-family:'Inter',sans-serif;
            color:#111827; background:#f9fafb; outline:none;
            transition:border-color .2s,box-shadow .2s,background .2s;
        }
        .inp-w input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.1); background:#fff; }
        .inp-w input::placeholder { color:#d1d5db; }
        .eye-btn { position:absolute; right:.85rem; top:50%; transform:translateY(-50%); background:none; border:none; color:#9ca3af; cursor:pointer; font-size:.88rem; padding:.15rem; }
        .eye-btn:hover { color:#374151; }

        .strength { margin-top:.4rem; }
        .str-bar { height:4px; border-radius:2px; background:#e5e7eb; overflow:hidden; margin-bottom:.25rem; }
        .str-fill { height:100%; border-radius:2px; transition:width .3s,background .3s; width:0; }
        .str-lbl { font-size:.72rem; color:#9ca3af; }

        .rules { background:#f8fafc; border:1px solid #e2e8f0; border-radius:.65rem; padding:.75rem .9rem; margin-bottom:1.1rem; }
        .rules ul { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:.3rem; }
        .rules ul li { font-size:.78rem; color:#9ca3af; display:flex; align-items:center; gap:.4rem; transition:color .2s; }
        .rules ul li.ok { color:#16a34a; }
        .rules ul li i { font-size:.75rem; }

        .btn {
            width:100%; padding:.85rem; background:#2563eb; color:#fff;
            border:none; border-radius:.7rem; font-size:.92rem; font-weight:700;
            cursor:pointer; font-family:'Inter',sans-serif;
            display:flex; align-items:center; justify-content:center; gap:.5rem;
            box-shadow:0 4px 14px rgba(37,99,235,.35);
            transition:background .2s,transform .15s,box-shadow .2s; margin-top:.5rem;
        }
        .btn:hover { background:#1d4ed8; transform:translateY(-1px); box-shadow:0 6px 20px rgba(37,99,235,.45); }

        .alert { padding:.75rem 1rem; border-radius:.7rem; margin-bottom:1.1rem; display:flex; align-items:flex-start; gap:.6rem; font-size:.83rem; }
        .alert-danger  { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; }
        .alert-success { background:#f0fdf4; border:1px solid #bbf7d0; color:#15803d; }
        .alert i { flex-shrink:0; margin-top:.1rem; }

        .back { display:flex; align-items:center; justify-content:center; gap:.4rem; margin-top:1.25rem; font-size:.83rem; color:#6b7280; text-decoration:none; transition:color .2s; }
        .back:hover { color:#2563eb; }
    </style>
</head>
<body>
    <div class="card">

        <div class="logo">
            <img src="{{ asset('images/Logo essai.png') }}" alt="Golden Logistics">
            <span>Golden Logistics</span>
        </div>

        {% for msg in app.flashes('error') %}
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i><span>{{ msg }}</span></div>
        {% endfor %}

        <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
        <h2>Nouveau mot de passe</h2>
        <p class="sub">Choisissez un mot de passe fort pour sécuriser votre compte.</p>

        <form method="post" id="resetForm">

            <div class="field">
                <label for="pwd1">Nouveau mot de passe</label>
                <div class="inp-w">
                    <i class="bi bi-lock ic"></i>
                    <input type="password" id="pwd1" name="password" placeholder="Minimum 8 caractères" required minlength="8" oninput="checkStrength(this.value)">
                    <button type="button" class="eye-btn" onclick="togglePwd('pwd1','eye1')"><i class="bi bi-eye" id="eye1"></i></button>
                </div>
                <div class="strength">
                    <div class="str-bar"><div class="str-fill" id="strFill"></div></div>
                    <span class="str-lbl" id="strLbl"></span>
                </div>
            </div>

            <div class="rules">
                <ul>
                    <li id="r-len"><i class="bi bi-circle"></i> Au moins 8 caractères</li>
                    <li id="r-upp"><i class="bi bi-circle"></i> Une lettre majuscule</li>
                    <li id="r-num"><i class="bi bi-circle"></i> Un chiffre</li>
                </ul>
            </div>

            <div class="field">
                <label for="pwd2">Confirmer le mot de passe</label>
                <div class="inp-w">
                    <i class="bi bi-lock ic"></i>
                    <input type="password" id="pwd2" name="confirmPassword" placeholder="Répétez le mot de passe" required minlength="8">
                    <button type="button" class="eye-btn" onclick="togglePwd('pwd2','eye2')"><i class="bi bi-eye" id="eye2"></i></button>
                </div>
            </div>

            <button type="submit" class="btn">
                <i class="bi bi-check-lg"></i> Réinitialiser le mot de passe
            </button>
        </form>

        <a href="{{ path('app_login') }}" class="back">
            <i class="bi bi-arrow-left"></i> Retour à la connexion
        </a>
    </div>

    <script>
    function togglePwd(id, ico) {
        var i = document.getElementById(id);
        var ic = document.getElementById(ico);
        var show = i.type === 'password';
        i.type = show ? 'text' : 'password';
        ic.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
    }

    function checkStrength(val) {
        var score = 0;
        var len = val.length >= 8;
        var upp = /[A-Z]/.test(val);
        var num = /[0-9]/.test(val);

        if (len) score++;
        if (upp) score++;
        if (num) score++;
        if (val.length >= 12) score++;

        var fill  = document.getElementById('strFill');
        var label = document.getElementById('strLbl');
        var pct   = (score / 4) * 100;
        var clr   = score <= 1 ? '#ef4444' : score === 2 ? '#f59e0b' : score === 3 ? '#10b981' : '#16a34a';
        var txt   = score <= 1 ? 'Faible' : score === 2 ? 'Moyen' : score === 3 ? 'Fort' : 'Très fort';

        fill.style.width      = pct + '%';
        fill.style.background = clr;
        label.textContent     = val.length ? txt : '';
        label.style.color     = clr;

        setRule('r-len', len);
        setRule('r-upp', upp);
        setRule('r-num', num);
    }

    function setRule(id, ok) {
        var el = document.getElementById(id);
        el.className = ok ? 'ok' : '';
        el.querySelector('i').className = ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
    }
    </script>
</body>
</html>