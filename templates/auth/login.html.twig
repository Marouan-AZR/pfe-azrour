<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — GL Warehouse Suite</title>
    <link rel="icon" href="{{ asset('images/logo de l\'application.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        html, body { height:100%; }
        body { font-family:'Inter',sans-serif; display:flex; min-height:100vh; background:#f1f5f9; }

        /* ── LEFT PANEL ── */
        .brand-panel {
            width: 42%;
            min-height: 100vh;
            background: linear-gradient(160deg, #0a1628 0%, #0f2352 45%, #1a3a8f 100%);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.5rem 3rem;
            overflow: hidden;
        }
        .brand-panel::before {
            content: '';
            position: absolute; inset: 0;
            background: url("{{ asset('images/Entrepôt Frigorifique de Nouvelle Génération.jpg') }}") center/cover no-repeat;
            opacity: 0.18;
        }
        .brand-panel > * { position: relative; z-index: 1; }

        .bp-logo { display:flex; align-items:center; margin-bottom:3rem; }
        .bp-logo img { height: 80px; width: auto; object-fit: contain; }

        .bp-title { font-size:2.2rem; font-weight:900; color:#fff; line-height:1.15; letter-spacing:-.03em; margin-bottom:1rem; }
        .bp-desc  { font-size:.92rem; color:rgba(255,255,255,.65); line-height:1.75; margin-bottom:2.5rem; max-width:320px; }

        .bp-features { display:flex; flex-direction:column; gap:.85rem; }
        .bp-feat { display:flex; align-items:center; gap:.85rem; }
        .bp-feat-icon {
            width:38px; height:38px; border-radius:10px; flex-shrink:0;
            background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.15);
            display:flex; align-items:center; justify-content:center;
            color:#93c5fd; font-size:.95rem;
        }
        .bp-feat-text { font-size:.84rem; color:rgba(255,255,255,.8); font-weight:500; }

        .bp-footer { font-size:.72rem; color:rgba(255,255,255,.3); margin-top:auto; padding-top:2rem; }

        /* ── RIGHT PANEL ── */
        .form-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: #f1f5f9;
        }

        .form-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,.1);
            padding: 2.75rem 2.5rem;
            width: 100%;
            max-width: 420px;
        }

        .fc-title { font-size:1.6rem; font-weight:800; color:#111827; letter-spacing:-.03em; margin-bottom:.3rem; }
        .fc-sub   { font-size:.85rem; color:#6b7280; margin-bottom:2rem; }

        .field       { margin-bottom:1.1rem; }
        .field label { display:block; font-size:.79rem; font-weight:600; color:#374151; margin-bottom:.38rem; }
        .inp-w { position:relative; }
        .inp-w .ic { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#9ca3af; font-size:.85rem; pointer-events:none; }
        .inp-w input {
            width:100%; padding:.78rem 1rem .78rem 2.6rem;
            border:1.5px solid #e5e7eb; border-radius:10px;
            font-size:.88rem; font-family:'Inter',sans-serif;
            color:#111827; background:#f9fafb; outline:none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .inp-w input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.1); background:#fff; }
        .inp-w input::placeholder { color:#d1d5db; }
        .eye-btn { position:absolute; right:.85rem; top:50%; transform:translateY(-50%); background:none; border:none; color:#9ca3af; cursor:pointer; font-size:.88rem; padding:.15rem; }
        .eye-btn:hover { color:#374151; }

        .opts-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; }
        .chk-lbl  { display:flex; align-items:center; gap:.45rem; font-size:.82rem; color:#6b7280; cursor:pointer; }
        .chk-lbl input { width:15px; height:15px; accent-color:#2563eb; cursor:pointer; }
        .forgot-lnk { font-size:.82rem; color:#2563eb; font-weight:600; text-decoration:none; }
        .forgot-lnk:hover { text-decoration:underline; }

        .btn-submit {
            width:100%; padding:.88rem; background:#2563eb; color:#fff;
            border:none; border-radius:10px; font-size:.93rem; font-weight:700;
            cursor:pointer; font-family:'Inter',sans-serif;
            display:flex; align-items:center; justify-content:center; gap:.5rem;
            box-shadow:0 4px 14px rgba(37,99,235,.35);
            transition:background .2s, transform .2s;
        }
        .btn-submit:hover { background:#1d4ed8; transform:translateY(-1px); }

        .divider { display:flex; align-items:center; gap:.75rem; margin:1.25rem 0; }
        .divider::before, .divider::after { content:''; flex:1; height:1px; background:#e5e7eb; }
        .divider span { font-size:.78rem; color:#9ca3af; white-space:nowrap; }

        .bottom-txt { text-align:center; margin-top:1.25rem; font-size:.83rem; color:#6b7280; }
        .bottom-txt a { color:#2563eb; font-weight:600; text-decoration:none; }
        .bottom-txt a:hover { text-decoration:underline; }

        .alert { padding:.78rem 1rem; border-radius:10px; margin-bottom:.9rem; display:flex; align-items:center; gap:.6rem; font-size:.82rem; }
        .alert-danger  { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; }
        .alert-warning { background:#fffbeb; border:1px solid #fde68a; color:#d97706; }

        @media(max-width:900px) { .brand-panel { display:none; } }
    </style>
</head>
<body>

    <!-- ── Left: Brand Panel ── -->
    <div class="brand-panel">
        <div>
            <div class="bp-logo">
                <img src="{{ asset('images/logo de l\'application.png') }}" alt="GL Warehouse Suite">
            </div>
            <div class="bp-title">Bienvenue !</div>
            <p class="bp-desc">Connectez-vous à votre espace pour gérer votre entrepôt frigorifique intelligemment.</p>
            <div class="bp-features">
                <div class="bp-feat">
                    <div class="bp-feat-icon"><i class="bi bi-box-seam"></i></div>
                    <span class="bp-feat-text">Gestion intelligente des stocks</span>
                </div>
                <div class="bp-feat">
                    <div class="bp-feat-icon"><i class="bi bi-bar-chart-line"></i></div>
                    <span class="bp-feat-text">Suivi en temps réel</span>
                </div>
                <div class="bp-feat">
                    <div class="bp-feat-icon"><i class="bi bi-shield-check"></i></div>
                    <span class="bp-feat-text">Sécurité et performance</span>
                </div>
            </div>
        </div>
        <div class="bp-footer">&copy; {{ "now"|date("Y") }} GL Warehouse Suite — WMS. Tous droits réservés.</div>
    </div>

    <!-- ── Right: Form Card ── -->
    <div class="form-panel">
        <div class="form-card">

            <div class="fc-title">Se connecter</div>
            <div class="fc-sub">Accédez à votre compte</div>

            {% if error %}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}
            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}

            <form method="post">
                <div class="field">
                    <label>Adresse email</label>
                    <div class="inp-w">
                        <i class="bi bi-envelope ic"></i>
                        <input type="email" name="_username" value="{{ last_username }}"
                               placeholder="exemple@email.com" required autofocus>
                    </div>
                </div>
                <div class="field">
                    <label>Mot de passe</label>
                    <div class="inp-w">
                        <i class="bi bi-lock ic"></i>
                        <input type="password" name="_password" id="pwd" placeholder="••••••••" required>
                        <button type="button" class="eye-btn" onclick="togglePwd('pwd','eye1')">
                            <i class="bi bi-eye" id="eye1"></i>
                        </button>
                    </div>
                </div>
                <div class="opts-row">
                    <label class="chk-lbl">
                        <input type="checkbox" name="_remember_me"> Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password') }}" class="forgot-lnk">Mot de passe oublié ?</a>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn-submit">
                    <i class="bi bi-box-arrow-in-right"></i> Se connecter
                </button>
            </form>

            <div class="bottom-txt">
                <p>Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
                <a href="{{ path('app_home') }}" style="display:inline-flex;align-items:center;gap:.3rem;font-size:.79rem;color:#9ca3af;text-decoration:none;margin-top:.5rem">
                    <i class="bi bi-arrow-left"></i> Retour à l'accueil
                </a>
            </div>
        </div>
    </div>

    <script>
        function togglePwd(id, ico) {
            const i = document.getElementById(id);
            const ic = document.getElementById(ico);
            const v = i.type === 'password';
            i.type = v ? 'text' : 'password';
            ic.className = v ? 'bi bi-eye-slash' : 'bi bi-eye';
        }
    </script>
</body>
</html>
