{% extends 'base.html.twig' %}

{% block title %}Détails de la Sortie #{{ exit.id }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    :root {
        --glass-bg: rgba(255,255,255,0.05);
        --glass-border: rgba(255,255,255,0.1);
        --glass-shadow: 0 8px 32px rgba(0,0,0,0.4);
        --text-primary: #e2e8f0;
        --text-muted: #94a3b8;
    }
    body { background: #0f172a; color: var(--text-primary); }
    .glass {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 1rem;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: var(--glass-shadow);
        padding: 1.5rem;
    }
    .glass .card-title { color: #f8fafc; font-weight: 600; }
    .info-label { color: var(--text-muted); font-size: .85rem; margin-bottom: .15rem; }
    .info-value { color: var(--text-primary); font-weight: 500; font-size: 1.05rem; }
    .btn-glass {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        color: var(--text-primary);
        backdrop-filter: blur(8px);
    }
    .btn-glass:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .modal-content.glass-modal {
        background: #1e293b;
        border: 1px solid var(--glass-border);
        color: var(--text-primary);
    }
    .glass-modal .btn-close { filter: invert(1); }
    .glass-modal textarea {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--glass-border);
        color: var(--text-primary);
    }
    .glass-modal textarea:focus {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.2);
        color: #fff;
        box-shadow: none;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    {# Header #}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <a href="{{ path('app_stock_exit_index') }}" class="btn btn-glass">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <h3 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i>Détails de la Sortie</h3>
        <div style="width:90px"></div>
    </div>

    {# Rejection alert #}
    {% if exit.status.value == 'rejected' and exit.rejectionReason %}
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div><strong>Motif du rejet :</strong> {{ exit.rejectionReason }}</div>
        </div>
    {% endif %}

    <div class="row g-4">
        {# General info #}
        <div class="col-lg-6">
            <div class="glass h-100">
                <h5 class="card-title mb-3"><i class="bi bi-info-circle me-2"></i>Informations Générales</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="info-label">Code opération</div>
                        <div class="info-value">{{ exit.bonLivraisonNumber ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Date</div>
                        <div class="info-value">{{ exit.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Client</div>
                        <div class="info-value">{{ exit.stockItem.client.companyName }}</div>
                        <small class="text-muted">{{ exit.stockItem.client.email }}</small>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Statut</div>
                        <div>
                            {% if exit.status.value == 'validated' %}
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Validée</span>
                            {% elseif exit.status.value == 'rejected' %}
                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejetée</span>
                            {% else %}
                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>En attente</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Quantité sortie</div>
                        <div class="info-value">{{ exit.quantityTons * 1000 }} kg <small class="text-muted">({{ exit.quantityTons }} T)</small></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Jours de stockage</div>
                        <div class="info-value">{{ exit.storageDays }} jour{{ exit.storageDays > 1 ? 's' : '' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Créé par</div>
                        <div class="info-value">{{ exit.createdBy.fullName }}</div>
                    </div>
                    {% if exit.isValidated and exit.validatedBy %}
                        <div class="col-sm-6">
                            <div class="info-label">Validé par</div>
                            <div class="info-value">{{ exit.validatedBy.fullName }}</div>
                            <small class="text-muted">{{ exit.validatedAt|date('d/m/Y H:i') }}</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Palette info #}
        <div class="col-lg-6">
            <div class="glass h-100">
                <h5 class="card-title mb-3"><i class="bi bi-box-seam me-2"></i>Informations Palette</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="info-label">Code palette</div>
                        <div class="info-value">{{ exit.stockItem.paletteCode }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Produit</div>
                        <div class="info-value">{{ exit.stockItem.productName }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Chambre froide</div>
                        <div class="info-value">{{ exit.stockItem.coldRoom.name }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Rack</div>
                        <div class="info-value">{{ exit.stockItem.rackCode }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Quantité initiale</div>
                        <div class="info-value">{{ exit.stockItem.quantityTons }} T</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-label">Date d'entrée</div>
                        <div class="info-value">{{ exit.stockItem.entryDate|date('d/m/Y') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Actions #}
    <div class="d-flex gap-2 mt-4 flex-wrap">
        {% if exit.isPending and is_granted('STOCK_EXIT_VALIDATE') %}
            <form method="post" action="{{ path('app_stock_exit_validate', {id: exit.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ exit.id) }}">
                <button type="submit" class="btn btn-success" onclick="return confirm('Confirmer la validation ?')">
                    <i class="bi bi-check-lg me-1"></i> Valider
                </button>
            </form>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                <i class="bi bi-x-lg me-1"></i> Rejeter
            </button>
        {% endif %}

        {% if exit.isValidated %}
            <a href="{{ path('app_stock_exit_bon_livraison', {id: exit.id}) }}" class="btn btn-glass" target="_blank">
                <i class="bi bi-file-earmark-pdf me-1"></i> Bon de livraison
            </a>
        {% endif %}
    </div>
</div>

{# Reject modal #}
{% if exit.isPending and is_granted('STOCK_EXIT_VALIDATE') %}
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content glass-modal">
            <form method="post" action="{{ path('app_stock_exit_reject', {id: exit.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ exit.id) }}">
                <div class="modal-header border-0">
                    <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Rejeter la sortie</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <label for="rejectionReason" class="form-label">Motif du rejet</label>
                    <textarea class="form-control" id="rejectionReason" name="rejectionReason" rows="3" required placeholder="Saisissez le motif du rejet..."></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Confirmer le rejet</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
