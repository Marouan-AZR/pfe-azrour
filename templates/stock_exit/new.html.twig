{% extends 'base.html.twig' %}

{% block title %}Nouvelle Sortie de Stock{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {# Header #}
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('app_stock_exit_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <div>
            <h2 class="mb-0">Préparation de Sortie</h2>
            <small class="text-muted">Chef de Stock – Sélection des palettes à sortir</small>
        </div>
    </div>

    <form method="post" id="exitForm">
        <input type="hidden" name="client" value="{{ selectedClient ? selectedClient.id : '' }}">

        {# ===== Étape 1 : Sélection du client ===== #}
        <div class="form-section mb-4">
            <div class="section-header">
                <span class="section-icon" style="background: rgba(99,102,241,0.15);">👤</span>
                <div>
                    <h5 class="mb-0">1. Sélection du Client</h5>
                    <small class="text-muted">Choisir le client pour afficher son stock disponible</small>
                </div>
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Client *</label>
                    <select class="form-select" id="clientSelect" onchange="window.location.href='{{ path('app_stock_exit_new') }}?client='+this.value">
                        <option value="">-- Sélectionner un client --</option>
                        {% for client in clients %}
                            <option value="{{ client.id }}" {{ selectedClient and selectedClient.id == client.id ? 'selected' : '' }}>
                                {{ client.companyName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                {% if selectedClient %}
                <div class="col-md-6">
                    <div class="d-flex gap-4">
                        <div>
                            <small class="text-muted d-block">Client</small>
                            <strong>{{ selectedClient.companyName }}</strong>
                        </div>
                        <div>
                            <small class="text-muted d-block">Palettes disponibles</small>
                            <strong class="text-primary">{{ stockItems|length }}</strong>
                        </div>
                        <div>
                            <small class="text-muted d-block">Stock total</small>
                            <strong class="text-success">
                                {% set totalDisponible = 0 %}
                                {% for item in stockItems %}
                                    {% set totalDisponible = totalDisponible + item.remainingQuantity %}
                                {% endfor %}
                                {{ (totalDisponible * 1000)|number_format(0, ',', ' ') }} kg
                            </strong>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {% if selectedClient %}
        {# ===== Étape 2 : Tableau des palettes à sortir ===== #}
        <div class="form-section mb-4">
            <div class="section-header">
                <span class="section-icon" style="background: rgba(14,165,233,0.15);">📦</span>
                <div>
                    <h5 class="mb-0">2. Palettes disponibles pour {{ selectedClient.companyName }}</h5>
                    <small class="text-muted">Cocher les palettes à inclure dans la sortie</small>
                </div>
            </div>

            {% if stockItems|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="palettesTable">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 50px;">
                                <input type="checkbox" class="form-check-input" id="selectAll" title="Tout sélectionner">
                            </th>
                            <th>Code Palette</th>
                            <th>Espèce</th>
                            <th>Qualité</th>
                            <th>Moule</th>
                            <th class="text-center">N° Cartons</th>
                            <th class="text-end">Poids (kg)</th>
                            <th>Chambre</th>
                            <th>Rayon</th>
                            <th>Date d'entrée</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in stockItems %}
                        {% set entry = item.stockEntry %}
                        {% set remainKg = (item.remainingQuantity * 1000)|number_format(0, ',', ' ') %}
                        {% set cartonsRestants = entry.nombreCartons ?? 0 %}
                        <tr class="palette-row">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input palette-check"
                                       name="palettes[]" value="{{ item.id }}"
                                       data-kg="{{ item.remainingQuantity * 1000 }}"
                                       data-cartons="{{ cartonsRestants }}">
                            </td>
                            <td><code class="fw-bold">{{ entry.codePalette ?? 'PAL-' ~ item.id }}</code></td>
                            <td class="fw-semibold">{{ item.productName }}</td>
                            <td>{{ entry.qualite ?? '—' }}</td>
                            <td>{{ entry.moule ?? '—' }}</td>
                            <td class="text-center">{{ cartonsRestants }}</td>
                            <td class="text-end fw-bold">{{ remainKg }} kg</td>
                            <td><span class="badge bg-info bg-opacity-25 text-info">{{ item.coldRoom.name }}</span></td>
                            <td>{{ entry.rayon ?? '—' }}</td>
                            <td>{{ item.entryDate|date('d/m/Y') }}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Voir détails"
                                        data-bs-toggle="modal" data-bs-target="#detailModal{{ item.id }}">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                <p class="mt-2">Aucune palette disponible pour ce client</p>
            </div>
            {% endif %}
        </div>

        {# ===== Étape 3 : Contrôleur responsable ===== #}
        <div class="form-section mb-4">
            <div class="section-header">
                <span class="section-icon" style="background: rgba(139,92,246,0.15);">👥</span>
                <div>
                    <h5 class="mb-0">3. Contrôleur(s) responsable(s)</h5>
                    <small class="text-muted">Assigner le ou les contrôleurs pour cette sortie</small>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contrôleur(s)</label>
                    <select class="form-select" name="controleurs[]" multiple size="4">
                        {% for user in controleurs %}
                            <option value="{{ user.id }}">{{ user.fullName }} ({{ user.email }})</option>
                        {% endfor %}
                    </select>
                    <small class="text-muted">Maintenez Ctrl/Cmd pour sélectionner plusieurs</small>
                </div>
            </div>
        </div>

        {# ===== Indicateurs dynamiques ===== #}
        <div class="card mb-4" id="totalsCard" style="display: none;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-calculator"></i>
                    <strong>Totaux sélectionnés</strong>
                </div>
                <div class="row g-3 text-center">
                    <div class="col-md-3">
                        <div class="p-3 rounded" style="background: rgba(99,102,241,0.1);">
                            <div class="text-muted small">Palettes</div>
                            <div class="fs-4 fw-bold text-primary" id="totalPalettes">0</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded" style="background: rgba(14,165,233,0.1);">
                            <div class="text-muted small">Cartons</div>
                            <div class="fs-4 fw-bold text-info" id="totalCartons">0</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded" style="background: rgba(16,185,129,0.1);">
                            <div class="text-muted small">Poids (kg)</div>
                            <div class="fs-4 fw-bold text-success" id="totalKg">0</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded" style="background: rgba(245,158,11,0.1);">
                            <div class="text-muted small">Poids (T)</div>
                            <div class="fs-4 fw-bold text-warning" id="totalTonnes">0.000</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ===== Boutons d'action ===== #}
        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-success btn-lg" id="submitBtn" disabled>
                <i class="bi bi-check-circle"></i> Générer fiche / Enregistrer sortie
            </button>
            <button type="button" class="btn btn-outline-secondary btn-lg" id="resetBtn">
                <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
            </button>
            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-danger btn-lg">
                <i class="bi bi-x-lg"></i> Annuler
            </a>
        </div>
        {% endif %}
    </form>
</div>

{# ===== Modals détails palette ===== #}
{% if selectedClient is defined and selectedClient %}
{% for item in stockItems %}
{% set entry = item.stockEntry %}
<div class="modal fade" id="detailModal{{ item.id }}" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Détails palette {{ entry.codePalette ?? 'PAL-' ~ item.id }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-sm">
                    <tr><td class="text-muted">Code palette</td><td class="fw-bold">{{ entry.codePalette ?? 'PAL-' ~ item.id }}</td></tr>
                    <tr><td class="text-muted">Client</td><td>{{ item.client.companyName }}</td></tr>
                    <tr><td class="text-muted">Produit</td><td class="fw-bold">{{ item.productName }}</td></tr>
                    <tr><td class="text-muted">Famille</td><td>{{ entry.famille ?? '—' }}</td></tr>
                    <tr><td class="text-muted">Qualité</td><td>{{ entry.qualite ?? '—' }}</td></tr>
                    <tr><td class="text-muted">Moule</td><td>{{ entry.moule ?? '—' }}</td></tr>
                    <tr><td class="text-muted">Cartons</td><td>{{ entry.nombreCartons ?? '—' }}</td></tr>
                    <tr><td class="text-muted">Poids disponible</td><td class="fw-bold text-success">{{ (item.remainingQuantity * 1000)|number_format(0) }} kg</td></tr>
                    <tr><td class="text-muted">Chambre</td><td>{{ item.coldRoom.name }}</td></tr>
                    <tr><td class="text-muted">Rayon</td><td>{{ entry.rayon ?? '—' }}</td></tr>
                    <tr><td class="text-muted">Date d'entrée</td><td>{{ item.entryDate|date('d/m/Y') }}</td></tr>
                    <tr><td class="text-muted">Jours stockage</td><td>{{ item.storageDays }} jours</td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endif %}

<style>
.form-section {
    background: var(--glass-bg, #fff);
    border: 1px solid var(--glass-border, #e2e8f0);
    border-radius: 16px;
    padding: 1.75rem;
}
.section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--glass-border, #e2e8f0);
}
.section-icon {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; flex-shrink: 0;
}
.palette-row { transition: background 0.2s ease; }
.palette-row:hover { background: rgba(99,102,241,0.05) !important; }
.palette-row.selected { background: rgba(16,185,129,0.08) !important; }
</style>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const checks = document.querySelectorAll('.palette-check');
    const selectAll = document.getElementById('selectAll');
    const totalsCard = document.getElementById('totalsCard');
    const submitBtn = document.getElementById('submitBtn');
    const resetBtn = document.getElementById('resetBtn');

    function updateTotals() {
        let palettes = 0, cartons = 0, kg = 0;
        checks.forEach(cb => {
            if (cb.checked) {
                palettes++;
                cartons += parseInt(cb.dataset.cartons) || 0;
                kg += parseFloat(cb.dataset.kg) || 0;
            }
            cb.closest('tr').classList.toggle('selected', cb.checked);
        });
        document.getElementById('totalPalettes').textContent = palettes;
        document.getElementById('totalCartons').textContent = cartons.toLocaleString('fr-FR');
        document.getElementById('totalKg').textContent = Math.round(kg).toLocaleString('fr-FR');
        document.getElementById('totalTonnes').textContent = (kg / 1000).toFixed(3);
        totalsCard.style.display = palettes > 0 ? '' : 'none';
        submitBtn.disabled = palettes === 0;
    }

    checks.forEach(cb => cb.addEventListener('change', updateTotals));

    if (selectAll) {
        selectAll.addEventListener('change', function() {
            checks.forEach(cb => { cb.checked = selectAll.checked; });
            updateTotals();
        });
    }

    if (resetBtn) {
        resetBtn.addEventListener('click', function() {
            checks.forEach(cb => { cb.checked = false; });
            if (selectAll) selectAll.checked = false;
            updateTotals();
        });
    }
});
</script>
{% endblock %}
{% endblock %}
