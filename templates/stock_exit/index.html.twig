{% extends 'base.html.twig' %}

{% block title %}Sorties de Stock{% endblock %}

{% block body %}
<style>
    .kpi-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        text-align: center;
        
        transition: transform .2s, box-shadow .2s;
    }
    .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.3); }
    .kpi-card .kpi-value { font-size: 1.75rem; font-weight: 700; color: var(--primary); }
    .kpi-card .kpi-label { font-size: .85rem; color: var(--text-muted); margin-top: .25rem; }
    .exit-row { transition: background .15s; }
    .exit-row:hover { background: var(--glass-border) !important; }
</style>

<div class="container-fluid py-4">

    {# Flash messages #}
    {% for type in ['success', 'error'] %}
        {% for msg in app.flashes(type) %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                <i class="bi bi-{{ type == 'success' ? 'check-circle' : 'exclamation-triangle' }} me-2"></i>{{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1" style="color:var(--text)"><i class="bi bi-box-arrow-up-right me-2"></i>Sorties de Stock</h2>
            <p class="mb-0" style="color:var(--text-muted)">Gestion et suivi des sorties de stock</p>
        </div>
        {% if is_granted('STOCK_EXIT_CREATE') %}
            <a href="{{ path('app_stock_exit_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle sortie</a>
        {% endif %}
    </div>

    {# KPI Cards #}
    {% set pendingCount = exits|filter(e => e.status.value == 'pending')|length %}
    {% set validatedExits = exits|filter(e => e.status.value == 'validated') %}
    {% set validatedCount = validatedExits|length %}
    {% set totalTons = 0 %}
    {% set totalDays = 0 %}
    {% for e in validatedExits %}
        {% set totalTons = totalTons + e.quantityTons %}
        {% set totalDays = totalDays + e.storageDays %}
    {% endfor %}
    {% set avgDays = validatedCount > 0 ? (totalDays / validatedCount)|round(1) : 0 %}

    <div class="row g-3 mb-4">
        <div class="col">
            <div class="kpi-card">
                <div class="kpi-value">{{ exits|length }}</div>
                <div class="kpi-label"><i class="bi bi-box-arrow-up-right me-1"></i>Total sorties</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card">
                <div class="kpi-value" style="color:#f0ad4e">{{ pendingCount }}</div>
                <div class="kpi-label"><i class="bi bi-hourglass-split me-1"></i>En attente</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card">
                <div class="kpi-value" style="color:#198754">{{ validatedCount }}</div>
                <div class="kpi-label"><i class="bi bi-check-circle me-1"></i>Validées</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card">
                {% set kg = (totalTons * 1000)|round(0) %}
                <div class="kpi-value">{{ totalTons|number_format(2) }} T</div>
                <div class="kpi-label"><i class="bi bi-speedometer me-1"></i>Poids total ({{ kg }} kg)</div>
            </div>
        </div>
        <div class="col">
            <div class="kpi-card">
                <div class="kpi-value">{{ avgDays }}</div>
                <div class="kpi-label"><i class="bi bi-calendar-range me-1"></i>Jours stockage moyen</div>
            </div>
        </div>
    </div>

    {# Filters #}
    <div class="card mb-4" style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius)">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <div class="flex-grow-1">
                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par client, produit, BL..." style="background:transparent;border-color:var(--glass-border);color:var(--text)">
            </div>
            <div class="btn-group" role="group" id="statusFilter">
                <button type="button" class="btn btn-outline-primary active" data-filter="all">Tous</button>
                <button type="button" class="btn btn-outline-warning" data-filter="pending">En attente</button>
                <button type="button" class="btn btn-outline-success" data-filter="validated">Validé</button>
            </div>
        </div>
    </div>

    {# Table #}
    {% if exits|length > 0 %}
        <div class="table-responsive" style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius)">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr style="color:var(--text-muted)">
                        <th>BL N°</th>
                        <th>Date et Heure</th>
                        <th>Client</th>
                        <th>Produit</th>
                        <th>Quantité</th>
                        <th>Jours stockage</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for exit in exits %}
                        <tr class="exit-row" data-search="{{ exit.bonLivraisonNumber ?? '' }} {{ exit.stockItem.client.companyName|lower }} {{ exit.stockItem.productName|lower }}" data-status="{{ exit.status.value }}">
                            <td class="fw-semibold">{{ exit.bonLivraisonNumber ?? 'SRT-' ~ exit.id }}</td>
                            <td>
                                {{ exit.createdAt|date('d/m/Y') }}
                                <small class="text-muted d-block">{{ exit.createdAt|date('H:i:s') }}</small>
                            </td>
                            <td>{{ exit.stockItem.client.companyName }}</td>
                            <td>{{ exit.stockItem.productName }}</td>
                            <td>
                                {{ (exit.quantityTons * 1000)|number_format(0) }} kg
                                <small class="text-muted d-block">{{ exit.quantityTons }} T</small>
                            </td>
                            <td>{{ exit.storageDays }} j</td>
                            <td>
                                {% if exit.status.value == 'pending' %}
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>En attente</span>
                                {% elseif exit.status.value == 'validated' %}
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Validé</span>
                                {% elseif exit.status.value == 'rejected' %}
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejeté</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a href="{{ path('app_stock_exit_show', {id: exit.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Voir détails</a>
                                    {% if exit.isPending and is_granted('STOCK_EXIT_VALIDATE') %}
                                        <form action="{{ path('app_stock_exit_validate', {id: exit.id}) }}" method="post" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ exit.id) }}">
                                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Valider</button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal{{ exit.id }}"><i class="bi bi-x-lg me-1"></i>Rejeter</button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Reject Modals #}
        {% for exit in exits %}
            {% if exit.isPending %}
                <div class="modal fade" id="rejectModal{{ exit.id }}" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content" style="background:var(--glass-bg);border:1px solid var(--glass-border);color:var(--text)">
                            <form action="{{ path('app_stock_exit_reject', {id: exit.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ exit.id) }}">
                                <div class="modal-header border-0">
                                    <h5 class="modal-title"><i class="bi bi-x-circle text-danger me-2"></i>Rejeter la sortie</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted">Sortie <strong>{{ exit.bonLivraisonNumber ?? 'SRT-' ~ exit.id }}</strong> — {{ exit.stockItem.productName }}</p>
                                    <label for="reason{{ exit.id }}" class="form-label">Motif du rejet</label>
                                    <textarea id="reason{{ exit.id }}" name="reason" class="form-control" rows="3" required style="background:transparent;border-color:var(--glass-border);color:var(--text)" placeholder="Indiquez le motif du rejet..."></textarea>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Confirmer le rejet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}

    {% else %}
        {# Empty state #}
        <div class="text-center py-5" style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius)">
            <i class="bi bi-inbox display-1" style="color:var(--text-muted)"></i>
            <h4 class="mt-3" style="color:var(--text)">Aucune sortie de stock</h4>
            <p style="color:var(--text-muted)">Les sorties de stock apparaîtront ici une fois créées.</p>
            {% if is_granted('STOCK_EXIT_CREATE') %}
                <a href="{{ path('app_stock_exit_new') }}" class="btn btn-primary mt-2"><i class="bi bi-plus-lg me-1"></i>Nouvelle sortie</a>
            {% endif %}
        </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const rows = document.querySelectorAll('.exit-row');
    const searchInput = document.getElementById('searchInput');
    const filterBtns = document.querySelectorAll('#statusFilter button');
    let activeStatus = 'all';

    function applyFilters() {
        const q = searchInput.value.toLowerCase();
        rows.forEach(r => {
            const matchSearch = !q || r.dataset.search.toLowerCase().includes(q);
            const matchStatus = activeStatus === 'all' || r.dataset.status === activeStatus;
            r.style.display = matchSearch && matchStatus ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', applyFilters);

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            activeStatus = this.dataset.filter;
            applyFilters();
        });
    });
});
</script>
{% endblock %}
