{% extends 'base.html.twig' %}
{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
<style>
.profile-card {
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:1rem;
    box-shadow:0 4px 24px rgba(0,0,0,.06);
    overflow:hidden;
}
.profile-banner {
    background:linear-gradient(135deg,#1e40af 0%,#6366f1 100%);
    height:110px;
    position:relative;
}
.profile-avatar-wrap {
    position:absolute;
    bottom:-40px;
    left:50%;
    transform:translateX(-50%);
}
.profile-avatar {
    width:80px; height:80px;
    background:#fff;
    border-radius:50%;
    border:4px solid #fff;
    box-shadow:0 4px 16px rgba(0,0,0,.15);
    display:flex; align-items:center; justify-content:center;
    font-size:2rem;
    color:#6366f1;
    font-weight:800;
}
.profile-name {
    margin-top:50px;
    text-align:center;
    font-size:1.1rem;
    font-weight:700;
    color:#0f172a;
}
.profile-role {
    text-align:center;
    font-size:.76rem;
    color:#64748b;
    margin-top:.1rem;
    margin-bottom:1.25rem;
}
.profile-role span {
    background:#eff6ff;
    color:#2563eb;
    border:1px solid #bfdbfe;
    border-radius:50px;
    padding:.18em .8em;
    font-weight:600;
    letter-spacing:.04em;
}
.profile-meta {
    display:flex;
    justify-content:center;
    gap:2rem;
    padding:.75rem 0;
    border-top:1px solid #f1f5f9;
    border-bottom:1px solid #f1f5f9;
    margin:0 1.5rem 1.5rem;
}
.profile-meta-item { text-align:center; }
.profile-meta-item .val { font-size:.9rem; font-weight:700; color:#0f172a; }
.profile-meta-item .lbl { font-size:.68rem; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; }

/* Formulaires */
.section-header {
    display:flex; align-items:center; gap:.5rem;
    font-size:.8rem; font-weight:700; text-transform:uppercase;
    letter-spacing:.07em; color:#64748b;
    margin-bottom:1rem;
    padding-bottom:.5rem;
    border-bottom:1px solid #f1f5f9;
}
.form-label { font-size:.82rem; font-weight:600; color:#374151; margin-bottom:.3rem; }
.form-control {
    border:1.5px solid #e2e8f0;
    border-radius:.6rem;
    font-size:.87rem;
    padding:.55rem .9rem;
    transition:border-color .2s, box-shadow .2s;
}
.form-control:focus {
    border-color:#6366f1;
    box-shadow:0 0 0 3px rgba(99,102,241,.12);
}
.input-group .form-control { border-right:none; }
.input-group .btn-toggle-pw {
    border:1.5px solid #e2e8f0;
    border-left:none;
    border-radius:0 .6rem .6rem 0;
    background:#f8fafc;
    color:#94a3b8;
    padding:.55rem .85rem;
    cursor:pointer;
    transition:color .2s;
}
.input-group .btn-toggle-pw:hover { color:#6366f1; }

.pw-strength { height:4px; border-radius:50px; margin-top:.35rem; transition:all .3s; }
.pw-strength-label { font-size:.72rem; margin-top:.25rem; }

.btn-save {
    background:linear-gradient(135deg,#6366f1,#4f46e5);
    color:#fff; border:none; border-radius:.65rem;
    padding:.6rem 1.5rem; font-size:.85rem; font-weight:600;
    box-shadow:0 4px 12px rgba(99,102,241,.3);
    transition:transform .18s, box-shadow .18s;
}
.btn-save:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(99,102,241,.35); color:#fff; }

.btn-danger-outline {
    background:#fff; color:#ef4444;
    border:1.5px solid #fecaca;
    border-radius:.65rem;
    padding:.6rem 1.5rem; font-size:.85rem; font-weight:600;
    transition:all .18s;
}
.btn-danger-outline:hover { background:#fee2e2; border-color:#ef4444; color:#b91c1c; }

.info-row {
    display:flex; align-items:center; gap:.6rem;
    padding:.5rem .75rem;
    background:#f8fafc;
    border-radius:.5rem;
    margin-bottom:.5rem;
    font-size:.83rem;
}
.info-row i { color:#6366f1; flex-shrink:0; }
.info-row .lbl { color:#94a3b8; font-size:.73rem; min-width:90px; }
.info-row .val { font-weight:600; color:#0f172a; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">

    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
        <h5 class="mb-0 fw-bold">Mon profil</h5>
    </div>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
        {% if type == 'dev_link' %}
        <div class="alert d-flex align-items-start gap-2 mb-3" style="background:#fef9c3;border:1px solid #fde047;color:#713f12;border-radius:.75rem" role="alert">
            <i class="bi bi-bug-fill mt-1" style="flex-shrink:0"></i>
            <div>
                <div class="fw-bold mb-1" style="font-size:.82rem">Mode DEV — lien de réinitialisation (email non envoyé)</div>
                <a href="{{ message }}" style="word-break:break-all;font-size:.78rem;color:#1d4ed8">{{ message }}</a>
            </div>
        </div>
        {% else %}
        <div class="alert alert-{{ type == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-{{ type == 'danger' ? 'exclamation-triangle-fill' : 'check-circle-fill' }}"></i>
            {{ message }}
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
        {% endif %}
        {% endfor %}
    {% endfor %}

    <div class="row g-4">

        {# ── Colonne gauche : carte profil + infos ── #}
        <div class="col-lg-4">

            {# Carte identité #}
            <div class="profile-card mb-4">
                <div class="profile-banner">
                    <div class="profile-avatar-wrap">
                        <div class="profile-avatar">
                            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                        </div>
                    </div>
                </div>
                <div class="profile-name">{{ app.user.fullName }}</div>
                <div class="profile-role">
                    <span>
                        {% set role = app.user.roles|filter(r => r != 'ROLE_USER')|first %}
                        {% if role == 'ROLE_CHEF_STOCK' %}Chef de stock
                        {% elseif role == 'ROLE_CONTROLEUR' %}Contrôleur
                        {% elseif role == 'ROLE_DIRECTEUR' %}Directeur
                        {% elseif role == 'ROLE_PATRON' %}Patron
                        {% elseif role == 'ROLE_CLIENT' %}Client
                        {% else %}Utilisateur{% endif %}
                    </span>
                </div>
                <div class="profile-meta">
                    <div class="profile-meta-item">
                        <div class="val">{{ app.user.createdAt|date('d/m/Y') }}</div>
                        <div class="lbl">Membre depuis</div>
                    </div>
                    <div class="profile-meta-item">
                        <div class="val">{{ app.user.isActive ? '✓ Actif' : '✗ Inactif' }}</div>
                        <div class="lbl">Statut</div>
                    </div>
                </div>
            </div>

            {# Informations en lecture seule #}
            <div class="profile-card p-4">
                <div class="section-header">
                    <i class="bi bi-info-circle-fill" style="color:#6366f1"></i>
                    Informations du compte
                </div>
                <div class="info-row">
                    <i class="bi bi-person-badge"></i>
                    <span class="lbl">Identifiant</span>
                    <span class="val">#{{ app.user.id }}</span>
                </div>
                <div class="info-row">
                    <i class="bi bi-calendar3"></i>
                    <span class="lbl">Créé le</span>
                    <span class="val">{{ app.user.createdAt|date('d/m/Y à H:i') }}</span>
                </div>
                <div class="info-row">
                    <i class="bi bi-pencil-square"></i>
                    <span class="lbl">Modifié le</span>
                    <span class="val">{{ app.user.updatedAt|date('d/m/Y à H:i') }}</span>
                </div>
                <div class="info-row">
                    <i class="bi bi-shield-check"></i>
                    <span class="lbl">Rôle</span>
                    <span class="val">
                        {% set role = app.user.roles|filter(r => r != 'ROLE_USER')|first %}
                        {{ role|replace({'ROLE_': ''})|replace({'_': ' '})|capitalize }}
                    </span>
                </div>
                {% if app.user.phone %}
                <div class="info-row">
                    <i class="bi bi-telephone"></i>
                    <span class="lbl">Téléphone</span>
                    <span class="val">{{ app.user.phone }}</span>
                </div>
                {% endif %}
            </div>

        </div>

        {# ── Colonne droite : formulaires ── #}
        <div class="col-lg-8">

            {# Formulaire informations personnelles #}
            <div class="profile-card p-4 mb-4">
                <div class="section-header">
                    <i class="bi bi-person-fill" style="color:#6366f1"></i>
                    Informations personnelles
                </div>
                <form method="post" action="{{ path('app_profile_update') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_update') }}">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Prénom <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-person" style="color:#6366f1"></i>
                                </span>
                                <input type="text" name="firstName" class="form-control" style="border-radius:0 .6rem .6rem 0"
                                       value="{{ app.user.firstName }}" required>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Nom <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-person" style="color:#6366f1"></i>
                                </span>
                                <input type="text" name="lastName" class="form-control" style="border-radius:0 .6rem .6rem 0"
                                       value="{{ app.user.lastName }}" required>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label">Adresse e-mail <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-envelope" style="color:#6366f1"></i>
                                </span>
                                <input type="email" name="email" class="form-control" style="border-radius:0 .6rem .6rem 0"
                                       value="{{ app.user.email }}" required>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label">Téléphone</label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-telephone" style="color:#6366f1"></i>
                                </span>
                                <input type="tel" name="phone" class="form-control" style="border-radius:0 .6rem .6rem 0"
                                       value="{{ app.user.phone ?? '' }}" placeholder="+212 6XX XXX XXX">
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn-save">
                            <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </div>

            {# Formulaire changement de mot de passe #}
            <div class="profile-card p-4">
                <div class="section-header">
                    <i class="bi bi-lock-fill" style="color:#ef4444"></i>
                    Changer le mot de passe
                </div>
                <form method="post" action="{{ path('app_profile_password') }}" id="pwForm">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_password') }}">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Mot de passe actuel <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-key" style="color:#ef4444"></i>
                                </span>
                                <input type="password" name="currentPassword" id="currentPassword"
                                       class="form-control" placeholder="Votre mot de passe actuel" required>
                                <button type="button" class="btn-toggle-pw" onclick="togglePw('currentPassword',this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Nouveau mot de passe <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-lock" style="color:#ef4444"></i>
                                </span>
                                <input type="password" name="newPassword" id="newPassword"
                                       class="form-control" placeholder="Min. 6 caractères" required
                                       oninput="checkStrength(this.value); checkMatch()">
                                <button type="button" class="btn-toggle-pw" onclick="togglePw('newPassword',this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="pw-strength" id="pwStrengthBar" style="background:#e2e8f0;width:0%"></div>
                            <div class="pw-strength-label text-secondary" id="pwStrengthLabel"></div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Confirmer le mot de passe <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border:1.5px solid #e2e8f0;border-right:none;border-radius:.6rem 0 0 .6rem;background:#f8fafc">
                                    <i class="bi bi-lock-fill" style="color:#ef4444"></i>
                                </span>
                                <input type="password" name="confirmPassword" id="confirmPassword"
                                       class="form-control" placeholder="Répéter le mot de passe" required
                                       oninput="checkMatch()">
                                <button type="button" class="btn-toggle-pw" onclick="togglePw('confirmPassword',this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="pw-strength-label" id="matchLabel"></div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
                        <button type="submit" form="resetPwForm" class="btn btn-link p-0" style="font-size:.82rem;color:#6b7280;text-decoration:none">
                            <i class="bi bi-question-circle me-1"></i>J'ai oublié mon mot de passe actuel
                        </button>
                        <button type="submit" form="pwForm" class="btn-danger-outline">
                            <i class="bi bi-shield-lock me-2"></i>Changer le mot de passe
                        </button>
                    </div>
                </form>
                <form id="resetPwForm" method="post" action="{{ path('app_profile_reset_password') }}" style="display:none">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_reset_password') }}">
                </form>
            </div>

        </div>
    </div>
</div>

<script>
function togglePw(id, btn) {
    const input = document.getElementById(id);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

function checkStrength(val) {
    const bar   = document.getElementById('pwStrengthBar');
    const label = document.getElementById('pwStrengthLabel');
    let score = 0;
    if (val.length >= 6)  score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const levels = [
        { w:'20%',  bg:'#ef4444', lbl:'Très faible' },
        { w:'40%',  bg:'#f97316', lbl:'Faible' },
        { w:'60%',  bg:'#f59e0b', lbl:'Moyen' },
        { w:'80%',  bg:'#10b981', lbl:'Fort' },
        { w:'100%', bg:'#059669', lbl:'Très fort' },
    ];
    const lvl = levels[Math.min(score, 4)];
    bar.style.width      = val.length ? lvl.w  : '0%';
    bar.style.background = lvl.bg;
    label.textContent    = val.length ? lvl.lbl : '';
    label.style.color    = lvl.bg;
}

function checkMatch() {
    const nw  = document.getElementById('newPassword').value;
    const cf  = document.getElementById('confirmPassword').value;
    const lbl = document.getElementById('matchLabel');
    if (!cf) { lbl.textContent = ''; return; }
    if (nw === cf) {
        lbl.textContent = '✓ Les mots de passe correspondent';
        lbl.style.color = '#10b981';
    } else {
        lbl.textContent = '✗ Les mots de passe ne correspondent pas';
        lbl.style.color = '#ef4444';
    }
}
</script>
{% endblock %}
