<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Ticket {{ entry.codePalette ?? 'PLT-' ~ entry.id }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; background: #f1f5f9; padding: 2rem; }
        .ticket { max-width: 800px; margin: 0 auto; background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; }
        .ticket-header { padding: 2rem; border-bottom: 4px solid #0ea5e9; }
        .ticket-header h1 { font-size: 1.8rem; font-weight: 800; color: #0f172a; margin: 0; }
        .ticket-header .subtitle { color: #64748b; font-size: 0.9rem; }
        .ticket-number { color: #0ea5e9; font-weight: 800; font-size: 1.5rem; }
        .ticket-number small { display: block; color: #94a3b8; font-size: 0.75rem; font-weight: 500; }
        .qr-section { text-align: center; padding: 2rem; background: #f8fafc; border: 1px dashed #e2e8f0; margin: 1.5rem; border-radius: 12px; }
        .qr-section img { max-width: 180px; }
        .qr-section p { color: #64748b; font-size: 0.85rem; margin-top: 0.75rem; }
        .info-section { padding: 0 2rem 2rem; }
        .info-block { margin-bottom: 1.5rem; }
        .info-block-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding-left: 0.75rem; margin-bottom: 0.75rem; }
        .info-block-title.blue { color: #0ea5e9; border-left: 3px solid #0ea5e9; }
        .info-block-title.orange { color: #f59e0b; border-left: 3px solid #f59e0b; }
        .info-block-title.green { color: #10b981; border-left: 3px solid #10b981; }
        .info-block-title.teal { color: #14b8a6; border-left: 3px solid #14b8a6; }
        .info-value { font-size: 1.1rem; font-weight: 700; color: #0f172a; }
        .info-label { font-size: 0.8rem; color: #94a3b8; }
        .quantity-box { background: #fff7ed; border-radius: 10px; padding: 1rem; text-align: center; }
        .quantity-box .value { font-size: 1.8rem; font-weight: 800; color: #ea580c; }
        .quantity-box .label { font-size: 0.75rem; color: #9a3412; }
        .location-box { background: #f0fdfa; border-radius: 10px; padding: 1rem; text-align: center; }
        .location-box .value { font-size: 1.8rem; font-weight: 800; color: #0d9488; }
        .location-box .label { font-size: 0.75rem; color: #115e59; }
        .btn-print { position: fixed; top: 1rem; right: 1rem; z-index: 100; }
        .btn-back { position: fixed; top: 1rem; left: 1rem; z-index: 100; }
        @media print {
            body { padding: 0; background: #fff; }
            .ticket { box-shadow: none; border-radius: 0; }
            .btn-print, .btn-back { display: none !important; }
        }
    </style>
</head>
<body>
    <a href="{{ path('app_stock_entry_show', {id: entry.id}) }}" class="btn btn-outline-secondary btn-sm btn-back">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
    <button onclick="window.print()" class="btn btn-primary btn-sm btn-print">
        🖨️ Imprimer
    </button>

    <div class="ticket">
        {# En-tête #}
        <div class="ticket-header d-flex justify-content-between align-items-start">
            <div>
                <h1>Golden Logistics</h1>
                <div class="subtitle">Entrepôt Frigorifique</div>
                <div class="subtitle">Système de Gestion de Stock</div>
                <div class="mt-2 text-muted" style="font-size: 0.85rem;">
                    Date d'émission : {{ "now"|date("d F Y") }} à {{ "now"|date("H:i") }}
                </div>
                <div class="text-muted" style="font-size: 0.85rem;">
                    N° Bon : {{ entry.bonReceptionNumber ?? '—' }}
                </div>
            </div>
            <div class="text-end">
                <div class="ticket-number">
                    <small>Ticket N°</small>
                    {{ entry.codePalette ?? 'PLT-' ~ entry.id }}
                </div>
            </div>
        </div>

        {# QR Code #}
        <div class="qr-section">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={{ entry.codePalette ?? 'PAL-' ~ entry.id }}" alt="QR Code">
            <p>Scanner pour identifier la palette</p>
        </div>

        {# Informations #}
        <div class="info-section">
            <div class="row g-4">
                {# Identification #}
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="info-block-title blue">IDENTIFICATION</div>
                        <div class="info-label">Code Palette</div>
                        <div class="info-value">{{ entry.codePalette ?? 'PLT-' ~ entry.id }}</div>
                        <div class="info-label mt-2">Code Lot Client</div>
                        <div class="info-value">{{ entry.cdLotClient ?? '—' }}</div>
                    </div>
                </div>

                {# Quantités #}
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="info-block-title orange">QUANTITÉS</div>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="quantity-box">
                                    <div class="label">Cartons</div>
                                    <div class="value">{{ entry.nombreCartons ?? '—' }}</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="quantity-box">
                                    <div class="label">Poids</div>
                                    <div class="value">{{ (entry.quantityTons * 1000)|number_format(0) }} kg</div>
                                    <div class="label">({{ entry.quantityTons|number_format(2) }} T)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Client #}
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="info-block-title green">CLIENT</div>
                        <div class="info-value">{{ entry.client.companyName }}</div>
                        <div class="text-muted" style="font-size: 0.85rem;">{{ entry.client.email ?? '' }}</div>
                    </div>
                </div>

                {# Localisation #}
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="info-block-title teal">LOCALISATION</div>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="location-box">
                                    <div class="label">Chambre</div>
                                    <div class="value">{{ entry.coldRoom.name }}</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="location-box">
                                    <div class="label">Rayon</div>
                                    <div class="value">{{ entry.rayon ?? '—' }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Produit #}
                <div class="col-12">
                    <div class="info-block">
                        <div class="info-block-title blue">PRODUIT</div>
                        <div class="row">
                            <div class="col-3"><span class="info-label">Espèce</span><br><strong>{{ entry.productName }}</strong></div>
                            <div class="col-3"><span class="info-label">Famille</span><br><strong>{{ entry.famille ?? '—' }}</strong></div>
                            <div class="col-3"><span class="info-label">Qualité</span><br><strong>{{ entry.qualite ?? '—' }}</strong></div>
                            <div class="col-3"><span class="info-label">Moule</span><br><strong>{{ entry.moule ?? '—' }}</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</body>
</html>
