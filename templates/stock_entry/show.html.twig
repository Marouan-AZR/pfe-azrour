{% extends 'base.html.twig' %}

{% block title %}Détails Opération {{ entry.bonReceptionNumber ?? 'ENT-' ~ entry.id }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {# Header avec bouton retour #}
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="{{ path('app_stock_entry_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <div>
            <h2 class="mb-0">Détails de l'Opération d'Entrée</h2>
            <small class="text-muted">Consultation des informations et palettes associées</small>
        </div>
    </div>

    {# ===== Informations générales de l'opération ===== #}
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-info-circle me-2"></i>Informations Générales
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3">
                    <small class="text-muted d-block">Code opération</small>
                    <strong class="fs-5"><code>{{ entry.bonReceptionNumber ?? 'ENT-' ~ entry.id }}</code></strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Date et Heure</small>
                    <strong>{{ entry.createdAt|date('d/m/Y H:i:s') }}</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Client</small>
                    <strong>{{ entry.client.companyName }}</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Statut</small>
                    {% if entry.status.value == 'pending' %}
                        <span class="badge rounded-pill fs-6" style="background: rgba(245,158,11,0.2); color: #f59e0b;">⏳ En attente</span>
                    {% elseif entry.status.value == 'validated' %}
                        <span class="badge rounded-pill fs-6" style="background: rgba(16,185,129,0.2); color: #10b981;">✅ Validé</span>
                    {% else %}
                        <span class="badge rounded-pill fs-6" style="background: rgba(239,68,68,0.2); color: #ef4444;">❌ Rejeté</span>
                    {% endif %}
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Nombre de Palettes</small>
                    <strong>1</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Total Cartons</small>
                    <strong>{{ entry.nombreCartons ?? '—' }}</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Poids Total</small>
                    <strong>{{ (entry.quantityTons * 1000)|number_format(0, ',', ' ') }} kg ({{ entry.quantityTons|number_format(2) }} T)</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Créé par</small>
                    <strong>{{ entry.createdBy.fullName }}</strong>
                </div>
            </div>
        </div>
    </div>

    {# ===== Liste des palettes ===== #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-palette2 me-2"></i>Palettes associées</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>N° Palette</th>
                            <th>N° Bon</th>
                            <th>Produit</th>
                            <th>Qualité</th>
                            <th>Moule</th>
                            <th class="text-center">Cartons</th>
                            <th class="text-end">Poids</th>
                            <th>Chambre</th>
                            <th>Rayon</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code class="fw-bold">{{ entry.codePalette ?? 'PAL-' ~ entry.id }}</code></td>
                            <td>{{ entry.bonReceptionNumber ?? '—' }}</td>
                            <td class="fw-semibold">{{ entry.productName }}</td>
                            <td>{{ entry.qualite ?? '—' }}</td>
                            <td>{{ entry.moule ?? '—' }}</td>
                            <td class="text-center">{{ entry.nombreCartons ?? '—' }}</td>
                            <td class="text-end">
                                <div>{{ (entry.quantityTons * 1000)|number_format(0, ',', ' ') }} kg</div>
                                <small class="text-muted">{{ entry.quantityTons|number_format(2) }} T</small>
                            </td>
                            <td><span class="badge bg-info bg-opacity-25 text-info">{{ entry.coldRoom.name }}</span></td>
                            <td>{{ entry.rayon ?? '—' }}</td>
                            <td class="text-center">
                                {% if entry.status.value == 'validated' %}
                                    <span class="badge bg-success">Validé</span>
                                {% elseif entry.status.value == 'pending' %}
                                    <span class="badge" style="background: rgba(245,158,11,0.2); color: #f59e0b;">En attente</span>
                                {% else %}
                                    <span class="badge bg-danger">Rejeté</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center flex-wrap">
                                    {# Voir détail - popup #}
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#paletteDetailModal" title="Voir détail">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    {# Modifier (chef de stock uniquement, avant validation) #}
                                    {% if entry.isPending and is_granted('ROLE_CHEF_STOCK') %}
                                    <a href="{{ path('app_stock_entry_show', {id: entry.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    {% endif %}
                                    {# Générer ticket (uniquement si validé) #}
                                    {% if entry.isValidated %}
                                    <a href="{{ path('app_stock_entry_bon_reception', {id: entry.id}) }}" class="btn btn-sm btn-outline-success" title="Générer ticket" target="_blank">
                                        <i class="bi bi-ticket-perforated"></i>
                                    </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Actions de validation #}
    {% if entry.isPending and is_granted('STOCK_ENTRY_VALIDATE') %}
    <div class="d-flex gap-2">
        <form action="{{ path('app_stock_entry_validate', {id: entry.id}) }}" method="post" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ entry.id) }}">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i> Valider l'opération
            </button>
        </form>
        <button type="button" class="btn btn-outline-danger btn-lg" data-bs-toggle="modal" data-bs-target="#rejectModal">
            <i class="bi bi-x-circle"></i> Rejeter
        </button>
    </div>
    {% endif %}

    {% if entry.isRejected and entry.rejectionReason %}
    <div class="alert alert-danger mt-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Motif du rejet :</strong> {{ entry.rejectionReason }}
    </div>
    {% endif %}
</div>

{# ===== Modal Détails Palette ===== #}
<div class="modal fade" id="paletteDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Détails de l'Entrée</h5>
                    <small class="text-muted">Toutes les informations de la palette</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    {# Informations palette #}
                    <div class="col-md-6">
                        <h6 class="text-primary mb-3"><i class="bi bi-qr-code me-2"></i>Informations de la palette</h6>
                        <table class="table table-sm">
                            <tr><td class="text-muted">Numéro de palette</td><td class="fw-bold">{{ entry.codePalette ?? 'PAL-' ~ entry.id }}</td></tr>
                            <tr><td class="text-muted">Statut</td><td>
                                {% if entry.isValidated %}<span class="badge bg-success">Validé</span>
                                {% elseif entry.isPending %}<span class="badge bg-warning">En attente</span>
                                {% else %}<span class="badge bg-danger">Rejeté</span>{% endif %}
                            </td></tr>
                        </table>
                    </div>
                    {# Informations client #}
                    <div class="col-md-6">
                        <h6 class="text-success mb-3"><i class="bi bi-person me-2"></i>Informations client</h6>
                        <table class="table table-sm">
                            <tr><td class="text-muted">Nom du client</td><td class="fw-bold">{{ entry.client.companyName }}</td></tr>
                            <tr><td class="text-muted">Code lot client</td><td>{{ entry.cdLotClient ?? '—' }}</td></tr>
                            <tr><td class="text-muted">N° de bon</td><td>{{ entry.bonReceptionNumber ?? '—' }}</td></tr>
                            <tr><td class="text-muted">Email</td><td>{{ entry.client.email ?? '—' }}</td></tr>
                        </table>
                    </div>
                    {# Informations produit #}
                    <div class="col-md-6">
                        <h6 class="text-info mb-3"><i class="bi bi-fish me-2"></i>Informations produit</h6>
                        <table class="table table-sm">
                            <tr><td class="text-muted">Espèce</td><td class="fw-bold">{{ entry.productName }}</td></tr>
                            <tr><td class="text-muted">Famille</td><td>{{ entry.famille ?? '—' }}</td></tr>
                            <tr><td class="text-muted">Qualité</td><td>{{ entry.qualite ?? '—' }}</td></tr>
                            <tr><td class="text-muted">Moule</td><td>{{ entry.moule ?? '—' }}</td></tr>
                        </table>
                    </div>
                    {# Quantités #}
                    <div class="col-md-6">
                        <h6 class="text-warning mb-3"><i class="bi bi-box-seam me-2"></i>Quantités</h6>
                        <table class="table table-sm">
                            <tr><td class="text-muted">Nombre de cartons</td><td class="fw-bold">{{ entry.nombreCartons ?? '—' }}</td></tr>
                            <tr><td class="text-muted">Poids (kg)</td><td class="fw-bold">{{ (entry.quantityTons * 1000)|number_format(0) }} kg</td></tr>
                            <tr><td class="text-muted">Poids (tonnes)</td><td>{{ entry.quantityTons|number_format(3) }} T</td></tr>
                        </table>
                    </div>
                    {# Localisation #}
                    <div class="col-md-6">
                        <h6 class="text-danger mb-3"><i class="bi bi-geo-alt me-2"></i>Localisation</h6>
                        <table class="table table-sm">
                            <tr><td class="text-muted">Chambre frigorifique</td><td class="fw-bold">{{ entry.coldRoom.name }}</td></tr>
                            <tr><td class="text-muted">Rayon</td><td>{{ entry.rayon ?? '—' }}</td></tr>
                            <tr><td class="text-muted">Position exacte</td><td>{{ entry.coldRoom.name }} - {{ entry.rayon ?? '—' }}</td></tr>
                        </table>
                    </div>
                    {# Dates #}
                    <div class="col-md-6">
                        <h6 class="text-secondary mb-3"><i class="bi bi-calendar3 me-2"></i>Dates & Contrôle</h6>
                        <table class="table table-sm">
                            <tr><td class="text-muted">Date d'entrée</td><td class="fw-bold">{{ entry.createdAt|date('d/m/Y H:i') }}</td></tr>
                            <tr><td class="text-muted">Responsable</td><td>{{ entry.createdBy.fullName }}</td></tr>
                            {% if entry.validatedBy %}
                            <tr><td class="text-muted">Validé par</td><td>{{ entry.validatedBy.fullName }}</td></tr>
                            <tr><td class="text-muted">Date validation</td><td>{{ entry.validatedAt|date('d/m/Y H:i') }}</td></tr>
                            {% endif %}
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

{# Modal Rejet #}
{% if entry.isPending and is_granted('STOCK_ENTRY_VALIDATE') %}
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="{{ path('app_stock_entry_reject', {id: entry.id}) }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ entry.id) }}">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-circle text-danger me-2"></i>Rejeter l'entrée</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Motif du rejet</label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="Indiquez la raison du rejet..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Confirmer le rejet</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

{# Modal Suppression #}
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-trash text-danger me-2"></i>Supprimer la palette</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer cette palette ? Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger">Confirmer la suppression</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
