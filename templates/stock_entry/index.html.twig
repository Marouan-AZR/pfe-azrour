{% extends 'base.html.twig' %}

{% block title %}Entrées de Stock{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    {% endfor %}

    {# Header #}
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">Entrées de Stock</h2>
            <small class="text-muted">Gérer et valider les opérations d'entrée de marchandises</small>
        </div>
        {% if is_granted('STOCK_ENTRY_CREATE') %}
        <a href="{{ path('app_stock_entry_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nouvelle Entrée
        </a>
        {% endif %}
    </div>

    {# ===== Indicateurs KPI ===== #}
    {% set pendingCount = 0 %}
    {% set validatedCount = 0 %}
    {% set totalPalettes = 0 %}
    {% set totalCartons = 0 %}
    {% set totalPoids = 0 %}
    {% for entry in entries %}
        {% if entry.status.value == 'pending' %}{% set pendingCount = pendingCount + 1 %}{% endif %}
        {% if entry.status.value == 'validated' %}{% set validatedCount = validatedCount + 1 %}{% endif %}
        {% set totalPalettes = totalPalettes + 1 %}
        {% set totalCartons = totalCartons + (entry.nombreCartons ?? 0) %}
        {% set totalPoids = totalPoids + (entry.quantityTons|number_format(3, '.', '')) %}
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl">
            <div class="kpi-card">
                <div class="kpi-icon" style="background: rgba(99,102,241,0.15); color: #6366f1;">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div>
                    <div class="kpi-value">{{ entries|length }}</div>
                    <div class="kpi-label">Opérations</div>
                    <small class="text-muted">Total des entrées</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl">
            <div class="kpi-card">
                <div class="kpi-icon" style="background: rgba(14,165,233,0.15); color: #0ea5e9;">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <div class="kpi-value">{{ totalPalettes }}</div>
                    <div class="kpi-label">Total Palettes</div>
                    <small class="text-muted">{{ totalCartons }} cartons</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl">
            <div class="kpi-card">
                <div class="kpi-icon" style="background: rgba(16,185,129,0.15); color: #10b981;">
                    <i class="bi bi-speedometer"></i>
                </div>
                <div>
                    <div class="kpi-value">{{ (totalPoids)|number_format(1) }} T</div>
                    <div class="kpi-label">Poids Total</div>
                    <small class="text-muted">{{ (totalPoids * 1000)|number_format(0, ',', ' ') }} kg</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl">
            <div class="kpi-card">
                <div class="kpi-icon" style="background: rgba(245,158,11,0.15); color: #f59e0b;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="kpi-value">{{ pendingCount }}</div>
                    <div class="kpi-label">En Attente</div>
                    <small class="text-warning">Nécessite validation</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl">
            <div class="kpi-card">
                <div class="kpi-icon" style="background: rgba(139,92,246,0.15); color: #8b5cf6;">
                    <i class="bi bi-check2-square"></i>
                </div>
                <div>
                    <div class="kpi-value">{{ validatedCount }}</div>
                    <div class="kpi-label">Validées</div>
                    <small class="text-success">Stock mis à jour</small>
                </div>
            </div>
        </div>
    </div>

    {# ===== Filtres et Recherche ===== #}
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-funnel"></i>
                    <strong>Filtres et Recherche</strong>
                </div>
                <div class="btn-group btn-group-sm" id="statusFilterBtns">
                    <button type="button" class="btn btn-primary active" data-filter="">Tous</button>
                    <button type="button" class="btn btn-outline-warning" data-filter="pending">En attente</button>
                    <button type="button" class="btn btn-outline-success" data-filter="validated">Validé</button>
                </div>
            </div>
            <div class="mt-3">
                <input type="text" class="form-control" id="searchInput" placeholder="🔍 Rechercher par code opération, client...">
            </div>
        </div>
    </div>

    {# ===== Tableau des opérations ===== #}
    <div class="card">
        <div class="card-header">
            <i class="bi bi-list-ul me-2"></i>Opérations d'Entrée ({{ entries|length }})
            <small class="text-muted ms-2">Liste des opérations regroupées par jour et client - Cliquez sur "Voir détails" pour accéder aux palettes</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Code / N° Opération</th>
                            <th>Date et Heure</th>
                            <th>Client</th>
                            <th class="text-center">Nb Palettes</th>
                            <th class="text-center">Total Cartons</th>
                            <th class="text-end">Poids Total</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in entries %}
                        <tr class="entry-row" data-status="{{ entry.status.value }}" data-search="{{ entry.bonReceptionNumber }} {{ entry.client.companyName }}">
                            <td>
                                <code class="fw-bold">{{ entry.bonReceptionNumber ?? 'ENT-' ~ entry.id }}</code>
                            </td>
                            <td>
                                <div>{{ entry.createdAt|date('d/m/Y') }}</div>
                                <small class="text-muted">{{ entry.createdAt|date('H:i:s') }}</small>
                            </td>
                            <td class="fw-semibold">{{ entry.client.companyName }}</td>
                            <td class="text-center">
                                <span class="badge bg-primary bg-opacity-25 text-primary">1</span>
                            </td>
                            <td class="text-center">{{ entry.nombreCartons ?? '—' }}</td>
                            <td class="text-end">
                                <div class="fw-bold">{{ (entry.quantityTons * 1000)|number_format(0, ',', ' ') }} kg</div>
                                <small class="text-muted">{{ entry.quantityTons|number_format(2) }} T</small>
                            </td>
                            <td class="text-center">
                                {% if entry.status.value == 'pending' %}
                                    <span class="badge rounded-pill" style="background: rgba(245,158,11,0.2); color: #f59e0b;">En attente</span>
                                {% elseif entry.status.value == 'validated' %}
                                    <span class="badge rounded-pill" style="background: rgba(16,185,129,0.2); color: #10b981;">Validé</span>
                                {% else %}
                                    <span class="badge rounded-pill" style="background: rgba(239,68,68,0.2); color: #ef4444;">Rejeté</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a href="{{ path('app_stock_entry_show', {id: entry.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir détails">
                                        <i class="bi bi-eye"></i> Voir détails
                                    </a>
                                    {% if entry.isPending and is_granted('STOCK_ENTRY_VALIDATE') %}
                                    <form action="{{ path('app_stock_entry_validate', {id: entry.id}) }}" method="post" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ entry.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Valider">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                                <p class="mt-2">Aucune opération d'entrée</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.kpi-card {
    background: var(--glass-bg, #fff);
    border: 1px solid var(--glass-border, #e2e8f0);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.3s ease;
}
.kpi-card:hover { transform: translateY(-4px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); }
.kpi-icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; flex-shrink: 0;
}
.kpi-value { font-size: 1.5rem; font-weight: 800; line-height: 1.2; }
.kpi-label { font-size: 0.85rem; font-weight: 600; }
.entry-row { transition: background 0.2s ease; }
.entry-row:hover { background: rgba(99,102,241,0.05) !important; }
</style>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Search
    document.getElementById('searchInput')?.addEventListener('input', function() {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.entry-row').forEach(r => {
            r.style.display = r.dataset.search.toLowerCase().includes(q) ? '' : 'none';
        });
    });
    // Status filter buttons
    document.querySelectorAll('#statusFilterBtns button').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('#statusFilterBtns button').forEach(b => b.classList.remove('active', 'btn-primary', 'btn-outline-warning', 'btn-outline-success'));
            this.classList.add('active');
            if (!this.dataset.filter) this.classList.add('btn-primary');
            const f = this.dataset.filter;
            document.querySelectorAll('.entry-row').forEach(r => {
                r.style.display = (!f || r.dataset.status === f) ? '' : 'none';
            });
        });
    });
});
</script>
{% endblock %}
{% endblock %}
