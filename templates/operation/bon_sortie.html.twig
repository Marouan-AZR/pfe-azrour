{% extends 'base.html.twig' %}

{% block title %}Bon de Sortie - {{ operation.code }}{% endblock %}

{% block stylesheets %}
<style>
    @media print {
        .sidebar, .main-header, .no-print { display: none !important; }
        .main-content { margin-left: 0 !important; }
        .main-body { padding: 0 !important; }
    }
    .bon-header { text-align: center; border-bottom: 2px solid #1e40af; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .bon-header h2 { color: #1e40af; }
    .bon-table th { background: #f1f5f9; }
    .bon-total { background: #f1f5f9; font-weight: bold; }
    .signatures { display: flex; justify-content: space-between; margin-top: 3rem; }
    .signature-box { text-align: center; width: 180px; border-top: 1px solid #333; padding-top: 0.5rem; font-size: 0.85rem; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="no-print d-flex justify-content-between mb-3">
        <a href="{{ path('app_operation_show', {id: operation.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Imprimer</button>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <div class="bon-header">
                <h4>🏭 GOLDEN LOGISTIQUE</h4>
                <h2>BON DE SORTIE</h2>
            </div>

            <div class="row mb-4">
                <div class="col-6">
                    <p><strong>N° BL :</strong> {{ operation.code }}</p>
                    <p><strong>Date :</strong> {{ operation.validatedAt|date('d/m/Y') }}</p>
                    <p><strong>Client :</strong> {{ operation.client.companyName }}</p>
                </div>
                <div class="col-6 text-end">
                    <p><strong>Contrôleur :</strong> {{ operation.controleur ? operation.controleur.fullName : '—' }}</p>
                    <p><strong>Chef de stock :</strong> {{ operation.validatedBy ? operation.validatedBy.fullName : '—' }}</p>
                </div>
            </div>

            <table class="table table-bordered bon-table">
                <thead>
                    <tr>
                        <th>Espèce</th>
                        <th>Qualité</th>
                        <th>Moule</th>
                        <th>Famille</th>
                        <th class="text-center">Cartons sortis</th>
                        <th class="text-end">Poids total (kg)</th>
                    </tr>
                </thead>
                <tbody>
                    {% set totalC = 0 %}
                    {% set totalP = 0 %}
                    {% for palette in operation.palettes %}
                    <tr>
                        <td>{{ palette.espece }}</td>
                        <td>{{ palette.qualite ?? '—' }}</td>
                        <td>{{ palette.moule ?? '—' }}</td>
                        <td>{{ palette.famille ?? '—' }}</td>
                        <td class="text-center">{{ palette.nombreCartons }}</td>
                        <td class="text-end">{{ palette.poidsTotal|number_format(0, ',', ' ') }}</td>
                    </tr>
                    {% set totalC = totalC + palette.nombreCartons %}
                    {% set totalP = totalP + palette.poidsTotal %}
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="bon-total">
                        <td colspan="4">TOTAL</td>
                        <td class="text-center">{{ totalC }}</td>
                        <td class="text-end">{{ totalP|number_format(0, ',', ' ') }} kg</td>
                    </tr>
                </tfoot>
            </table>

            <p class="text-muted mt-3"><strong>Nombre total de palettes :</strong> {{ operation.nombrePalettes }}</p>

            <div class="signatures">
                <div class="signature-box">Responsable Client</div>
                <div class="signature-box">Contrôleur</div>
                <div class="signature-box">Chef de Stock</div>
                <div class="signature-box">Cachet Entreprise</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
