{% extends 'base.html.twig' %}

{% block title %}Sorties de Stock{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-box-arrow-up me-2"></i>Opérations de Sortie</h1>
        {% if is_granted('ROLE_CHEF_STOCK') %}
        <a href="{{ path('app_operation_exit_prepare') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Préparer une sortie
        </a>
        {% endif %}
    </div>

    {# Filtres #}
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="🔍 Rechercher BL, client...">
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" id="statusFilter">
                        <option value="">Tous les statuts</option>
                        <option value="en_attente_controle">En attente de contrôle</option>
                        <option value="en_attente_validation">En attente de validation</option>
                        <option value="validated">Validé</option>
                        <option value="rejected">Rejeté</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" id="clientFilter">
                        <option value="">Tous les clients</option>
                        {% set clientsSeen = [] %}
                        {% for op in operations %}
                            {% if op.client.companyName not in clientsSeen %}
                                <option value="{{ op.client.companyName }}">{{ op.client.companyName }}</option>
                                {% set clientsSeen = clientsSeen|merge([op.client.companyName]) %}
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </div>

    {# Tableau regroupé par BL #}
    <div class="card">
        <div class="card-header">
            <i class="bi bi-table me-2"></i>Sorties regroupées par BL ({{ operations|length }} opérations)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>N° BL</th>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Espèces sorties</th>
                            <th class="text-center">Quantité (kg)</th>
                            <th class="text-center">Cartons</th>
                            <th class="text-center">Statut</th>
                            <th>Contrôleur</th>
                            <th>Chef de stock</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for op in operations %}
                        <tr class="op-row"
                            data-search="{{ op.code }} {{ op.client.companyName }}"
                            data-status="{{ op.status.value }}"
                            data-client="{{ op.client.companyName }}">
                            <td><code class="fw-bold">{{ op.code }}</code></td>
                            <td>
                                {{ op.createdAt|date('d/m/Y') }}
                                <br><small class="text-muted">{{ op.createdAt|date('H:i') }}</small>
                            </td>
                            <td class="fw-semibold">{{ op.client.companyName }}</td>
                            <td>{{ op.especes|join(', ') }}</td>
                            <td class="text-center">{{ op.poidsTotal|number_format(0, ',', ' ') }}</td>
                            <td class="text-center">{{ op.totalCartons }}</td>
                            <td class="text-center">
                                <span class="badge bg-{{ op.status.cssClass }}">{{ op.status.label }}</span>
                            </td>
                            <td>
                                {% if op.controleur is defined and op.controleur %}
                                    <small>{{ op.controleur.fullName }}</small>
                                {% else %}
                                    <small class="text-muted">—</small>
                                {% endif %}
                            </td>
                            <td>
                                {% if op.validatedBy is defined and op.validatedBy %}
                                    <small>{{ op.validatedBy.fullName }}</small>
                                {% else %}
                                    <small class="text-muted">—</small>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a href="{{ path('app_operation_show', {id: op.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir"><i class="bi bi-eye"></i></a>
                                    {% if op.isValidated %}
                                    <a href="{{ path('app_operation_bon_sortie', {id: op.id}) }}" class="btn btn-sm btn-outline-success" target="_blank" title="Bon de sortie"><i class="bi bi-file-earmark"></i></a>
                                    {% endif %}
                                    {% if op.isPending and is_granted('ROLE_CHEF_STOCK') %}
                                    <form action="{{ path('app_operation_validate', {id: op.id}) }}" method="post" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ op.id) }}">
                                        <button class="btn btn-sm btn-outline-success" title="Valider"><i class="bi bi-check"></i></button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="10" class="text-center py-4 text-muted"><i class="bi bi-inbox" style="font-size:2rem"></i><p>Aucune opération de sortie</p></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const rows = document.querySelectorAll('.op-row');

    function applyFilters() {
        const q = (document.getElementById('searchInput').value || '').toLowerCase();
        const status = document.getElementById('statusFilter').value;
        const client = document.getElementById('clientFilter').value;

        rows.forEach(r => {
            const matchSearch = !q || r.dataset.search.toLowerCase().includes(q);
            const matchStatus = !status || r.dataset.status === status;
            const matchClient = !client || r.dataset.client === client;
            r.style.display = (matchSearch && matchStatus && matchClient) ? '' : 'none';
        });
    }

    document.getElementById('searchInput').addEventListener('input', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);
    document.getElementById('clientFilter').addEventListener('change', applyFilters);
});
</script>
{% endblock %}
