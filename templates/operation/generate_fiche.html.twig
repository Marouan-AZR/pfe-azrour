{% extends 'base.html.twig' %}

{% block title %}Générer Fiche de Décharge{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-file-earmark-plus me-2"></i>Générer Fiche de Décharge</h1>
        <a href="{{ path('app_operation_show', {id: operation.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Assignation du contrôleur</div>
                <div class="card-body">
                    <p>Opération : <code>{{ operation.code }}</code> — {{ operation.client.companyName }}</p>
                    <p>{{ operation.nombrePalettes }} palette(s) — {{ operation.poidsTotal|number_format(0, ',', ' ') }} kg</p>

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Contrôleur responsable <span class="text-danger">*</span></label>
                            <select name="controleur" class="form-select" required>
                                {% for ctrl in controleurs %}
                                <option value="{{ ctrl.id }}">{{ ctrl.fullName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-file-earmark-check"></i> Générer et Assigner
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
