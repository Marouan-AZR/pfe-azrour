{% extends 'base.html.twig' %}

{% block title %}Préparation Sortie{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-box-arrow-up me-2"></i>Préparation de Sortie</h1>
        <a href="{{ path('app_operation_exit_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>

    {# Client selection #}
    <div class="card mb-4">
        <div class="card-header"><i class="bi bi-person me-2"></i>Sélection du client</div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Client</label>
                    <select name="client" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Sélectionner un client --</option>
                        {% for client in clients %}
                        <option value="{{ client.id }}" {{ selectedClient and selectedClient.id == client.id ? 'selected' : '' }}>
                            {{ client.companyName }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
    </div>

    {% if selectedClient %}
    <form method="post">
        <input type="hidden" name="client" value="{{ selectedClient.id }}">

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-grid me-2"></i>Palettes disponibles — {{ selectedClient.companyName }} ({{ palettes|length }})</span>
            </div>

            {# Column dropdown filters #}
            <div class="card-body border-bottom py-2">
                <div class="row g-2">
                    <div class="col">
                        <select class="form-select form-select-sm" id="filterEspece">
                            <option value="">Espèce</option>
                            {% set especes = [] %}
                            {% for p in palettes %}
                                {% if p.espece not in especes %}
                                    <option value="{{ p.espece }}">{{ p.espece }}</option>
                                    {% set especes = especes|merge([p.espece]) %}
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col">
                        <select class="form-select form-select-sm" id="filterMoule">
                            <option value="">Moule</option>
                            {% set moules = [] %}
                            {% for p in palettes %}
                                {% if p.moule and p.moule not in moules %}
                                    <option value="{{ p.moule }}">{{ p.moule }}</option>
                                    {% set moules = moules|merge([p.moule]) %}
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col">
                        <select class="form-select form-select-sm" id="filterQualite">
                            <option value="">Qualité</option>
                            {% set qualites = [] %}
                            {% for p in palettes %}
                                {% if p.qualite and p.qualite not in qualites %}
                                    <option value="{{ p.qualite }}">{{ p.qualite }}</option>
                                    {% set qualites = qualites|merge([p.qualite]) %}
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col">
                        <select class="form-select form-select-sm" id="filterFamille">
                            <option value="">Famille</option>
                            {% set familles = [] %}
                            {% for p in palettes %}
                                {% if p.famille and p.famille not in familles %}
                                    <option value="{{ p.famille }}">{{ p.famille }}</option>
                                    {% set familles = familles|merge([p.famille]) %}
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col">
                        <select class="form-select form-select-sm" id="filterRayon">
                            <option value="">Rayon</option>
                            {% set rayons = [] %}
                            {% for p in palettes %}
                                {% if p.rayon and p.rayon not in rayons %}
                                    <option value="{{ p.rayon }}">{{ p.rayon }}</option>
                                    {% set rayons = rayons|merge([p.rayon]) %}
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearFilters()"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="paletteTable">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="selectAll"></th>
                                <th>Code Palette</th>
                                <th>Espèce</th>
                                <th>Moule</th>
                                <th>Qualité</th>
                                <th>Famille</th>
                                <th>Code Lot Client</th>
                                <th>Date Réception</th>
                                <th>Chambre</th>
                                <th>Rayon</th>
                                <th class="text-center">Qté Disponible</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for palette in palettes %}
                            <tr class="palette-row"
                                data-espece="{{ palette.espece }}"
                                data-moule="{{ palette.moule ?? '' }}"
                                data-qualite="{{ palette.qualite ?? '' }}"
                                data-famille="{{ palette.famille ?? '' }}"
                                data-rayon="{{ palette.rayon ?? '' }}"
                                data-cartons="{{ palette.cartonsRestants }}"
                                data-poids="{{ palette.poidsRestant ?? 0 }}">
                                <td><input type="checkbox" name="selected_palettes[]" value="{{ palette.id }}"></td>
                                <td><code>{{ palette.codePalette }}</code></td>
                                <td>{{ palette.espece }}</td>
                                <td>{{ palette.moule ?? '—' }}</td>
                                <td>{{ palette.qualite ?? '—' }}</td>
                                <td>{{ palette.famille ?? '—' }}</td>
                                <td>{{ palette.operation.cdLotClient ?? '—' }}</td>
                                <td>{{ palette.createdAt|date('d/m/Y') }}</td>
                                <td>{{ palette.coldRoom ? palette.coldRoom.name : '—' }}</td>
                                <td>{{ palette.rayon ?? '—' }}</td>
                                <td class="text-center fw-bold">{{ palette.cartonsRestants }}</td>
                            </tr>
                            {% else %}
                            <tr><td colspan="11" class="text-center py-4 text-muted">Aucune palette disponible</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {% if palettes|length > 0 %}
        {# Controleur + Summary + Submit #}
        <div class="card">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label">Contrôleur responsable</label>
                        <select name="controleur" class="form-select">
                            <option value="">-- Sélectionner --</option>
                            {% for ctrl in controleurs %}
                            <option value="{{ ctrl.id }}">{{ ctrl.fullName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex gap-4" id="selectionSummary">
                            <span><strong id="sumPalettes">0</strong> palette(s)</span>
                            <span><strong id="sumCartons">0</strong> cartons</span>
                            <span><strong id="sumPoids">0</strong> kg</span>
                        </div>
                    </div>
                    <div class="col-md-3 text-end">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Enregistrer la sortie</button>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </form>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Select all visible
    document.getElementById('selectAll')?.addEventListener('change', function() {
        document.querySelectorAll('.palette-row:not([style*="display: none"]) input[type="checkbox"]').forEach(cb => { cb.checked = this.checked; });
        updateSummary();
    });

    document.querySelectorAll('input[name="selected_palettes[]"]').forEach(cb => {
        cb.addEventListener('change', updateSummary);
    });

    function updateSummary() {
        let palettes = 0, cartons = 0, poids = 0;
        document.querySelectorAll('input[name="selected_palettes[]"]:checked').forEach(cb => {
            const row = cb.closest('tr');
            palettes++;
            cartons += parseInt(row.dataset.cartons) || 0;
            poids += parseFloat(row.dataset.poids) || 0;
        });
        document.getElementById('sumPalettes').textContent = palettes;
        document.getElementById('sumCartons').textContent = cartons;
        document.getElementById('sumPoids').textContent = poids.toLocaleString('fr-FR', {maximumFractionDigits: 0});
    }

    // Dropdown filters
    const filters = ['filterEspece', 'filterMoule', 'filterQualite', 'filterFamille', 'filterRayon'];
    filters.forEach(id => {
        document.getElementById(id)?.addEventListener('change', applyFilters);
    });

    function applyFilters() {
        const espece = document.getElementById('filterEspece').value;
        const moule = document.getElementById('filterMoule').value;
        const qualite = document.getElementById('filterQualite').value;
        const famille = document.getElementById('filterFamille').value;
        const rayon = document.getElementById('filterRayon').value;

        document.querySelectorAll('.palette-row').forEach(row => {
            const show = (!espece || row.dataset.espece === espece)
                && (!moule || row.dataset.moule === moule)
                && (!qualite || row.dataset.qualite === qualite)
                && (!famille || row.dataset.famille === famille)
                && (!rayon || row.dataset.rayon === rayon);
            row.style.display = show ? '' : 'none';
        });
    }

    window.clearFilters = function() {
        filters.forEach(id => { document.getElementById(id).value = ''; });
        document.querySelectorAll('.palette-row').forEach(r => r.style.display = '');
    };
});
</script>
{% endblock %}
