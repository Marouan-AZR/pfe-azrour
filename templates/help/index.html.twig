{% extends 'base.html.twig' %}
{% block title %}Documentation — Aide{% endblock %}

{% block stylesheets %}
<style>
/* ── Layout ── */
.help-layout { display:flex; gap:2rem; align-items:flex-start; }

/* ── Sticky nav ── */
.help-nav {
    width:230px; flex-shrink:0; position:sticky; top:1.5rem;
    background:#fff; border:1px solid #e2e8f0; border-radius:1rem;
    box-shadow:0 4px 20px rgba(0,0,0,.05); overflow:hidden;
}
.help-nav-header {
    padding:.85rem 1.1rem; background:linear-gradient(135deg,#6366f1,#4f46e5);
    color:#fff; font-weight:700; font-size:.82rem; letter-spacing:.06em;
    text-transform:uppercase; display:flex; align-items:center; gap:.5rem;
}
.help-nav ul { list-style:none; margin:0; padding:.5rem 0; }
.help-nav li a {
    display:flex; align-items:center; gap:.6rem;
    padding:.55rem 1.1rem; font-size:.82rem; font-weight:500;
    color:#475569; text-decoration:none; transition:all .15s;
    border-left:3px solid transparent;
}
.help-nav li a:hover, .help-nav li a.active {
    background:#eff6ff; color:#2563eb; border-left-color:#2563eb;
}
.help-nav li a i { font-size:.85rem; flex-shrink:0; width:16px; text-align:center; }
.help-nav .nav-section {
    padding:.45rem 1.1rem .2rem;
    font-size:.66rem; font-weight:700; color:#94a3b8;
    text-transform:uppercase; letter-spacing:.07em;
}

/* ── Main content ── */
.help-content { flex:1; min-width:0; }
.help-section { margin-bottom:3rem; scroll-margin-top:1.5rem; }
.help-section-title {
    display:flex; align-items:center; gap:.75rem;
    font-size:1.15rem; font-weight:800; color:#0f172a;
    margin-bottom:1.25rem; padding-bottom:.75rem;
    border-bottom:2px solid #e2e8f0;
}
.help-section-title .s-icon {
    width:38px; height:38px; border-radius:.7rem;
    display:flex; align-items:center; justify-content:center; font-size:1.1rem;
}

/* ── Cards ── */
.help-card {
    background:#fff; border:1px solid #e2e8f0; border-radius:.9rem;
    box-shadow:0 2px 12px rgba(0,0,0,.04); margin-bottom:1rem; overflow:hidden;
}
.help-card-header {
    padding:.7rem 1.1rem; background:#f8fafc; border-bottom:1px solid #f1f5f9;
    font-weight:700; font-size:.82rem; color:#334155;
    display:flex; align-items:center; gap:.5rem;
}

/* ── Steps ── */
.steps { display:flex; flex-direction:column; gap:0; }
.step {
    display:flex; gap:1rem; padding:1rem 1.1rem;
    border-bottom:1px solid #f8fafc; position:relative;
}
.step:last-child { border-bottom:none; }
.step-num {
    width:28px; height:28px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:.78rem; font-weight:800; color:#fff;
}
.step-body { flex:1; }
.step-title { font-weight:700; font-size:.88rem; color:#0f172a; margin-bottom:.2rem; }
.step-desc { font-size:.82rem; color:#64748b; line-height:1.5; }

/* ── Role badges ── */
.role-badge {
    display:inline-flex; align-items:center; gap:.3rem;
    padding:.25em .7em; border-radius:50px; font-size:.72rem; font-weight:700;
}

/* ── Permissions table ── */
.perm-table { width:100%; border-collapse:collapse; font-size:.8rem; }
.perm-table th {
    padding:.5rem .75rem; background:#f8fafc; font-weight:700;
    color:#64748b; font-size:.72rem; text-transform:uppercase;
    border-bottom:2px solid #e2e8f0; white-space:nowrap;
}
.perm-table td { padding:.55rem .75rem; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
.perm-table tr:last-child td { border-bottom:none; }
.perm-table tr:hover td { background:#fafbfc; }
.perm-check { color:#10b981; font-size:1.05rem; }
.perm-cross { color:#e2e8f0; font-size:1.05rem; }

/* ── Status pills ── */
.status-pill {
    display:inline-flex; align-items:center; gap:.3rem;
    padding:.25em .8em; border-radius:50px; font-size:.75rem; font-weight:700;
}

/* ── Alert box ── */
.help-alert {
    display:flex; align-items:flex-start; gap:.75rem;
    padding:.85rem 1.1rem; border-radius:.75rem; margin-bottom:1rem; font-size:.83rem;
}

/* ── FAQ ── */
.faq-item { border:1px solid #e2e8f0; border-radius:.75rem; margin-bottom:.6rem; overflow:hidden; }
.faq-q {
    display:flex; justify-content:space-between; align-items:center;
    padding:.85rem 1.1rem; font-weight:600; font-size:.87rem; color:#0f172a;
    cursor:pointer; background:#fff; transition:background .15s;
    user-select:none;
}
.faq-q:hover { background:#f8fafc; }
.faq-q i.toggle { transition:transform .25s; color:#94a3b8; }
.faq-q.open i.toggle { transform:rotate(180deg); color:#6366f1; }
.faq-a {
    display:none; padding:.8rem 1.1rem 1rem; font-size:.83rem;
    color:#64748b; line-height:1.6; border-top:1px solid #f1f5f9;
    background:#fafbfc;
}

/* ── Color indicators ── */
.color-dot { width:12px; height:12px; border-radius:50%; display:inline-block; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-4">

    {# ── Header ── #}
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-book-half me-2" style="color:#6366f1"></i>Documentation & Aide
        </h2>
        <p class="text-secondary mb-0" style="font-size:.9rem">
            Guide complet d'utilisation de l'application de gestion de stock frigorifique Golden Logistics.
        </p>
    </div>

    <div class="help-layout">

        {# ══════════════════════════════════════
           NAVIGATION LATÉRALE
        ══════════════════════════════════════ #}
        <aside class="help-nav">
            <div class="help-nav-header">
                <i class="bi bi-compass"></i> Navigation
            </div>
            <ul>
                <li class="nav-section">Démarrage</li>
                <li><a href="#overview"   class="help-link"><i class="bi bi-house"></i>Vue d'ensemble</a></li>
                <li><a href="#roles"      class="help-link"><i class="bi bi-people"></i>Rôles & accès</a></li>
                <li class="nav-section">Opérations</li>
                <li><a href="#entries"    class="help-link"><i class="bi bi-box-arrow-in-down"></i>Entrées</a></li>
                <li><a href="#exits"      class="help-link"><i class="bi bi-box-arrow-up"></i>Sorties</a></li>
                <li class="nav-section">Stock</li>
                <li><a href="#stock"      class="help-link"><i class="bi bi-clipboard-data"></i>Stock & palettes</a></li>
                <li><a href="#coldrooms"  class="help-link"><i class="bi bi-thermometer-snow"></i>Chambres froides</a></li>
                <li class="nav-section">Administration</li>
                <li><a href="#invoices"   class="help-link"><i class="bi bi-receipt"></i>Factures</a></li>
                <li><a href="#alerts"     class="help-link"><i class="bi bi-bell"></i>Alertes</a></li>
                <li><a href="#dashboard"  class="help-link"><i class="bi bi-speedometer2"></i>Tableau de bord</a></li>
                <li class="nav-section">Support</li>
                <li><a href="#faq"        class="help-link"><i class="bi bi-question-circle"></i>FAQ</a></li>
            </ul>
        </aside>

        {# ══════════════════════════════════════
           CONTENU PRINCIPAL
        ══════════════════════════════════════ #}
        <div class="help-content">

            {# ── 1. Vue d'ensemble ── #}
            <section class="help-section" id="overview">
                <div class="help-section-title">
                    <div class="s-icon" style="background:#eff6ff;color:#2563eb"><i class="bi bi-house-fill"></i></div>
                    Vue d'ensemble
                </div>

                <div class="help-alert" style="background:#eff6ff;border:1px solid #bfdbfe">
                    <i class="bi bi-info-circle-fill" style="color:#2563eb;font-size:1.1rem;flex-shrink:0;margin-top:.1rem"></i>
                    <div>
                        <strong style="color:#1d4ed8">Bienvenue sur Golden Logistics</strong><br>
                        <span style="color:#3b82f6">Application de gestion d'un entrepôt frigorifique : suivi des entrées/sorties de stock, gestion des chambres froides, facturation clients et contrôle qualité.</span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="help-card h-100">
                            <div class="p-3">
                                <div class="mb-2" style="font-size:1.6rem">📦</div>
                                <div class="fw-bold mb-1" style="font-size:.9rem">Gestion du stock</div>
                                <div class="text-secondary" style="font-size:.8rem">Enregistrez les entrées et sorties de marchandises, suivez les palettes par chambre froide et par rayon.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="help-card h-100">
                            <div class="p-3">
                                <div class="mb-2" style="font-size:1.6rem">🌡️</div>
                                <div class="fw-bold mb-1" style="font-size:.9rem">Chambres froides</div>
                                <div class="text-secondary" style="font-size:.8rem">Surveillez le taux d'occupation de chaque chambre, recevez des alertes si la capacité dépasse 90%.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="help-card h-100">
                            <div class="p-3">
                                <div class="mb-2" style="font-size:1.6rem">🧾</div>
                                <div class="fw-bold mb-1" style="font-size:.9rem">Facturation</div>
                                <div class="text-secondary" style="font-size:.8rem">Générez automatiquement les factures mensuelles par client basées sur les opérations validées.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="help-card mt-3">
                    <div class="help-card-header"><i class="bi bi-diagram-3 text-primary"></i> Cycle de vie d'une marchandise</div>
                    <div class="p-3">
                        <div class="d-flex align-items-center gap-2 flex-wrap" style="font-size:.82rem">
                            <span class="status-pill" style="background:#eff6ff;color:#2563eb"><i class="bi bi-box-arrow-in-down"></i> Entrée créée</span>
                            <i class="bi bi-arrow-right text-secondary"></i>
                            <span class="status-pill" style="background:#fef3c7;color:#92400e"><i class="bi bi-clipboard-check"></i> Contrôle terrain</span>
                            <i class="bi bi-arrow-right text-secondary"></i>
                            <span class="status-pill" style="background:#ecfdf5;color:#065f46"><i class="bi bi-check-circle"></i> Validée → En stock</span>
                            <i class="bi bi-arrow-right text-secondary"></i>
                            <span class="status-pill" style="background:#f5f3ff;color:#5b21b6"><i class="bi bi-box-arrow-up"></i> Sortie demandée</span>
                            <i class="bi bi-arrow-right text-secondary"></i>
                            <span class="status-pill" style="background:#fef2f2;color:#991b1b"><i class="bi bi-check2-all"></i> Sortie validée</span>
                        </div>
                    </div>
                </div>
            </section>

            {# ── 2. Rôles & accès ── #}
            <section class="help-section" id="roles">
                <div class="help-section-title">
                    <div class="s-icon" style="background:#f5f3ff;color:#6366f1"><i class="bi bi-people-fill"></i></div>
                    Rôles & Accès
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-lg-4">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#fef3c7"><i class="bi bi-star-fill text-warning"></i> Patron</div>
                            <div class="p-3 text-secondary" style="font-size:.82rem">
                                Vue stratégique uniquement. Consulte les revenus, taux d'occupation globaux et chambres froides. Accès en lecture seule sur la plupart des données.
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#eef2ff"><i class="bi bi-shield-check" style="color:#6366f1"></i> Directeur</div>
                            <div class="p-3 text-secondary" style="font-size:.82rem">
                                Valide les factures, consulte les rapports financiers, gère les clients. Voit le stock par client et les performances mensuelles.
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#eff6ff"><i class="bi bi-person-badge" style="color:#2563eb"></i> Chef de Stock</div>
                            <div class="p-3 text-secondary" style="font-size:.82rem">
                                Crée et valide les entrées/sorties, gère les palettes, transfère entre rayons, génère les factures, gère les utilisateurs et clients.
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#f0fdf4"><i class="bi bi-clipboard-check" style="color:#10b981"></i> Contrôleur</div>
                            <div class="p-3 text-secondary" style="font-size:.82rem">
                                Peut <strong>créer des opérations d'entrée</strong>, effectuer le contrôle terrain puis les <strong>transmettre au chef de stock</strong> pour validation finale. Contrôle également les sorties qui lui sont assignées. Peut transférer des palettes.
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#fdf4ff"><i class="bi bi-building" style="color:#a855f7"></i> Client</div>
                            <div class="p-3 text-secondary" style="font-size:.82rem">
                                Consulte uniquement son propre stock et ses opérations en cours. N'a pas accès aux données des autres clients.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="help-card">
                    <div class="help-card-header"><i class="bi bi-table text-primary"></i> Matrice des permissions</div>
                    <div class="table-responsive">
                        <table class="perm-table">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th class="text-center">Patron</th>
                                    <th class="text-center">Directeur</th>
                                    <th class="text-center">Chef Stock</th>
                                    <th class="text-center">Contrôleur</th>
                                    <th class="text-center">Client</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set rows = [
                                    ['Tableau de bord',         true,  true,  true,  true,  true],
                                                    ['Créer une entrée',               false, false, true,  true,  false],
                                    ['Contrôler & transmettre entrée', false, false, false, true,  false],
                                    ['Valider une entrée (finale)',     false, false, true,  false, false],
                                    ['Créer une sortie',               false, false, true,  false, false],
                                    ['Contrôle terrain sortie',        false, false, false, true,  false],
                                    ['Valider une sortie (finale)',     false, false, true,  false, false],
                                    ['Voir état du stock',      false, true,  true,  true,  true],
                                                    ['Transférer des palettes',     false, false, false, true,  false],
                                    ['Consulter les transferts',    false, false, true,  true,  false],
                                    ['Gérer les clients',           false, true,  true,  false, false],
                                    ['Gérer les utilisateurs',      false, false, true,  false, false],
                                    ['Générer des factures',        false, false, true,  false, false],
                                    ['Valider des factures',        false, true,  false, false, false],
                                    ['Rapports & statistiques',     true,  true,  false, false, false],
                                    ['Alertes système',             false, true,  true,  false, false],
                                    ['Journal d\'audit',            false, false, true,  false, false],
                                    ['Plan des rayons',             false, true,  true,  true,  false],
                                ] %}
                                {% for row in rows %}
                                <tr>
                                    <td class="fw-semibold" style="font-size:.82rem">{{ row[0] }}</td>
                                    {% for i in 1..5 %}
                                    <td class="text-center">
                                        {% if row[i] %}
                                            <i class="bi bi-check-circle-fill perm-check"></i>
                                        {% else %}
                                            <i class="bi bi-dash perm-cross"></i>
                                        {% endif %}
                                    </td>
                                    {% endfor %}
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            {# ── 3. Entrées ── #}
            <section class="help-section" id="entries">
                <div class="help-section-title">
                    <div class="s-icon" style="background:#eff6ff;color:#2563eb"><i class="bi bi-box-arrow-in-down"></i></div>
                    Opérations — Entrées
                </div>

                <div class="help-alert" style="background:#f0fdf4;border:1px solid #bbf7d0">
                    <i class="bi bi-info-circle-fill" style="color:#10b981;font-size:1.1rem;flex-shrink:0;margin-top:.1rem"></i>
                    <span style="color:#065f46">Une entrée représente l'arrivée de marchandises dans l'entrepôt. Elle peut être créée par le <strong>chef de stock</strong> ou par un <strong>contrôleur</strong>. Dans le cas du contrôleur, elle est transmise au chef de stock pour validation finale.</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#eff6ff"><i class="bi bi-person-badge text-primary"></i> Entrée créée par le Chef de Stock</div>
                            <div class="steps">
                                <div class="step">
                                    <div class="step-num" style="background:#2563eb">1</div>
                                    <div class="step-body">
                                        <div class="step-title">Créer l'opération</div>
                                        <div class="step-desc"><strong>Entrées → Nouvelle entrée</strong> : saisir le client, la date, le code lot et les palettes (espèce, qualité, moule, poids, cartons, rayon, chambre froide).</div>
                                    </div>
                                </div>
                                <div class="step">
                                    <div class="step-num" style="background:#10b981">2</div>
                                    <div class="step-body">
                                        <div class="step-title">Valider directement</div>
                                        <div class="step-desc">Le chef valide l'opération immédiatement. Le stock est mis à jour et la fiche de charge est générée.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="help-card h-100">
                            <div class="help-card-header" style="background:#f0fdf4"><i class="bi bi-clipboard-check text-success"></i> Entrée créée par le Contrôleur</div>
                            <div class="steps">
                                <div class="step">
                                    <div class="step-num" style="background:#10b981">1</div>
                                    <div class="step-body">
                                        <div class="step-title">Créer l'opération</div>
                                        <div class="step-desc"><strong>Entrées → Nouvelle entrée</strong> : le contrôleur saisit les mêmes informations (client, date, palettes, chambre froide).</div>
                                    </div>
                                </div>
                                <div class="step">
                                    <div class="step-num" style="background:#06b6d4">2</div>
                                    <div class="step-body">
                                        <div class="step-title">Contrôle terrain</div>
                                        <div class="step-desc">Le contrôleur vérifie physiquement les palettes et complète les informations de contrôle.</div>
                                    </div>
                                </div>
                                <div class="step">
                                    <div class="step-num" style="background:#8b5cf6">3</div>
                                    <div class="step-body">
                                        <div class="step-title">Transmettre au Chef de Stock</div>
                                        <div class="step-desc">Le contrôleur clique sur <strong>"Transmettre"</strong>. Une liste des chefs de stock présents dans le système s'affiche. Il sélectionne le chef responsable et envoie l'opération.</div>
                                    </div>
                                </div>
                                <div class="step">
                                    <div class="step-num" style="background:#f59e0b">4</div>
                                    <div class="step-body">
                                        <div class="step-title">Validation par le Chef</div>
                                        <div class="step-desc">Le chef de stock reçoit l'opération dans son tableau de bord, la vérifie et la valide. Le stock est mis à jour et la fiche de charge est générée.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="help-card">
                    <div class="help-card-header"><i class="bi bi-info-circle text-warning"></i> Fiche de charge</div>
                    <div class="p-3 text-secondary" style="font-size:.82rem">
                        Après validation (par le chef), une <strong>fiche de charge</strong> récapitulative est disponible avec tous les détails des palettes, horodatée et signée. Elle peut être imprimée ou téléchargée en PDF depuis la page de détail de l'opération.
                    </div>
                </div>

                <div class="help-card mt-3">
                    <div class="help-card-header"><i class="bi bi-info-circle text-warning"></i> Statuts d'une entrée</div>
                    <div class="p-3">
                        <div class="d-flex flex-column gap-2" style="font-size:.82rem">
                            <div class="d-flex align-items-center gap-2">
                                <span class="status-pill" style="background:#ede9fe;color:#5b21b6">Att. contrôle</span>
                                <span class="text-secondary">— Assignée au contrôleur, en attente de son contrôle terrain</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="status-pill" style="background:#e0f2fe;color:#075985">Att. validation</span>
                                <span class="text-secondary">— Contrôle effectué par le contrôleur, transmise au chef de stock</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="status-pill" style="background:#ecfdf5;color:#065f46">Validée</span>
                                <span class="text-secondary">— Validée par le chef de stock, stock mis à jour, fiche de charge générée</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="status-pill" style="background:#fef2f2;color:#991b1b">Rejetée</span>
                                <span class="text-secondary">— Refusée, ne compte pas dans le stock</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            {# ── 4. Sorties ── #}
            <section class="help-section" id="exits">
                <div class="help-section-title">
                    <div class="s-icon" style="background:#fef2f2;color:#ef4444"><i class="bi bi-box-arrow-up"></i></div>
                    Opérations — Sorties
                </div>

                <div class="help-alert" style="background:#fef2f2;border:1px solid #fecaca">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#ef4444;font-size:1.1rem;flex-shrink:0;margin-top:.1rem"></i>
                    <span style="color:#991b1b">Une sortie implique plusieurs étapes de contrôle avant d'être validée. Elle nécessite l'intervention d'un contrôleur de terrain.</span>
                </div>

                <div class="help-card">
